#!/bin/sh
# wine-ppc64le-native -- Steam Play compatibility tool for the native ppc64le
# Wine port.  Steam invokes it with the Proton protocol:
#
#     <tool>/proton <verb> <exe> [args...]
#
# Escaping the emulator
# ---------------------
# The Steam client here is the x86-64 Linux build running under FEX, so this
# script starts life inside the emulator: the shebang is resolved against the
# FEX RootFS and the shell running these lines is a guest x86-64 /bin/sh.
# That is fine -- the shell work is trivial.  The one thing that matters is the
# final exec of an absolute /home/... path to a native ppc64le Wine binary:
#
#   * binfmt_misc claims only x86-64 and i386 ELF images.  The FEX-x86_64 and
#     FEX-x86 magic/mask pin e_machine to 0x3e and 0x03 respectively, so a
#     ppc64le image (0x15) is never handed to the interpreter.
#   * The FEX RootFS has no /home (it was renamed to home.quarantined-...),
#     so nothing under /home is shadowed by the x86-64 sysroot.
#
# The kernel therefore runs the image directly on the host and the emulator is
# left behind.  From then on the only emulated code is the game's own guest PE,
# executed inside Wine by FexBridge (WINEFEXBRIDGE below).
#
# Everything is written to a per-run log under $STEAM_COMPAT_DATA_PATH.

set -u

verb=${1:-run}
[ $# -gt 0 ] && shift

# ---------------------------------------------------------------- locations --

self=$0
case $self in */*) ;; *) self=./$self ;; esac
selfdir=$(cd "$(dirname "$self")" && pwd -P)   # resolves the compatibilitytools.d symlink

# The tool lives at <wine-tree>/ppc64le/steamtool, so the tree is two up.
tree=${WINE_PPC64LE_TREE:-}
if [ -z "$tree" ] && [ -x "$selfdir/../../wine" ]; then
    tree=$(cd "$selfdir/../.." && pwd -P)
fi
: "${tree:=$HOME/Projects/power8/wine-ppc64le}"

# $tree IS THE BUILD DIRECTORY; THIS SCRIPT LIVES IN THE SOURCE TREE.  They are
# the same directory only for an in-tree build, and using $tree for both is how
# an out-of-tree build silently loses everything under ppc64le/.
#
# [MEASURED 2026-08-22] with the build at .../wine-build, bridge_start looked
# for the helper at $tree/ppc64le/steamapi/helper/build-helper.sh -- which does
# not exist there -- printed "helper build FAILED; the game will see no Steam
# client", and DOOM then failed SteamAPI_Init and died in its own crash
# reporter.  The visible error was three steps downstream of this line.
#
# selfdir already resolves the compatibilitytools.d symlink, so this is the
# real source location whether the tool was invoked from the tree or through
# Steam.
src=$(cd "$selfdir/../.." && pwd -P)

wine=$tree/wine
wineserver=$tree/server/wineserver

# fastppcx86 bridge: the embedded emulator Wine dlopens when it meets a guest
# PE.  The binfmt-registered FEX's own build dir comes first: that bridge is
# rebuilt whenever the registered emulator is, so the inner and outer FEX stay
# the same code.  The interpreter line in binfmt_misc names the build dir.
bridge=
reg_fex=$(sed -n 's/^interpreter //p' /proc/sys/fs/binfmt_misc/FEX-x86_64 2>/dev/null)
reg_bridge=${reg_fex:+${reg_fex%/Bin/FEX}/Source/Tools/FexBridge/libfexbridge.so}
#
# THE TREE'S OWN INSTALLED BRIDGE is the third candidate, and it is where
# fexbridge/build-fexbridge.sh puts one -- beside ntdll.so, which is exactly
# where ntdll's own loader looks when nothing names a bridge.  Having the
# launcher search somewhere else is how the two disagree.
#
# The fex-ppc64le candidates that used to be here are GONE.  fastppcx86 is the
# emulator; fex-ppc64le is retained as source for later POWER9 optimisation
# work and has no build tree at all, so those paths could only ever miss --
# and a miss here is silent, ending in "no bridge found" on a machine with a
# working one.
bridge_cands="${WINE_PPC64LE_FEXBRIDGE:-} ${reg_bridge:-} \
$tree/dlls/ntdll/libfexbridge.so"

# A 32-BIT-CAPABLE BRIDGE WINS, and the order above is otherwise unchanged.
#
# A bridge without fexbridge_process_init32 cannot start a 32-bit process at
# all, and the way that surfaces is not an error about the bridge.  Steam's own
# legacycompat/SteamService.exe is a PE32; with such a bridge the launch fails
# ERROR_BAD_EXE_FORMAT (193) and shell32 puts up a MODAL "Bad format." box in
# the middle of somebody's game.  [MEASURED] 2026-08-18: with a bridge carrying
# the symbol, that same binary loads and runs, and fails on its own business
# ("Failed to find Steam executable") instead.
#
# The symbol is looked for with grep rather than nm because this runs inside
# the FEX environment where binutils may not be, and a .so's dynamic symbol
# table holds the name as a plain string either way.
#
# The preference is a preference, not a veto: if nothing 32-bit-capable is
# readable the first readable candidate is still used, because a 64-bit-only
# guest works perfectly well on it.  What must not happen is choosing that one
# SILENTLY and leaving a modal dialog as the only evidence.
# AN EXPLICIT REQUEST IS ABSOLUTE.  WINE_PPC64LE_FEXBRIDGE names a bridge on
# purpose -- to A/B two emulator builds, or to pin one while debugging -- and
# the 32-bit preference below must not quietly substitute a different file.
# [MEASURED] 2026-08-18: it did, and an A/B against a second FEX build silently
# ran the same bridge twice, which would have been read as "the emulator is not
# implicated".  A preference may choose between candidates nobody named; it may
# not overrule the one somebody did.
if [ -n "${WINE_PPC64LE_FEXBRIDGE:-}" ] && [ -r "${WINE_PPC64LE_FEXBRIDGE}" ]; then
    bridge=$WINE_PPC64LE_FEXBRIDGE
    grep -q fexbridge_process_init32 "$bridge" 2>/dev/null || \
        say "WARNING: $bridge has no fexbridge_process_init32, so no 32-bit \
process can start; using it anyway because WINE_PPC64LE_FEXBRIDGE names it"
    bridge_cands=
fi

bridge32=
for cand in $bridge_cands; do
    [ -n "$cand" ] && [ -r "$cand" ] || continue
    [ -z "$bridge" ] && bridge=$cand
    if grep -q fexbridge_process_init32 "$cand" 2>/dev/null; then
        bridge32=$cand
        break
    fi
done
if [ -n "${WINE_PPC64LE_FEXBRIDGE:-}" ] && [ -r "${WINE_PPC64LE_FEXBRIDGE}" ]; then
    :                                   # already chosen above; nothing overrules it
elif [ -n "$bridge32" ]; then
    bridge=$bridge32
elif [ -n "$bridge" ]; then
    say "WARNING: no 32-bit-capable bridge found; using $bridge"
    say "  It has no fexbridge_process_init32, so any PE32 this title launches"
    say "  -- Steam's own legacycompat/SteamService.exe is one -- will fail"
    say "  ERROR_BAD_EXE_FORMAT and raise a modal 'Bad format.' box."
    say "  Rebuild it: 'ninja fexbridge' in the FEX build directory."
fi

# ------------------------------------------------------------------ logging --

compat=${STEAM_COMPAT_DATA_PATH:-}
if [ -z "$compat" ]; then
    # Not launched by Steam; keep the same shape so the tool is testable.
    compat=${TMPDIR:-/tmp}/wine-ppc64le-native-$$
fi
mkdir -p "$compat" 2>/dev/null

log=$compat/wine-ppc64le-native-$(date +%Y%m%d-%H%M%S)-$$.log
echo "wine-ppc64le-native: log -> $log" >&2

exec 3>&1                  # Steam's stdout, for the path-translation verbs
exec >>"$log" 2>&1

say() { echo "[wine-ppc64le-native] $*"; }

say "verb=$verb"
say "argv=$*"
say "cwd=$(pwd)"
say "tree=$tree"
say "wine=$wine"
say "bridge=${bridge:-<none found>}"
say "compat=$compat"

echo
echo "===== environment as received from Steam ====="
env | sort
echo "============================================="
echo

if [ ! -x "$wine" ]; then
    say "FATAL: no native wine at $wine"
    exit 1
fi

# -------------------------------------------------------------- sanitisation --
#
# Steam hands us the x86-64 client's environment.  Anything in it that names a
# path, a shared object or an emulator knob belongs to the guest world and is
# actively harmful on the native side -- an x86-64 LD_PRELOAD alone produces a
# stream of "wrong ELF class" errors from the host ld.so on every process the
# port starts.  Names that only carry data (SteamAppId, DISPLAY, XDG_*, audio,
# D-Bus, locale, PROTON_*/DXVK_*/VKD3D_* tunables) are kept untouched.

strip=0
for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
    case $name in
    # x86-64 dynamic linker: library search paths, preloads, tunables.
    LD_LIBRARY_PATH|LD_PRELOAD|LD_AUDIT|LD_DEBUG|LD_DEBUG_OUTPUT|\
    LD_ASSUME_KERNEL|GLIBC_TUNABLES|GCONV_PATH|LOCPATH|\
    SYSTEM_LD_LIBRARY_PATH|SYSTEM_PATH)                            ;;
    # Steam runtime / pressure-vessel container plumbing.
    STEAM_RUNTIME*|STEAM_ZENITY|STEAM_LINUX_RUNTIME*|\
    PRESSURE_VESSEL_*|PV_*|SRT_*|CONTAINER_*|FLATPAK_*)            ;;
    # Graphics and media loaders pointed at x86-64 ICDs, layers and drivers.
    VK_ICD_FILENAMES|VK_DRIVER_FILES|VK_ADD_DRIVER_FILES|\
    VK_LAYER_PATH|VK_ADD_LAYER_PATH|VK_INSTANCE_LAYERS|\
    LIBGL_DRIVERS_PATH|LIBVA_DRIVERS_PATH|GBM_BACKENDS_PATH|\
    __EGL_VENDOR_LIBRARY_DIRS|__EGL_VENDOR_LIBRARY_FILENAMES|\
    OCL_ICD_FILENAMES|SDL_DYNAMIC_API|GST_PLUGIN_*|GTK_PATH|\
    GIO_MODULE_DIR|GDK_PIXBUF_MODULE_FILE|PYTHONPATH|PYTHONHOME|PERL5LIB) ;;
    # Emulator knobs PASS THROUGH by default (changed 2026-08-19).  The old
    # rule stripped FEX_* so the bridge started from its own defaults --
    # written when the bridge read no environment at all, so the strip cost
    # nothing.  Since fastppcx86 54df357cb the bridge consumes the same
    # FEX_* configuration the frontend does, and stripping it silently
    # discarded deliberate per-run knobs: measured 2026-08-19, a whole
    # FEX_SPINCOLLAPSE/FEX_HWTSO benchmark matrix ran with every knob
    # stripped and its deltas were pure run noise.  These variables exist
    # for a reason (user directive, same date); whoever sets them owns
    # them.  WINE_PPC64LE_STRIP_FEX_ENV=1 restores the old behavior for a
    # launch environment known to carry someone else's FEX settings.
    FEX_*)
        [ "${WINE_PPC64LE_STRIP_FEX_ENV:-0}" = 1 ] || continue         ;;
    # Wine loader state belonging to some other Wine (Proton's, usually).
    WINEPREFIX|WINESERVER|WINELOADER|WINEDLLPATH|WINEARCH|\
    WINEFEXBRIDGE|WINEESYNC|WINEFSYNC)                             ;;
    *)  continue ;;
    esac
    unset "$name" 2>/dev/null && { say "strip $name"; strip=$((strip + 1)); }
done
say "stripped $strip variable(s)"

# The inherited PATH leads into the Steam runtime's x86-64 bin directories.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
say "PATH reset to $PATH"

# ------------------------------------------------------------------- prefix --

# Proton-style location.  If something else already made a prefix here -- the
# user's Proton runs share $STEAM_COMPAT_DATA_PATH per app -- do not touch it:
# a Proton prefix is full of Proton's own builtin DLLs and overrides.
prefix=$compat/pfx
if [ ! -e "$prefix/.wine-ppc64le-native" ] && \
   { [ -e "$prefix/system.reg" ] || [ -e "$prefix/drive_c" ]; }; then
    prefix=$compat/pfx-ppc64le-native
    say "existing foreign prefix at $compat/pfx left alone; using $prefix"
fi

WINEPREFIX=$prefix
export WINEPREFIX
[ -n "$bridge" ] && { WINEFEXBRIDGE=$bridge; export WINEFEXBRIDGE; }
say "WINEPREFIX=$WINEPREFIX"
say "WINEFEXBRIDGE=${WINEFEXBRIDGE:-<unset>}"

# Per-game settings, protonfixes-style: <tool>/appconfig/<appid>.env is
# applied if present, one NAME=VALUE per line, comments allowed.  A value
# the caller already set (a Steam launch option) is kept, so the file is
# a default rather than an override.
#
# Applied HERE, before the first wine invocation of the run, not in the
# launch verb where it used to live: the first `$wine` call (wineboot on a
# fresh prefix, the steam bridge's reg writes on every run) starts the
# WINESERVER, the server inherits its environment from that first call and
# outlives it, and some of these settings are ones the server itself must
# see -- WINE_PPC64LE_CPU_LIMIT is derived independently by wineserver and
# every client, and the two views must agree bit for bit.  A game whose
# .env was applied after the server was already up got a server on one
# topology and a game on another.
appcfg=$selfdir/appconfig/${SteamAppId:-none}.env
if [ -f "$appcfg" ]; then
    say "applying $appcfg"
    while IFS= read -r line; do
        case $line in ''|\#*) continue ;; esac
        name=${line%%=*}
        if eval "[ -z \"\${$name:-}\" ]"; then
            export "$line"
            say "  $line"
        else
            say "  keeping caller's $name"
        fi
    done < "$appcfg"
fi

# The lane's own JIT defaults, applied after the per-title file so a Steam
# launch option or a title's .env wins.  This is the emulated stack's
# default game recipe ("lazy" in launchers.bak/fexplay-wtsmc, plus the fex
# wrapper's X87 default) plus hardware TSO -- without these a native-lane
# launch runs strict SMC checks and a software barrier on every memory op
# against an emulated lane that never does, which is a configuration gap,
# not an architecture measurement.  FEX_HWTSO is sound (PROT_SAO pages,
# probe + refusal closure in the bridge; smaps `ar` VmFlags is the tell it
# is live) and was verified end to end before it was made a default here.
# WINE_PPC64LE_STRIP_FEX_ENV=1 above still strips ALL of it for a launch
# that needs the bridge's own bare defaults.
for kv in FEX_HWTSO=1 FEX_SMCCHECKS=mtrack FEX_SMCSOFTINVALIDATE=1 \
          FEX_SMCLAZYINVAL=1 FEX_SMCFILEIMMUTABLE=1 FEX_SMCLAZYLINK=1 \
          FEX_X87REDUCEDPRECISION=1; do
    name=${kv%%=*}
    if eval "[ -z \"\${$name:-}\" ]"; then
        export "$kv"
        say "lane default $kv"
    fi
done

echo
echo "===== environment handed to the native wine ====="
env | sort
echo "================================================"
echo

if [ "$verb" = destroyprefix ]; then
    if [ -e "$prefix/.wine-ppc64le-native" ]; then
        say "destroying $prefix"
        rm -rf "$prefix"
    else
        say "refusing to destroy $prefix: not created by this tool"
    fi
    exit 0
fi

if [ ! -e "$prefix/.wine-ppc64le-native" ]; then
    say "first run: wineboot --init in $prefix"
    mkdir -p "$prefix"
    if "$wine" wineboot --init; then
        "$wineserver" -w
        : > "$prefix/.wine-ppc64le-native"
        say "prefix initialised"
    else
        say "FATAL: wineboot failed (rc=$?)"
        exit 1
    fi
fi

# A PREFIX BOOTED BEFORE 32-BIT SUPPORT HAS NO 32-BIT WINDOWS, and it does not
# heal itself on the next run: the marker above says "initialised" and this
# block is skipped forever.
#
# What populates C:\windows\syswow64 is wineboot's Wow64Install pass, which
# starts syswow64\rundll32.exe as an i386 process.  With a bridge that cannot
# do 32 bits that process dies in BTCpuProcessInit and wineboot REPORTS SUCCESS
# over an empty directory -- so a prefix made in that state looks fine and
# fails later, on whatever PE32 the title happens to launch.
#
# Re-booting is safe: wineboot -u is the update path, it is what Proton itself
# runs on every launch, and it leaves an already-correct prefix alone.
if [ -n "$bridge32" ] && \
   [ -z "$(ls -A "$prefix/drive_c/windows/syswow64" 2>/dev/null)" ]; then
    say "prefix has no 32-bit windows; forcing wineboot -u to stage it"
    # The timestamp has to go first.  wineboot compares .update-timestamp
    # against wine.inf and, finding the prefix current, runs update_wineprefix()
    # NOT AT ALL -- no Wow64Install pass, no rundll32, rc=0, nothing staged.
    # [MEASURED] plain `wineboot -u` on an existing prefix: zero rundll32
    # invocations and syswow64 still empty; with the timestamp removed, 890
    # entries.  wineboot writes a fresh one, so this costs one slower launch.
    rm -f "$prefix/.update-timestamp"
    if "$wine" wineboot -u; then
        "$wineserver" -w
        n=$(ls -A "$prefix/drive_c/windows/syswow64" 2>/dev/null | wc -l)
        if [ "$n" -gt 0 ]; then
            say "staged $n entries into syswow64"
        else
            say "WARNING: syswow64 is still empty after wineboot -u; a PE32 this"
            say "  title launches will fail ERROR_BAD_EXE_FORMAT"
        fi
    else
        say "WARNING: wineboot -u failed; leaving the prefix as it was"
    fi
fi

# -------------------------------------------------- Microsoft's MFC runtime --
#
# Some games load a plugin built against Microsoft's MFC redistributable.
# DOOM (2016) is one: it LoadLibrary's Razer's CChromaEditorLibrary.dll, which
# imports mfc140u.dll, and -- this is the part that matters -- it then calls
# the function pointers it fetched from that plugin WITHOUT CHECKING whether
# the load succeeded.  Its own loader null-checks each GetProcAddress and
# returns -1; the caller discards the -1 and calls anyway.  So a prefix with no
# MFC is a NULL call into 0x0 at engine init.
#
# That is not a defect of this port.  It is what Windows does too: mfc140u.dll
# ships in the VC++ 2015+ redistributable, and on a machine without it
# LoadLibrary fails and DOOM dies exactly the same way.  Nothing here can or
# should synthesise MFC.
#
# What this port CAN fix is an accident of its own making.  The tool declines
# to touch a foreign Proton prefix (see above) and makes its own beside it, so
# a user who already provisioned $compat/pfx -- with protontricks, winetricks
# vcrun2015, or the redistributable's own installer -- finds our prefix empty
# of the runtime they installed for this very game.  Their files, their two
# prefixes for their one app, on the one disk: copy them across.  Nothing is
# downloaded, nothing is redistributed, and the foreign prefix is only READ.
#
# Idempotent and checked every run, not only at prefix creation: a prefix made
# before this existed must pick the runtime up too.
#
# system32 rather than the guest system directory C:\windows\sysx8664: the
# guest branch of find_dll_file() searches the machine's own system dir first,
# then builtins, then the ordinary load path -- and system32 is on that load
# path.  Measured: a guest LoadLibraryA("mfc140u.dll") resolves it there.
# sysx8664 exists in no prefix this tool has ever made, so putting the first
# file in the tree into it would be a new mechanism to no purpose.
sys32=$prefix/drive_c/windows/system32
foreign=$compat/pfx/drive_c/windows/system32

# WHAT MACHINE IS THAT PE?  Staging exists to put an x86-64 module where a
# guest can load it, so staging anything else is worse than staging nothing:
# the file lands with the right NAME and the wrong INSTRUCTION SET, and the
# guest gets a module it cannot execute instead of an honest "absent".
#
# [MEASURED 2026-08-22] this was not hypothetical.  run-native exports
# STEAM_COMPAT_DATA_PATH=$prefix and this script then builds its prefix at
# $compat/pfx -- so $foreign and $sys32 were THE SAME DIRECTORY, the "foreign
# Proton prefix" was our own, and the msvcp100 block copied this port's NATIVE
# ppc64 builtin (machine 0x1f3) into sysx8664.  Verified on a real prefix:
# sysx8664/msvcp100.dll came out 0x1f3 while every hand-staged file was 0x8664.
# The Styx fix this block exists for has therefore never worked outside a
# launch that had a genuine Proton prefix beside it.
#
# e_lfanew is a LE u32 at 0x3c; Machine is a LE u16 at e_lfanew+4.  Assembled
# from bytes rather than read as a word so the answer does not depend on the
# host's endianness.
pe_machine() {
    _off=$(od -An -tu4 -j60 -N4 "$1" 2>/dev/null | tr -d ' \n')
    case ${_off:-x} in ''|*[!0-9]*) return 1 ;; esac
    _b=$(od -An -tx1 -j$((_off + 4)) -N2 "$1" 2>/dev/null | tr -d ' \n')
    [ ${#_b} -eq 4 ] || return 1
    printf '%s%s\n' "$(printf %s "$_b" | cut -c3-4)" "$(printf %s "$_b" | cut -c1-2)"
}

# $foreign is only foreign if it is not us.  Same directory means there is no
# other prefix to borrow from, and every "copy" would be a self-copy of a
# native builtin.
if [ "$(cd "$foreign" 2>/dev/null && pwd -P)" = "$(cd "$sys32" 2>/dev/null && pwd -P)" ]; then
    foreign=
fi
mfc_have=0 mfc_missing=

for dll in mfc140u.dll mfc140.dll; do
    if [ -f "$sys32/$dll" ]; then
        mfc_have=$((mfc_have + 1))
        continue
    fi
    if [ -f "$foreign/$dll" ]; then
        if cp -f "$foreign/$dll" "$sys32/.$dll.tmp" 2>/dev/null &&
           mv -f "$sys32/.$dll.tmp" "$sys32/$dll" 2>/dev/null; then
            say "provisioned $dll from the app's Proton prefix ($foreign)"
            mfc_have=$((mfc_have + 1))
        else
            rm -f "$sys32/.$dll.tmp" 2>/dev/null
            say "could not copy $dll from $foreign into $sys32"
            mfc_missing="$mfc_missing $dll"
        fi
    else
        mfc_missing="$mfc_missing $dll"
    fi
done

if [ "$mfc_have" = 0 ]; then
    say "no MFC runtime in $sys32 and none to copy from $foreign;$mfc_missing"
    say "  a game whose plugin needs it (DOOM 2016 -> CChromaEditorLibrary.dll)"
    say "  will fail that LoadLibrary and may then call a NULL pointer, exactly"
    say "  as it would on Windows without the VC++ redistributable.  To fix it,"
    say "  install the redistributable into a prefix for this app --"
    say "  'protontricks ${SteamAppId:-<appid>} vcrun2015' or 'winetricks vcrun2015' with"
    say "  WINEPREFIX=$prefix -- and run again.  Nothing is downloaded here."
fi

# ------------------------------------------ Microsoft's VC++ 2010 C++ runtime --
#
# msvcp100.dll is a C++ ABI, and translating the MSVC C++ ABI is exactly what
# this port decided not to do: all 46 eligible exports of
# dlls/msvcp100/msvcp100.thunks are MSVC-mangled member functions
# (?_Lockit_ctor@_Lockit@std@@SAXH@Z and its kind), no Wine header declares
# them as flat prototypes because they are not flat prototypes, and the thunk
# PE therefore has NO EXPORTS AT ALL.  Styx: Master of Shadows imports 65 of
# them; its bundled wxmsw28u_vc_custom_64.dll calls one at PROCESS_ATTACH and
# lands on a 0xDEAD000B sentinel.
#
# The answer is the one dlls/msvcp140 already takes: run a REAL x86-64
# msvcp100.dll as a guest module under the emulator.  A copy is on this disk if
# the user provisioned a Proton prefix for the app, and -- this is the
# correction to what ppc64le/games/STATUS.md handoff #4 assumed -- that file
# is not Microsoft's.  Measured: 1,747,524 bytes, machine 0x8664, and the
# string "Wine builtin DLL" in its DOS stub, with 1628 exports.  It is WINE'S
# OWN msvcp100 built for x86-64 by Proton.  That is better rather than worse:
# nothing has to be redistributed, and the implementation is the same one this
# tree compiles for ppc64.
#
# sysx8664 rather than system32, and this is the opposite of the mfc140u block
# above.  find_dll_file()'s guest branch searches the machine's own system
# directory FIRST, then builtins, then the ordinary load path.  mfc140u has no
# builtin competing with it so system32 (on the load path) is fine; msvcp100
# HAS one, so a copy on the load path is never reached.
#
# NO LOAD-ORDER OVERRIDE, and that is a correction too.  The obvious-looking
# "msvcp100=n" is exactly wrong: LO_NATIVE refuses a Wine builtin outright
# (dlls/ntdll/unix/loader.c, load_builtin), and this file IS one -- so the
# override turned a module that merely had no useful exports into one that
# would not load at all, which is why the first attempt at this block made Styx
# worse (rc=53) instead of better.  With no override the staged file is found
# and kept, because load_builtin no longer re-resolves the name of a module
# staged in a guest machine's own system directory against the build tree.
#
# msvcr100 DELIBERATELY STAYS WINE'S OWN, i.e. this tree's native ppc64
# implementation behind its guest thunk.  Two reasons, both measured.  The C
# runtime is the half this port CAN translate -- 766 of 1185 exports cross --
# and dlls/msvcr100/msvcr100.thunks carries the callback-registration rows
# (_beginthread, _beginthreadex, _onexit, __dllonexit, qsort, bsearch,
# _set_invalid_parameter_handler, _set_purecall_handler, __setusermatherr) that
# ppc64le/seh/check-crt-callbacks.sh gates; staging a guest msvcr100 would put
# all of that behind the emulator for nothing.  And it does not work anyway:
# Proton's x86-64 msvcr100.dll is a Wine builtin that imports Wine's INTERNAL
# ntdll helpers, which this port's guest ntdll thunk does not publish, so it
# dies at its own PROCESS_ATTACH on
#
#   err:seh:dispatch_guest_exception guest called through a wild pointer:
#     00000000DEAD0005 ... from msvcr100.dll+7ef80        (= __wine_dbg_header)
#
# WHAT THIS DOES NOT YET FIX, stated here rather than left to be discovered.
# With msvcp100 staged, the module maps with all 1628 exports and Styx's 65
# imports bind for real.  msvcp100's own DllMain then GetProcAddress's four
# C++ symbols out of msvcr100 -- ??2@YAPEAX_K@Z (operator new),
# ??3@YAXPEAX@Z (operator delete),
# ?_set_new_handler@@YAP6AH_K@ZP6AH0@Z@Z and
# ?IsCurrentTaskCollectionCanceling@Context@Concurrency@@SA_NXZ -- and this
# tree's msvcr100 thunk refuses all four as mangled C++ names, so the call
# through NULL is where it stops now.  Closing that is four rows in
# dlls/msvcr100/msvcr100.thunks, three of them ordinary and one
# (_set_new_handler) needing a callback row because its argument is a guest
# function pointer.  Staging is still the right half to ship: the module now
# has real exports instead of none, and the fault names a symbol instead of
# being a bare sentinel.
sysx8664=$prefix/drive_c/windows/sysx8664
cpp_missing=

for dll in msvcp100.dll; do
    if [ -f "$sysx8664/$dll" ]; then
        continue
    fi
    if [ -n "$foreign" ] && [ -f "$foreign/$dll" ] &&
       [ "$(pe_machine "$foreign/$dll")" = "8664" ]; then
        mkdir -p "$sysx8664" 2>/dev/null
        if cp -f "$foreign/$dll" "$sysx8664/.$dll.tmp" 2>/dev/null &&
           mv -f "$sysx8664/.$dll.tmp" "$sysx8664/$dll" 2>/dev/null; then
            say "provisioned $dll into the guest system directory ($sysx8664)"
        else
            rm -f "$sysx8664/.$dll.tmp" 2>/dev/null
            say "could not copy $dll from $foreign into $sysx8664"
            cpp_missing="$cpp_missing $dll"
        fi
    else
        cpp_missing="$cpp_missing $dll"
    fi
done

if [ -n "$cpp_missing" ]; then
    say "no x86-64 VC++ 2010 C++ runtime to stage;$cpp_missing"
    say "  a game built against it (Styx: Master of Shadows) will bind sentinels"
    say "  for every std:: symbol, because this tree's msvcp100 thunk has no"
    say "  exports -- the MSVC C++ ABI is not a flat surface and is refused"
    say "  honestly rather than guessed.  To fix it, provision a prefix for this"
    say "  app -- 'protontricks ${SteamAppId:-<appid>} vcrun2010' -- and run"
    say "  again.  Nothing is downloaded here."
fi

# ------------------------------------- Microsoft's VC++ 2015+ C++ runtime --
#
# The block above stages msvcp100 for Styx; this stages msvcp140 for every
# title built with VS2015 or later, which is most of the modern library.  Same
# reason exactly -- msvcp140 is a C++ ABI, the thunk surface is flat C, and
# dlls/msvcp140/msvcp140.thunks therefore emits almost nothing -- and the same
# answer: run a REAL x86-64 Wine build of the module as a guest module.
#
# Kept in ./stage-guest-runtime rather than written out here, because its
# SOURCE rule is different and better: the msvcp100 block above can only read
# the app's own Proton prefix, which most titles do not have (Civilization VI,
# appid 289070, has none), while that script also searches every Proton
# installation's own dist tree -- which any machine with Proton has.  It does
# the same PE-machine check before every copy, for the same measured reason.
#
# vcruntime140 is deliberately NOT staged with it.  This tree's own
# vcruntime140 thunk forwards the entire C++ exception personality
# (_CxxThrowException, __CxxFrameHandler/2/3, the exception-record accessors)
# to ucrtbase and on into dlls/guestcrt's real guest x86-64 code; replacing
# that module wholesale would swap out a load-bearing subsystem to gain six
# RTTI entry points.  Those six are served properly instead, as FORWARD lines
# in dlls/vcruntime140/vcruntime140.thunks -- see its 2026-08-30 banner.
if [ -x "$selfdir/stage-guest-runtime" ]; then
    "$selfdir/stage-guest-runtime" "$prefix" 2>&1 | while IFS= read -r l; do say "$l"; done
fi

# ---------------------------------------------------- prerequisite markers --
#
# A GAME'S OWN INSTALLER CHAIN, AND THE ONE STAGE OF IT THAT CANNOT SUCCEED.
#
# Unreal Engine titles ship UE4PrereqSetup_x64.exe and run it from their
# launcher; Steam runs the same class of thing from a game's install script.
# The Visual C++ stages of those installers work here -- [MEASURED] Warhammer
# 40,000: Boltgun installed the 2015-2019 x86 and x64 redistributables into its
# own prefix and left the VisualStudio\14.0\VC\Runtimes keys behind to prove
# it.  The .NET Framework 4 stage cannot: its MSI refuses the platform outright
# (`Install_I_Silent_Error`, MSI result **1633** = ERROR_INSTALL_PLATFORM_
# UNSUPPORTED), the chain reports failure, and the launcher exits without ever
# starting the game -- rc=44, with no message that names .NET as the cause.
#
# On Windows that stage is a no-op, because .NET 4.x is part of the operating
# system and the installer's detection key is already there.  So the key is put
# there.  This is what winetricks and protonfixes do for the same problem, and
# what the prefix would look like on the machine the game was built for.
#
# BE CLEAR ABOUT WHAT THIS IS.  It is a claim that .NET 4 is present, made to
# installers that only ever read the key.  It does NOT make managed code run:
# this tree ships no Mono, and a game that actually executes .NET assemblies
# will fail later and differently.  Nothing here was downloaded, and nothing
# was installed -- if you want real .NET in a prefix, install wine-mono into it
# and this block will step aside, because it seeds only a prefix that has no
# NDP key at all.
#
# WINE_PPC64LE_NO_PREREQ_SEED=1 turns it off.
seed_prereq_markers() {
    stamp=$prefix/.wine-ppc64le-prereq
    [ -f "$stamp" ] && return 0
    if [ "${WINE_PPC64LE_NO_PREREQ_SEED:-0}" = 1 ]; then
        say "prerequisite markers not seeded (WINE_PPC64LE_NO_PREREQ_SEED=1)"
        return 0
    fi
    # A prefix that already answers the question -- somebody installed
    # wine-mono, or a real .NET -- is left exactly as it is.
    if grep -q "NET Framework Setup" "$prefix/system.reg" 2>/dev/null; then
        say "prefix already answers the .NET detection keys; not seeding"
        : > "$stamp" 2>/dev/null
        return 0
    fi
    reg=$compat/.wine-ppc64le-prereq.reg
    # Release 528040 is .NET 4.8, the value Microsoft documents for detecting
    # "4.8 or later"; the Client and Full subkeys are the two an installer
    # actually reads, and the Wow6432Node copies are what a 32-bit stage of
    # the same installer reads.
    cat > "$reg" <<'REGEOF'
REGEDIT4

[HKEY_LOCAL_MACHINE\Software\Microsoft\NET Framework Setup\NDP\v4\Full]
"Install"=dword:00000001
"Release"=dword:00080ea8
"Version"="4.8.04084"
"TargetVersion"="4.0.0"
"InstallPath"="C:\\windows\\Microsoft.NET\\Framework64\\v4.0.30319\\"

[HKEY_LOCAL_MACHINE\Software\Microsoft\NET Framework Setup\NDP\v4\Client]
"Install"=dword:00000001
"Release"=dword:00080ea8
"Version"="4.8.04084"
"TargetVersion"="4.0.0"
"InstallPath"="C:\\windows\\Microsoft.NET\\Framework64\\v4.0.30319\\"

[HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\NET Framework Setup\NDP\v4\Full]
"Install"=dword:00000001
"Release"=dword:00080ea8
"Version"="4.8.04084"
"TargetVersion"="4.0.0"
"InstallPath"="C:\\windows\\Microsoft.NET\\Framework\\v4.0.30319\\"

[HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\NET Framework Setup\NDP\v4\Client]
"Install"=dword:00000001
"Release"=dword:00080ea8
"Version"="4.8.04084"
"TargetVersion"="4.0.0"
"InstallPath"="C:\\windows\\Microsoft.NET\\Framework\\v4.0.30319\\"
REGEOF
    if "$wine" reg import "$(winepath_w "$reg")" >/dev/null 2>&1 ||
       "$wine" regedit /S "$(winepath_w "$reg")" >/dev/null 2>&1; then
        say "seeded the .NET 4 detection keys so a prerequisite installer skips"
        say "  the stage that cannot succeed here (MSI 1633).  This claims .NET is"
        say "  present; it does not make managed code run.  WINE_PPC64LE_NO_PREREQ_SEED=1"
        say "  turns it off, and installing wine-mono into the prefix supersedes it."
        : > "$stamp" 2>/dev/null
    else
        say "could not seed the .NET detection keys; a prerequisite installer that"
        say "  chains .NET Framework 4 will fail its MSI with 1633 and the game's"
        say "  launcher will exit without starting it"
    fi
    rm -f "$reg" 2>/dev/null
}

# The windows path of a unix file, for the handful of calls that need one.
winepath_w() {
    "$wine" winepath -w "$1" 2>/dev/null || echo "$1"
}

seed_prereq_markers

# ------------------------------------------------------------ Steam bridge --
#
# A Windows game reaches Steam through steam_api64.dll, which reads
# HKCU\Software\Valve\Steam\ActiveProcess to find a steamclient DLL and then
# talks to the client through it.  On this port that DLL is the tree's own
# guest steamclient64.dll (dlls/steamclient64), and the real Steam client
# library lives in a separate x86-64 Linux helper process -- see
# ppc64le/steamapi/.  Two things therefore have to happen before the game
# starts, and both belong here rather than in wine.inf:
#
#   * THE HELPER HAS TO BE RUNNING, and something has to tell the game which
#     port it is on.  Only a launcher can do that.  It is also why the run
#     verbs below no longer exec: this script now owns a child process, so it
#     has to outlive the game in order to stop it again.  A stale helper would
#     hold a Steam connection open after the game is gone.
#
#   * THE REGISTRY VALUES HAVE TO EXIST.  They are Steam-specific state about
#     a Steam launch, so they are written per launch by the thing that knows a
#     Steam launch is happening, rather than baked into every prefix wineboot
#     ever creates.  The pid value is NOT written here: it has to name a live
#     process in this prefix, and the process that owns the Steam connection
#     is the game itself -- so steamclient64.dll writes it from its own
#     DllMain, which is Proton's steam_helper trick minus the helper .exe.
#
# SteamClientDll64 and SteamClientDll are BARE NAMES, not the absolute paths
# Windows would have.
# The port's guest loader refuses a path outright (load_guest_library in
# dlls/ntdll/signal_ppc64.c: "a guest namespace has no files, so a path means
# nothing") and resolves a bare name through the AMD64 search order, which
# finds the builtin.  If that refusal is ever relaxed this can become a path.
#
# WINE_PPC64LE_NO_STEAM_BRIDGE=1 turns the whole thing off, which is the
# supported way to see what a run looks like without it.

helper_pid=
helper32_pid=
presence_pid=
# Its own function, and called BEFORE the wineserver wait below, not only from
# the EXIT trap.  "wineserver -w" waits for every process in the prefix, and
# the publisher is one -- leave it running and the launcher waits for a process
# whose only job was to outlast a game that is already gone.
presence_stop() {
    if [ -n "${presence_pid:-}" ]; then
        say "stopping the steam presence publisher (pid $presence_pid)"
        kill "$presence_pid" 2>/dev/null
        wait "$presence_pid" 2>/dev/null
        presence_pid=
    fi
}

bridge_stop() {
    presence_stop
    if [ -n "$helper_pid" ]; then
        say "stopping the steam bridge helper (pid $helper_pid)"
        kill "$helper_pid" 2>/dev/null
        wait "$helper_pid" 2>/dev/null
        helper_pid=
    fi
    # The i386 helper is reaped the same way and unconditionally.  It is
    # commonly the one NOTHING connected to -- a 64-bit title never asks for it
    # -- and an unconnected helper never reaches its own --exit-when-idle,
    # which only fires when a client that did connect goes away.  So it is
    # exactly the process that would be left behind.
    if [ -n "$helper32_pid" ]; then
        say "stopping the i386 steam bridge helper (pid $helper32_pid)"
        kill "$helper32_pid" 2>/dev/null
        wait "$helper32_pid" 2>/dev/null
        helper32_pid=
    fi
}
trap 'bridge_stop' EXIT INT TERM

# THE WINDOWS-SIDE "STEAM IS RUNNING" OBJECTS.  A title wrapped in Valve's
# SteamStub -- its PE entry point sits in a .bind section -- asks, before it
# jumps to the real entry point, whether a Steam client is present in this
# session, by opening two named kernel objects:
#
#     Local\SteamStart_SharedMemLock   (event)
#     Local\SteamStart_SharedMemFile   (section)
#
# On Windows steam.exe publishes them; under Proton, Proton's steam.exe does.
# Nothing on this port did, so the stub concluded Steam was not running, put
# up an MB_ICONERROR box and called TerminateProcess(-1, 0x33): the rc=51 that
# killed Oblivion Remastered and Frostpunk 2.  [MEASURED 2026-08-30, both
# titles' shipping .exe have a .bind entry point; the OpenEventA /
# OpenFileMappingA pair and the rc=51 are in the oblivion run log of that day.]
#
# It is a SEPARATE PROCESS, started before the game, because the stub runs at
# the entry point and picks its own moment to load steam_api64.dll -- anything
# published from inside the game process is published at an ordering the game
# controls, and this one cannot lose that race.
#
# It runs only from here, i.e. only when bridge_start() got the helper up,
# which happens only when the helper loaded the user's real running Steam
# client library.  No client, no presence: the objects say something true or
# they are not published at all.
presence_start() {
    presence=$src/ppc64le/steamapi/presence/steampresence.exe
    if [ ! -f "$presence" ]; then
        say "building the steam presence publisher"
        if ! "$src/ppc64le/steamapi/presence/build-presence.sh" >/dev/null 2>&1; then
            say "presence build FAILED; a SteamStub title will say Steam is not running"
            return 1
        fi
    fi

    presence_log=$compat/steampresence-$$.log
    "$wine" "$presence" >"$presence_log" 2>&1 &
    presence_pid=$!

    # Wait for it to say it published, rather than sleeping a guess.  A guest
    # process on this port takes a moment to come up through the emulator, and
    # publishing AFTER the game has already probed is the same as not
    # publishing at all.
    # 120s, not 30: a guest process comes up through the emulator, and this
    # one is racing a machine that is about to start a game.  Waiting longer
    # costs a slower launch; not waiting long enough costs the whole run,
    # because a title that probed before the objects existed is a title that
    # died for the reason this function exists to remove.
    n=0
    while [ $n -lt 1200 ]; do
        grep -q 'holding' "$presence_log" 2>/dev/null && break
        kill -0 "$presence_pid" 2>/dev/null || { presence_pid=; break; }
        n=$((n + 1))
        sleep 0.1
    done
    if [ -z "${presence_pid:-}" ] || ! grep -q 'holding' "$presence_log" 2>/dev/null; then
        say "the steam presence publisher did not come up; see $presence_log"
        return 1
    fi
    say "steam presence published (pid $presence_pid, log $presence_log)"
    return 0
}

# Start ONE helper.  $1 is the machine as build-helper.sh spells it, $2 the
# executable name.  Results come back in helper_port and helper_started_pid
# rather than on stdout, because a command substitution would run this in a
# subshell and the background pid we have to reap would die with it.
helper_port=
helper_started_pid=
helper_launch() {
    _machine=$1
    _exe=$src/ppc64le/steamapi/helper/$2
    helper_port=
    helper_started_pid=

    if [ ! -x "$_exe" ]; then
        say "building the $_machine steam bridge helper"
        if ! "$src/ppc64le/steamapi/helper/build-helper.sh" --machine "$_machine"; then
            say "$_machine helper build FAILED"
            return 1
        fi
    fi

    _log=$compat/steamhelper-$_machine-$$.log
    # --exit-when-idle belts the EXIT trap above.  A trap does not run when
    # THIS script is killed with SIGKILL, which is how a stuck run gets cleaned
    # up, and a helper leaked that way sits holding a port and a connection to
    # the user's Steam client indefinitely (measured: one found still running
    # hours later).  The helper also arms PR_SET_PDEATHSIG for the same reason;
    # this covers the other order, where the script exits without the trap
    # firing but the helper's game has already gone.  One launch is one client
    # connection, so "idle" here means "the game is gone".
    "$_exe" --serve --port 0 --exit-when-idle >"$_log" 2>&1 &
    helper_started_pid=$!

    n=0
    while [ $n -lt 100 ]; do
        helper_port=$(sed -n 's/.*listening on 127\.0\.0\.1:\([0-9][0-9]*\).*/\1/p' \
                   "$_log" 2>/dev/null | head -1)
        [ -n "$helper_port" ] && break
        kill -0 "$helper_started_pid" 2>/dev/null || { helper_started_pid=; break; }
        n=$((n + 1))
        sleep 0.1
    done
    if [ -z "${helper_port:-}" ]; then
        say "the $_machine steam bridge helper did not come up; see $_log"
        [ -n "${helper_started_pid:-}" ] && kill "$helper_started_pid" 2>/dev/null
        helper_started_pid=
        return 1
    fi
    say "$_machine steam bridge helper on 127.0.0.1:$helper_port (pid $helper_started_pid, log $_log)"
    return 0
}

# BOTH WIDTHS, EVERY LAUNCH.  A frame is the params struct's own bytes, so a
# guest steamclient DLL can only be served by a helper of its own pointer
# width -- steamrpc_wire.h puts the width in the frame magic precisely so a
# mismatched pair refuses instead of misreading.  That makes "which helper" a
# question this script cannot answer by looking at the game: a 64-bit launcher
# .exe that spawns the 32-bit real game (or the reverse) is ordinary, and each
# process loads a steamclient DLL of its own width.  Sniffing the PE header of
# the exe we were handed would get Portal 2 right and get the next launcher
# wrong, silently.
#
# So start both and let each client read its own variable.  The cost of the
# one nothing connects to is a single idle process holding a loopback port: it
# never calls CreateInterface, so it holds no Steam connection, and bridge_stop
# reaps it.
bridge_start() {
    helper_launch x86_64 steamhelper || {
        say "helper build/launch FAILED; the game will see no Steam client"
        bridge_stop
        return 1
    }
    helper_pid=$helper_started_pid
    STEAM_BRIDGE_ADDR=127.0.0.1:$helper_port
    export STEAM_BRIDGE_ADDR

    # NOT fatal.  Without it a 32-bit title gets STEAMRPC_STATUS_NO_HELPER,
    # which is exactly where this port was before the i386 helper existed and
    # which Proton's own code is written to survive -- whereas failing the
    # whole launch here would take out every 64-bit title over a 32-bit
    # toolchain problem they do not care about.
    if helper_launch i386 steamhelper32; then
        helper32_pid=$helper_started_pid
        STEAM_BRIDGE_ADDR32=127.0.0.1:$helper_port
        export STEAM_BRIDGE_ADDR32
    else
        say "no i386 bridge helper; a 32-bit title will see no Steam client"
    fi

    "$wine" reg add 'HKCU\Software\Valve\Steam\ActiveProcess' /v SteamClientDll64 \
        /t REG_SZ /d 'steamclient64.dll' /f >/dev/null 2>&1
    # ...and the 32-bit one.  A PE32 title's own steam_api.dll reads
    # SteamClientDll, never SteamClientDll64 -- the two names are Steam's own
    # 32/64 split, both present in a real install -- so a 32-bit title finds
    # nothing at all if only the 64-bit value is written.  dlls/steamclient
    # builds the module that answers it.
    # A FULL PATH, where the 64-bit value above is a bare name, and the
    # difference is measured rather than stylistic.  [MEASURED 2026-08-30,
    # Portal 2 run 20260830-223350] A bare name sends steam_api.dll through the
    # ordinary Win32 search order, and a Source title has its own bin/ ahead of
    # system32 -- so Portal 2 loaded "Portal 2\bin\steamclient.dll", which is
    # VALVE'S REAL 8.8 MB WINDOWS CLIENT LIBRARY shipped in the depot, not this
    # tree's builtin.  It pulled in Kerberos/MSV1_0/rsaenh, failed to find a
    # Windows Steam client, and the engine put up "Steam is not running."
    #
    # The 64-bit lane never saw this because Portal 2 ships no
    # bin/win64/steamclient64.dll -- nothing was there to outrank the builtin
    # -- which is exactly why it stayed hidden until a 32-bit title got this
    # far.  A path skips the search entirely and names ours.
    # A REAL PATH TO THE BUILT FILE, where the 64-bit value above is a bare
    # name -- and the difference is measured, not stylistic.
    #
    # [MEASURED 2026-08-30, Portal 2 runs 20260830-223350 and -224014] A bare
    # name sends steam_api.dll through the ordinary Win32 search order, and a
    # Source title has its own bin/ ahead of the system directory.  Portal 2
    # therefore loaded "Portal 2\bin\steamclient.dll" -- VALVE'S REAL 8.8 MB
    # WINDOWS CLIENT LIBRARY, shipped in the depot -- which pulled in
    # Kerberos/MSV1_0/rsaenh looking for a Windows Steam client, found none,
    # and the engine put up "Steam is not running."  The bridge was never
    # reached: both helpers sat idle with the game running.
    #
    # The 64-bit lane never saw this because Portal 2 ships no
    # bin/win64/steamclient64.dll, so nothing outranked the builtin there.
    # That is why it stayed hidden until a 32-bit title got this far.
    #
    # A bare name cannot be rescued with WINEDLLOVERRIDES=steamclient=b either:
    # a guestpe module carries no builtin marker, so Wine classes it native
    # (the loaddll trace says "native" for C:\windows\system32\steamclient.dll)
    # and "b" then matches nothing at all -- measured, run 20260830-223526,
    # where no steamclient loaded whatsoever.  Nor does a system32 path work on
    # its own: the builtin is virtual, resolved by NAME through
    # find_builtin_dll, and no such file exists in the prefix.
    #
    # So name the file that actually exists.  $tree is the build directory.
    "$wine" reg add 'HKCU\Software\Valve\Steam\ActiveProcess' /v SteamClientDll \
        /t REG_SZ /d "Z:$(printf %s "$tree/dlls/steamclient/i386-windows/steamclient.dll" | tr / '\\')" \
        /f >/dev/null 2>&1
    "$wine" reg add 'HKCU\Software\Valve\Steam\ActiveProcess' /v Universe \
        /t REG_SZ /d 'Public' /f >/dev/null 2>&1
    "$wine" reg add 'HKCU\Software\Valve\Steam' /v SteamPath \
        /t REG_SZ /d 'C:\Program Files (x86)\Steam' /f >/dev/null 2>&1
    say "wrote ActiveProcess\\SteamClientDll64=steamclient64.dll, SteamClientDll=steamclient.dll"
    # steam_api reads ActiveProcess\PID and checks it names a LIVE process
    # before it will load any client DLL at all -- Proton's steam.exe helper
    # writes its own pid.  There is no helper exe here, so name the prefix's
    # services.exe, which outlives every run in this session; steam_api only
    # liveness-checks it, and every pipe call after the load goes through our
    # steamclient64 rather than anything keyed to that pid.
    svcpid=$("$wine" winedbg --command "info proc" 2>/dev/null | \
             awk '/services.exe/ { gsub(/^[ =]+/, "", $0); print $1; exit }')
    if [ -n "$svcpid" ]; then
        "$wine" reg add 'HKCU\Software\Valve\Steam\ActiveProcess' /v PID \
            /t REG_DWORD /d $((0x$svcpid)) /f >/dev/null 2>&1
        say "wrote ActiveProcess\\PID=0x$svcpid (services.exe)"
    else
        say "WARNING: no services.exe pid found; steam_api will say Steam is not running"
    fi
    # The SteamStub liveness objects.  After the registry, because a title
    # that reads both wants the registry to already be right, and before the
    # game, which is the whole point.  A failure here is not fatal: a title
    # with no stub does not care, and one with a stub will say so loudly.
    # OFF BY DEFAULT, and it has to earn its way back on.  [MEASURED
    # 2026-08-30] These objects are necessary but NOT sufficient: with them
    # published, Oblivion's stub stops failing at OpenEventA and instead takes
    # the lock (WaitForSingleObject, 5 s) and maps the section
    # (MapViewOfFile, FILE_MAP_WRITE) -- and then still refuses, because it
    # reads Valve's CSharedMemStream contents out of the page and a zeroed
    # page is not a valid one.  No title has been shown to get PAST the probe.
    #
    # And an empty channel can be worse than no channel.  What these two names
    # denote is not a flag, it is a CSharedMemStream -- a lock event plus a
    # shared buffer that callers WRITE to and block on.  Software that finds
    # nothing falls back; software that finds the objects will try to USE
    # them, and an empty stream can send it down a path it never takes when
    # Steam is simply absent.  That risk is the reason for the default; it is
    # NOT a measured regression.  Portal 2 was suspected of exactly this and
    # was CLEARED: a one-variable bisect on 2026-08-30 (16:14 off, 16:15 on,
    # nothing else changed) produced two runs whose logs differ only in this
    # script's own presence lines and the environment echo -- same modules,
    # same stop after filesystem_stdio.dll, same rc=1 with the publisher off.
    # Portal 2 regressed between 12:28 and 16:10 for some other reason;
    # portal2.exe is machine 0x014c, i386, which this publisher never touches.
    #
    # So: opt in per title, in appconfig/<appid>.env, once that title is
    # measured to be better with it.  Every other launch pays nothing.
    if [ "${WINE_PPC64LE_STEAM_PRESENCE:-0}" = 1 ]; then
        presence_start || say "continuing without the SteamStub liveness objects"
    else
        say "steam presence publisher off (WINE_PPC64LE_STEAM_PRESENCE=1 turns it on)"
    fi
    # SteamClientDll (the 32-bit name) IS written now, above.  It used to be
    # deliberately omitted because there was no 32-bit guest steamclient and
    # naming a DLL that does not exist only moves a game's failure from "no
    # value" to "load failed".  dlls/steamclient now builds one, and it loads
    # and binds (ppc64le/games/probe-dllload.sh --machine i386 steamclient.dll).
    # Since 2026-08-30 it can also REACH a Steam client: helper_launch above
    # starts an i386 steamhelper32 beside the x86-64 one, built from the same
    # sources against Steam's own ~/.steam/sdk32/steamclient.so, and the client
    # picks it up from STEAM_BRIDGE_ADDR32.  The width magic in
    # dlls/steamclient64/steamrpc_wire.h stays exactly as it was and is now the
    # backstop rather than the whole answer: if the two are ever crossed, the
    # pairing still refuses loudly instead of answering with garbage.
    return 0
}

case $verb in
run|runinprefix|waitforexitandrun)
    if [ "${WINE_PPC64LE_NO_STEAM_BRIDGE:-0}" = 1 ]; then
        say "steam bridge disabled by WINE_PPC64LE_NO_STEAM_BRIDGE"
    else
        bridge_start || say "continuing without a steam bridge"
    fi
    # Per-game appconfig/<appid>.env is applied much earlier, before the
    # first wine invocation of the run -- see the block above the
    # environment dump for why (the wineserver inherits from the FIRST
    # client, and some settings must reach the server itself).
    # Some games ship more than one binary and Steam's launch config picks the
    # wrong one for this port -- DOOM (2016) defaults to the OpenGL DOOMx64.exe
    # where only the Vulkan DOOMx64vk.exe is served.  WINE_PPC64LE_RUN_EXE in a
    # game's launch options names a replacement: a bare name resolves beside
    # the exe Steam asked for, an absolute path is taken as-is.  Explicit,
    # logged, and refused loudly when the file is not there -- silently
    # launching the original would report the wrong binary's failure.
    #
    # THE GAME'S EXE, not whatever this tool was handed.  The swap names a
    # replacement for the binary Steam's launch config picked, so it only
    # makes sense on the verb Steam launches the game with.  A background
    # pre-step arrives on `run` with an exe from somewhere else entirely --
    # legacycompat\iscriptevaluator.exe -- and the bare-name form resolves
    # beside THAT, so the swap would look for DOOMx64vk.exe in Steam's
    # legacycompat directory, not find it, and the "refused loudly" branch
    # would kill the pre-step before it ran at all.  Measured: rc=1 with
    # "FATAL: WINE_PPC64LE_RUN_EXE names .../legacycompat/DOOMx64vk.exe, which
    # does not exist" and no guest started.  Live Steam does not hit this only
    # because it leaves SteamAppId unset on the pre-step, so appconfig is
    # keyed to "none" there -- an accident, not a design, and one that would
    # stop protecting us the day Steam sets it or a user exports it by hand.
    if [ "$verb" = waitforexitandrun ] && [ -n "${WINE_PPC64LE_RUN_EXE:-}" ] && [ $# -ge 1 ]; then
        case $WINE_PPC64LE_RUN_EXE in
        */*) swap=$WINE_PPC64LE_RUN_EXE ;;
        *)   swap=$(dirname "$1")/$WINE_PPC64LE_RUN_EXE ;;
        esac
        if [ -f "$swap" ]; then
            say "WINE_PPC64LE_RUN_EXE: $1 -> $swap"
            shift
            set -- "$swap" "$@"
        else
            say "FATAL: WINE_PPC64LE_RUN_EXE names $swap, which does not exist"
            exit 1
        fi
    fi
    # A crashing guest raises winedbg's GUI on the user's desktop, and Steam
    # runs background probes (d3ddriverquery64.exe) under this tool whose
    # crashes must not pop dialogs -- Proton suppresses its debugger for the
    # same reason.  Overriding winedbg.exe out makes start_debugger's
    # CreateProcess fail, so the unhandled-exception filter falls through to
    # terminating the process, which is what a background probe's crash
    # should be.  The user's own WINEDLLOVERRIDES entries are kept.
    # WINE_PPC64LE_WINEDBG=1 restores the debugger.
    if [ "${WINE_PPC64LE_WINEDBG:-0}" != 1 ]; then
        WINEDLLOVERRIDES="winedbg.exe=d${WINEDLLOVERRIDES:+;$WINEDLLOVERRIDES}"
        export WINEDLLOVERRIDES
        say "winedbg suppressed (WINEDLLOVERRIDES=$WINEDLLOVERRIDES)"
    fi
    # The same argument one step further out.  Suppressing winedbg stops a
    # CRASH from raising a window; it does nothing about a program that asks a
    # question.  A modal message box on a run with no user is not a slow
    # answer, it is a permanent one -- the process sits in the dialog's own
    # message loop until something kills it, and Steam's launch sits behind
    # its exit code.
    #
    # MEASURED, and this is what task #12 turned out to be: after any change
    # to a compatibility tool Steam inserts its legacycompat pre-step, and
    # iscriptevaluator.exe calls ShellExecuteEx on legacycompat\SteamService.exe.
    # That helper is a 32-bit i386 PE; this port has no 32-bit guest, so
    # CreateProcess answers ERROR_BAD_EXE_FORMAT, shell32 raises its error box,
    # and the pre-step never returns.  Under `timeout 60` that is rc=124; with
    # somebody to click OK it is rc=1 and a dialog naming a handle that was
    # never the problem.
    #
    # Which runs get this is not a guess.  Steam sends the game as
    # waitforexitandrun and every background pre-step as run -- true of all 22
    # launches recorded in this app's compatdata, and it is the same split
    # Proton's own protocol makes.  So `run` is the verb with nobody watching,
    # and only `run` answers its dialogs; the game keeps every box it raises.
    # Nothing is swallowed either way: user32 logs the caption, the text and
    # the button it pressed at ERR level, which is on without WINEDEBUG.
    # A caller that already set the variable -- a launch option, a gate --
    # keeps its own value, so WINE_PPC64LE_NO_DIALOGS=0 restores the dialogs.
    if [ "$verb" = run ] && [ -z "${WINE_PPC64LE_NO_DIALOGS:-}" ]; then
        WINE_PPC64LE_NO_DIALOGS=1
        export WINE_PPC64LE_NO_DIALOGS
        say "background pre-step: message boxes answered, not shown (WINE_PPC64LE_NO_DIALOGS=1)"
    fi
    ;;
esac

# -------------------------------------------------------------------- numa --
#
# WHICH NUMA NODE THE GAME RUNS ON.  the test machine is two nodes (0 and 8) whose `node
# distances` are 10 local and 40 remote, so a remote line costs about four
# times a local one.  A guest process on this port is deliberately NOT
# confined: ppc64le/cpu/TOPOLOGY.md's rule is that an unrestricted affinity
# mask -- what "the thread never asked" looks like -- means every online
# processor across every group, so Linux spreads a game's threads over both
# nodes.  [MEASURED] DOOM (2016) mid-session: 38 threads on node 0 and 35 on
# node 8, with its 3.5 GB split 2.1/1.4 between them.
#
# That is not obviously right.  Windows keeps a process inside ONE processor
# group unless it asks for another, and this port's own concurrency ceiling is
# latency-bound rather than throughput-bound -- so a job system whose queues
# ping-pong across a 4x-distance link is exactly the shape that suffers.  It is
# also not obviously wrong: two nodes is twice the memory bandwidth.
#
# So it is a lever rather than a decision.  WINE_PPC64LE_NUMA_NODE=<id> binds
# the game (and the wineserver it starts, which inherits this) to one node;
# unset, or "off", changes nothing.  WINE_PPC64LE_NUMA_MEM chooses how strict
# the memory half is: "membind" (the default) allocates only there and fails
# over to nothing, "preferred" allocates there when it can and elsewhere when
# it cannot, "none" binds the cpus and leaves memory alone.
#
# The bridge helper is deliberately outside this: it is an x86-64 process under
# the outer FEX serving Steamworks calls, not part of the game's working set.
numa_run=
case ${WINE_PPC64LE_NUMA_NODE:-} in
""|off|none)
    ;;
*)
    if command -v numactl >/dev/null 2>&1; then
        case ${WINE_PPC64LE_NUMA_MEM:-membind} in
        preferred) numa_run="numactl --cpunodebind=$WINE_PPC64LE_NUMA_NODE --preferred=$WINE_PPC64LE_NUMA_NODE" ;;
        none)      numa_run="numactl --cpunodebind=$WINE_PPC64LE_NUMA_NODE" ;;
        *)         numa_run="numactl --cpunodebind=$WINE_PPC64LE_NUMA_NODE --membind=$WINE_PPC64LE_NUMA_NODE" ;;
        esac
        say "NUMA: $numa_run"
    else
        say "WINE_PPC64LE_NUMA_NODE=$WINE_PPC64LE_NUMA_NODE but numactl is not \
installed; running unbound"
    fi
    ;;
esac

# --------------------------------------------------------------------- run --

case $verb in
getcompatpath)
    # unix path -> windows path, on Steam's stdout
    "$wine" winepath -w "$@" >&3
    exit $?
    ;;
getnativepath)
    # windows path -> unix path, on Steam's stdout
    "$wine" winepath -u "$@" >&3
    exit $?
    ;;
run|runinprefix)
    # No longer an exec: this script owns the bridge helper and has to be here
    # to stop it when the game is gone.  The EXIT trap does that.
    say "run $numa_run $wine $*"
    # unquoted deliberately: $numa_run is a command line, not one word
    $numa_run "$wine" "$@"
    rc=$?
    say "game exited rc=$rc"
    presence_stop
    exit $rc
    ;;
waitforexitandrun)
    say "run $numa_run $wine $*"
    $numa_run "$wine" "$@"
    rc=$?
    say "game exited rc=$rc"
    presence_stop
    say "waiting for wineserver"
    "$wineserver" -w
    say "wineserver gone"
    exit $rc
    ;;
*)
    say "unknown verb '$verb'; treating as run"
    "$wine" "$@"
    exit $?
    ;;
esac
