#!/bin/bash
# with-game-lock -- serialise game launches across concurrent agents.
#
# WHY THIS EXISTS.  Only one title can hold the foreground on this box, and a
# second launch into the same prefix does not fail cleanly -- it contends.  On
# 2026-08-30 two benchmark loops overlapped: the second one's "wait for the game
# to appear" latched onto the FIRST one's already-running process, saw it exit,
# declared its own leg finished before that leg had finished loading, and
# launched again on top of itself.  Two games, one prefix, both numbers
# worthless, and ~20 minutes of machine time burned.
#
# So: take the lock, and do not start while any game is still up.  The lock is
# advisory (flock) and covers the whole command, including the wait for the
# game to exit -- which is the part that matters, because the contention window
# is the RUN, not the launch.
#
#   usage:  with-game-lock [--timeout SEC] [--run-timeout SEC] -- <command> ...
#
# --run-timeout defaults to 1800 and exists because a title that has ALREADY
# FAILED may never exit.  Quake II prints
#     Standard exception caught in kexPlatformApp::Main: index
# and then hangs indefinitely; twice it sat holding this lock -- once for 22
# minutes, once for 39 -- with five other agents queued behind it, and both
# times a human had to SIGTERM it by hand.  A caller who forgets to wrap its
# own command should not be able to stall everyone else, so the wrapper does
# it.  Pass --run-timeout 0 to opt out deliberately.
#
# Exits 75 (EX_TEMPFAIL) if the lock could not be taken in time, so a caller can
# tell "busy, try later" from "your command failed".
set -u

LOCK=${GAME_LOCK:-$HOME/.local/share/wine-ppc64le/.game-launch.lock}
TIMEOUT=1800
RUN_TIMEOUT=${RUN_TIMEOUT:-1800}
IDLE_GRACE=${IDLE_GRACE:-600}

while [ $# -gt 0 ]; do
    case $1 in
    --timeout) TIMEOUT=${2:?--timeout needs seconds}; shift 2 ;;
    --run-timeout) RUN_TIMEOUT=${2:?--run-timeout needs seconds}; shift 2 ;;
    --) shift; break ;;
    -*) echo "with-game-lock: unknown option $1" >&2; exit 2 ;;
    *) break ;;
    esac
done
[ $# -gt 0 ] || { echo "usage: with-game-lock [--timeout SEC] -- <command> [args...]" >&2; exit 2; }

# Automation must not put modal boxes on the user's desktop.  A failing title
# raises one per launch and waits for a human; on 2026-08-30 the user sat back
# down to roughly a dozen of them, from agent launches they had not asked for,
# and NO run log contained any of their text -- so the only record of what the
# titles were complaining about was the user having read them off the screen.
#
# WINE_PPC64LE_NO_DIALOGS makes user32 answer the default button and log the
# caption and text at ERR instead (dlls/user32/msgbox.c).  proton already sets
# it for its background pre-step but not for the real launch, which is the case
# that reaches a screen.
#
# Set HERE rather than in run-native or proton deliberately: this wrapper is
# the automation boundary.  A human launching a title by hand does not go
# through it and keeps their dialogs, which is right -- a real prompt should be
# answerable.  An explicit setting from the caller always wins.
: "${WINE_PPC64LE_NO_DIALOGS:=1}"
export WINE_PPC64LE_NO_DIALOGS

mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"

if ! flock -w "$TIMEOUT" 9; then
    echo "with-game-lock: another agent has held the game lock for ${TIMEOUT}s; not launching" >&2
    exit 75
fi

# Holding the lock is necessary but not sufficient: a previous holder may have
# died without reaping its game, or the owner may be playing something by hand.
# Refuse to stack on top of a live title either way.
t0=$SECONDS
while pgrep -x GameThread >/dev/null \
   || pgrep -f "steamtool/proton waitforexitandrun" >/dev/null; do
    if [ $((SECONDS-t0)) -ge "$IDLE_GRACE" ]; then
        echo "with-game-lock: a game is STILL running after ${IDLE_GRACE}s with the lock held;" >&2
        echo "  something is wrong -- not launching.  Do NOT SIGKILL it; report instead." >&2
        pgrep -a -x GameThread >&2
        exit 75
    fi
    sleep 10
done

# timeout sends SIGTERM (never SIGKILL -- a hard kill mid-GPU-submission has
# wedged this GPU and needed a reboot).  -k would escalate to SIGKILL, so it is
# deliberately NOT passed here; a title that ignores SIGTERM is reported, not
# forced.
if [ "$RUN_TIMEOUT" -gt 0 ] 2>/dev/null; then
    timeout --signal=TERM "$RUN_TIMEOUT" "$@"
    rc=$?
    [ "$rc" -eq 124 ] && echo "with-game-lock: command exceeded ${RUN_TIMEOUT}s and was SIGTERMed" >&2
else
    "$@"
    rc=$?
fi

# Reap the prefix before releasing.  A run that ends -- cleanly, by timeout, or
# by SIGTERM -- leaves its wineserver and a full set of prefix daemons behind:
# services.exe, winedevice.exe, plugplay.exe, rpcss.exe, svchost.exe, and two
# explorer.exe.  Nothing here reaped them, and on 2026-08-30 that had
# accumulated to EIGHTY-TWO processes across twelve prefixes over two days,
# which is how the user noticed something was wrong.
#
# `wineserver -k` is the right tool and the reason matters: killing the
# wineserver PID directly -- which is what was done by hand that day -- leaves
# its children reparented to init with no server to talk to, and winedevice.exe
# then ignores SIGTERM because it is blocked waiting on the server that just
# vanished.  Clearing those took SIGKILL.  Asking the server to shut down
# instead makes the children exit on their own.
#
# Only ever runs while this lock is held and no game is up, so it cannot reap a
# prefix somebody else is using.
reap_prefixes() {
    command -v wineserver >/dev/null 2>&1 || return 0
    pgrep -x GameThread >/dev/null && return 0
    for _pfx in "${WINE_PPC64LE_COMPAT_ROOT:-$HOME/.local/share/wine-ppc64le}"/*/pfx; do
        [ -d "$_pfx" ] || continue
        WINEPREFIX=$_pfx wineserver -k 2>/dev/null
    done
}

# Do not release until our own game is gone, or the next holder inherits it.
#
# Match the SAME set of processes the entry check does.  This loop originally
# watched only GameThread, which is a name Cyberpunk and the UE titles happen
# to use -- Quake II's process is `quake2ex_steam.exe`, so a Quake II run that
# printed its fatal exception and then failed to exit was invisible here.  It
# held the lock for 22 minutes with four other agents queued behind it, and
# needed a hand SIGTERM to clear.  Watch the launcher too: it is game-agnostic
# and it is what `run-native` actually waits on.
t0=$SECONDS
while pgrep -x GameThread >/dev/null \
   || pgrep -f "steamtool/proton waitforexitandrun" >/dev/null; do
    [ $((SECONDS-t0)) -ge "$IDLE_GRACE" ] && break
    sleep 10
done
reap_prefixes
exit $rc
