# DOOM (2016).  Steam's launch config runs the OpenGL DOOMx64.exe by default;
# this port currently serves the Vulkan binary.  Remove this line once the
# opengl32 guest thunk lands and the GL build works too.
WINE_PPC64LE_RUN_EXE=DOOMx64vk.exe

# NUMA is a MACHINE choice, not a title one, so it ships off.  On a box with
# more than one node, binding a game to a single node can help: measured here,
# unbound DOOM put 38 threads on one node and 35 on another with its 3.5 GB
# split between them, on a machine whose remote distance is four times its
# local one.  Whether that costs you anything depends on your machine, so try
# it rather than inherit it -- uncomment and pick a node from `numactl
# --hardware`.  See the numa block in ../proton.
#WINE_PPC64LE_NUMA_NODE=0

# Present mode: force FIFO, or the native lane flickers.
#
# [MEASURED 2026-08-22] DOOM renders correctly under emulated Proton on this
# machine and flickers on the native lane -- same GPU, Mesa, compositor and
# Xwayland, and with the rendered image itself CORRECT.  Setting this one
# variable removes the flicker entirely.
#
# The content being right rules out the marshalling: DOOM's 96 vulkan-1
# imports are all static core-1.0 sync and WSI, winevulkan is byte-identical
# to pristine 11.15 and deep-copies VkPresentInfoKHR/VkSubmitInfo, and handles
# are int64 throughout.  What is left is pacing -- Mesa sets
# XCB_PRESENT_OPTION_ASYNC on every present in IMMEDIATE and FIFO_RELAXED, so
# a frame that misses vblank is flipped anyway.  The emulated lane is FASTER
# here and holds vblank; the native lane, JIT-jittery, does not.
#
# WHICH of two mechanisms is UNRESOLVED, because forcing fifo also stops
# create_host_swapchain() (dlls/win32u/vulkan.c) from ever needing its
# present-mode retry -- so a run with this set cannot tell us whether that
# retry was demoting the mode on its own.  To settle it: run WITHOUT this
# line, with WINEDEBUG=warn+vulkan, and grep for "retrying with mode".  If
# that line appears, the demotion is ours and this becomes a workaround for a
# bug worth fixing rather than a setting.
MESA_VK_WSI_PRESENT_MODE=fifo
