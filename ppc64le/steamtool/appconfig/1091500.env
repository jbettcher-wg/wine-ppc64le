# Cyberpunk 2077 (Steam appid 1091500; the GOG copy runs with run-native
# --appid 1091500 so this file applies there too).
#
# Launch the game binary directly with -skipStartScreen (an argv flag, so it
# cannot live in this file): REDprelauncher.exe is a Qt WebEngine launcher
# with its own embedded browser, a stack this port has no reason to carry
# when `Cyberpunk2077.exe -skipStartScreen` is the documented bypass.

# The game's own icu pair, not the builtins: the game ships icuuc/icuin built
# against its data tables, and the builtin ICU answers with different table
# versions than REDengine's data files expect.
WINEDLLOVERRIDES=icuuc,icuin=n

# THE SPECKLE IS SOLVED (2026-08-19, the -benchmark A/B): it was never
# memory or DMA -- ID3D12GraphicsCommandList::ClearDepthStencilView passes
# FLOAT by value and was a named refusal in the marshal table, so the game
# never cleared depth and every 3D pass tested against stale depth/HTILE
# (dense per-pixel confetti in darks, a fixed dot lattice in haze -- the
# HTILE tile pattern).  The hand walker (hand_clear_dsv + the unixlib's
# FP_SHAPE_CLEAR_DSV typed call) fixed it: benchmark clean end to end
# (avg fps unchanged at ~15.6 -- the lane stays CPU-bound).  The
# elimination record that got there: host_vk_storm (host Vulkan, 7.7 GiB/leg)
# and copy_storm_run.sh (guest, 2.3 GiB/leg) both byte-clean in BOTH
# placements, cross-ISA dxil-spirv byte-identical on all 2176 game shaders,
# emulated lane clean with THIS tree's vkd3d cross-built x86-64.
#
# no_upload_hvv stays GONE for a real reason: the V620's 30 GiB device heap
# is fully host-visible/ReBAR, so the exhaustion the flag guards against
# cannot happen and the flag only moved uploads into GTT.  (Its apparent
# effect on the speckle was depth-garbage luck, not mechanism.)
#
# nodxr: RADV on NAVI21 exposes ray tracing, so the game sees a real DXR tier
# and builds its RT pipelines -- through ID3D12Device5::CreateStateObject,
# whose D3D12_STATE_OBJECT_DESC hides interface pointers behind const void*
# and is a named refusal in the marshal table (no hand-written walker yet).
# [MEASURED 2026-08-19, run 35]: the game renders its title screen at 245 fps,
# then reads the E_NOTIMPL as "outdated or corrupted GPU drivers" and force-
# closes.  With DXR hidden the game runs raster, which is all this hardware
# should be asked for anyway; the state-object walker is the lift that would
# let RT be offered honestly.
VKD3D_CONFIG=nodxr

# REDengine predates processor groups and refuses the 2x40 view of this
# POWER8 in engine init (REDEngineErrorReporter before d3d12 ever loads).
# The emulated lane boots the same game because FEX presents the classic
# 1x64 view; this cap reproduces it.  Measured, not assumed: the topology
# probe on both lanes is in the 2026-08-19 session record.
WINE_PPC64LE_CPU_LIMIT=64

# Spin-collapse, K validated ON THIS TITLE by the emulated lane's sweep
# (~/.config/fex-emu/AppConfig/Cyberpunk2077.exe.json, 2026-08-15): off->on
# was +60% scene fps and p99 -52% on the built-in benchmark, and K=128 beat
# 32 and 512 on CONSISTENCY (mean spread 0.7% vs 6.2%/3.5%) in a
# 16/32/64/128 + 32/128/512 sweep.  UNSET MEANS OFF -- 32 is only the
# default K once the feature is enabled, so leaving this out does not get
# a default, it gets nothing.  The bridge's JIT carries the same
# implementation (FEXCore PPC64LE BranchOps), so the knob crosses lanes;
# the native-lane delta is unmeasured until the A/B runs.
FEX_SPINCOLLAPSE=128
