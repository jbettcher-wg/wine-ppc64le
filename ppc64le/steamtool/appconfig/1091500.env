# Cyberpunk 2077 (Steam appid 1091500; the GOG copy runs with run-native
# --appid 1091500 so this file applies there too).
#
# Launch the game binary directly with -skipStartScreen (an argv flag, so it
# cannot live in this file): REDprelauncher.exe is a Qt WebEngine launcher
# with its own embedded browser, a stack this port has no reason to carry
# when `Cyberpunk2077.exe -skipStartScreen` is the documented bypass.

# The game's own icu pair, not the builtins: the game ships icuuc/icuin built
# against its data tables, and the builtin ICU answers with different table
# versions than REDengine's data files expect.
WINEDLLOVERRIDES=icuuc,icuin=n

# no_upload_hvv is GONE; its removal made the speckle much better, NOT gone.
# [MEASURED 2026-08-19, runs 36->38]: runs with the flag (mesh shaders on
# AND off) rendered most textured surfaces with a dense speckle,
# settings-independent; the run without it is visibly improved but the game
# STILL corrupts in ordinary play -- the user's read of the remaining
# pattern is memory corruption, and nothing measured yet contradicts it.  The flag forces upload heaps into heap 0
# (GTT, CPU-cached system RAM); without it they sit in heap 1, which on this
# V620 is full-ReBAR host-visible VRAM, 30 GiB of it -- so the exhaustion
# the flag was added for cannot happen and the flag buys nothing.
#
# The MECHANISM is narrower than first thought and still open:
# ppc64le/vkd3d/probes/copy_pattern_run.sh drives a known pattern through
# upload->texture->readback in BOTH placements and both come back
# byte-identical, so the quiet single-buffer GTT case is fine and the
# marshal/copy path is cleared entirely.  The corruption needs game-scale
# GTT traffic (gigabytes of streaming uploads) to appear -- the shape of a
# kernel/amdgpu DMA problem on the custom 4K POWER8 kernel (high physical
# pages, window/TCE mapping) rather than anything in this tree.  RADV
# reports every host-visible type HOST_COHERENT throughout.
#
# nodxr: RADV on NAVI21 exposes ray tracing, so the game sees a real DXR tier
# and builds its RT pipelines -- through ID3D12Device5::CreateStateObject,
# whose D3D12_STATE_OBJECT_DESC hides interface pointers behind const void*
# and is a named refusal in the marshal table (no hand-written walker yet).
# [MEASURED 2026-08-19, run 35]: the game renders its title screen at 245 fps,
# then reads the E_NOTIMPL as "outdated or corrupted GPU drivers" and force-
# closes.  With DXR hidden the game runs raster, which is all this hardware
# should be asked for anyway; the state-object walker is the lift that would
# let RT be offered honestly.
VKD3D_CONFIG=nodxr

# REDengine predates processor groups and refuses the 2x40 view of this
# POWER8 in engine init (REDEngineErrorReporter before d3d12 ever loads).
# The emulated lane boots the same game because FEX presents the classic
# 1x64 view; this cap reproduces it.  Measured, not assumed: the topology
# probe on both lanes is in the 2026-08-19 session record.
WINE_PPC64LE_CPU_LIMIT=64
