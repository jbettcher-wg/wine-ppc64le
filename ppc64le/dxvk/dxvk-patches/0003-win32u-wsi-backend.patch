diff --git a/src/wsi/wsi_window.h b/src/wsi/wsi_window.h
index 55d8254..70bbb8f 100644
--- a/src/wsi/wsi_window.h
+++ b/src/wsi/wsi_window.h
@@ -201,4 +201,20 @@ namespace dxvk::wsi {
           VkInstance          instance,
           VkSurfaceKHR*       pSurface);
 
+  /**
+    * \brief Tell the backend a surface it made is going away
+    *
+    * The VkSurfaceKHR itself is destroyed by the caller, as it always was.
+    * This exists because a backend may own state BESIDE the Vulkan handle --
+    * the win32u backend holds a Wine client surface for the window, and
+    * nothing else in DXVK's WSI interface would ever tell it to let go, so
+    * the client window would outlive the swapchain and stay on screen.
+    * Backends that own nothing inherit the default and do nothing, so the
+    * behaviour of every existing driver is unchanged.
+    *
+    * \param [in] surface The surface being destroyed
+    */
+  void destroySurface(
+          VkSurfaceKHR        surface);
+
 }
