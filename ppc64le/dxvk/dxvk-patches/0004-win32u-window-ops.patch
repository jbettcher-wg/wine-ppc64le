diff --git a/src/wsi/wsi_window.h b/src/wsi/wsi_window.h
index 70bbb8fe..9f16006c 100644
--- a/src/wsi/wsi_window.h
+++ b/src/wsi/wsi_window.h
@@ -1,5 +1,7 @@
 #pragma once
 
+#include <cstdint>
+
 #include <windows.h>
 
 #include "wsi_monitor.h"
@@ -12,6 +14,24 @@ namespace dxvk::wsi {
     * \brief Impl-dependent state
     */
   struct DxvkWindowState {
+#if defined(DXVK_WSI_FOREIGN)
+    /* What the win32u driver has to put back when a swapchain leaves
+       fullscreen.  The foreign family had nothing here because none of its
+       drivers ever moved a window; the win32u one does, and the state belongs
+       to the SWAPCHAIN rather than to the driver -- two swapchains on two
+       windows go fullscreen independently, and a driver-side table keyed by
+       HWND would be a second place for that to be true.
+
+       `rect` is the OUTER rectangle, four ints in the order left, top, right,
+       bottom -- the same order and meaning as ppc64le/dxvk/dxvk_win32u_wsi.h's
+       window_rect, so nothing converts on the way through. */
+    struct {
+      int64_t style   = 0;
+      int64_t exstyle = 0;
+      int32_t rect[4] = { 0, 0, 0, 0 };
+      bool    saved   = false;
+    } foreign;
+#endif
 #if defined(DXVK_WSI_WIN32)
     struct {
       LONG style   = 0;
