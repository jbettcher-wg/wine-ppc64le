diff --git a/meson.build b/meson.build
index 032e75e..f5ee136 100644
--- a/meson.build
+++ b/meson.build
@@ -161,6 +161,12 @@ else
   if lib_glfw.found()
     compiler_args += ['-DDXVK_WSI_GLFW']
   endif
+  # Foreign-window / headless WSI: no toolkit, no link-time dependency.
+  # X11 mode needs Xlib's header at compile time only; libX11 is dlopened.
+  compiler_args += ['-DDXVK_WSI_FOREIGN']
