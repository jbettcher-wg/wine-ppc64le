+
+    /* Callable before init() and after quit(): DXGI's present path may run
+     * while the device is being torn down, and "we have no WSI driver" is not
+     * the same statement as "the display died". */
+    bool lost = s_driver && s_driver->isDisplayLost();
+
+    /* DXVK_DEBUG_DISPLAY_LOST=1 prints the address of this translation unit's
+     * own s_driver. That is the only way to see, from outside, that
+     * libdxvk_dxgi.so and libdxvk_d3d11.so each carry a private copy of this
+     * file with a private WsiDriver and a private X connection -- which is
+     * why DxgiSwapChain and D3D11Device once disagreed about whether the
+     * display was gone. Reported on transitions only, since the present loop
+     * calls this millions of times. */
+    static const bool s_debug =
+      dxvk::env::getEnvVar("DXVK_DEBUG_DISPLAY_LOST") == "1";
+    static bool s_reported = false;
+    static bool s_lastValue = false;
+
+    if (unlikely(s_debug) && (!s_reported || lost != s_lastValue)) {
+      s_reported = true;
+      s_lastValue = lost;
+      std::fprintf(stderr, "wsi[s_driver@%p]: driver=%p isDisplayLost=%d\n",
+        static_cast<void*>(&s_driver), static_cast<void*>(s_driver), int(lost));
+    }
+
+    return lost;
+  }
+
   bool isMinimized(HWND hWindow) {
     return s_driver->isMinimized(hWindow);
   }
