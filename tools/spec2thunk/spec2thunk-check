#!/usr/bin/env python3
"""
spec2thunk-check -- independently verify a generated AMD64 thunk PE.

This parses the finished file from raw bytes with its own minimal PE reader.
It shares NO code with the generator and trusts nothing the generator claims.

In particular the signature descriptors are RE-DERIVED HERE by a completely
different mechanism from the one that produced them: the generator drives
clang (JSON AST + a compiled _Static_assert probe) over Wine's real headers;
this checker does a plain regex scan of the header TEXT.  Two unrelated
readings of the same headers having to agree is the point -- a shared helper
module would have made the cross-check worthless.

VARIADICS.  Version 7 added signs_rva, one bit per argument saying that a
sub-word argument is SIGNED and must be sign-extended rather than zero-
extended.  Version 6 added widths_rva, one two-bits-per-argument width word
per export -- the narrow mask says only "narrower than eight bytes", and a
WORD or a BYTE argument has to be narrowed to ITS width or the caller's stale
upper bits reach native code.  __wine_thunk_info version 5 added fp_rva, one floating-point
descriptor per export: which arguments are float or double, which of those are
single precision, and what the return is.  MS-x64 indexes its FP argument
registers by position and ELFv2 indexes its by order, so neither side can
derive that from the arity.

Version 4 added impl_names_rva: the name the
host resolves in the NATIVE module.  For a true `...` variadic that is the
function's v-variant (printf -> vprintf); otherwise it is the export's own
name, UNLESS the .thunks file redirected it -- GUEST-IMPL to a named wrapper,
GUEST-REFUSE to the shared __wine_com_refuse -- which ride this same field.
This checker re-derives that pairing the same independent way it re-derives
everything else -- a regex scan of the header TEXT -- and requires:

  * descriptor bit 9 set  <=>  Wine's headers declare the export variadic;
  * bits 0..7 == the number of FIXED arguments (the `...` is not counted);
  * an impl name that is a readable ASCII string, non-empty, and equal to
    exactly what the export is entitled to: the v-variant when bit 9 is set,
    the redirect the .thunks file asked for when it asked for one, and the
    export's own name otherwise;
  * the impl to be declared, NON-variadic, and to take exactly nfixed+1
    arguments -- va_list is one ordinary pointer parameter;
  * every redirect TARGET to be a real function export of the module's own
    .spec, so the guest's call reaches the wrapper instead of faulting.

Prints PASS/FAIL per property; exits nonzero if anything FAILed.
"""

import argparse
import bisect
import os
import re
import struct
import sys

STRIDE = 16
INFO_VERSION = 8
INFO_FIELDS = 12                # version..geom32_rva
DESC_VOID = 0x100               # bit 8
DESC_VARIADIC = 0x200           # bit 9
DESC_RESERVED = 0x0000fc00      # bits 10..15, must be zero
DESC_NARROW_SHIFT = 16         # bits 16..31: argument i is a 32-bit slot
# Byte offset of the trapping instruction inside a stub, per body mode.
# trap mode prefixes `mov r10, rcx` (49 89 ca) because x86-64 SYSCALL
# architecturally overwrites RCX -- which is MS-x64 argument 0 -- with RIP+2.
TRAP_OFF = {'direct': 0, 'trap': 3}
TRAP_INSN = b'\x0f\x05'
BUILTIN_SIG = b"Wine builtin DLL\x00"
SIG_OFF = 0x40
# The one native symbol every GUEST-REFUSE export is redirected to.  Spelled
# out here rather than imported from the generator, like every other constant
# in this file: the two sides agreeing is the check.
COM_REFUSE_IMPL = '__wine_com_refuse'

IMAGE_FILE_RELOCS_STRIPPED = 0x0001
IMAGE_FILE_DLL = 0x2000
IMAGE_SCN_CNT_CODE = 0x00000020
IMAGE_SCN_MEM_EXECUTE = 0x20000000
IMAGE_SCN_MEM_WRITE = 0x80000000
DIR_EXPORT = 0
DIR_BASERELOC = 5

DEFAULT_WINE_SOURCE = \
    '~/Development/powerpc64le-ports/hangover-ppc64le/wine-upstream'
DEFAULT_WINE_INCLUDE = DEFAULT_WINE_SOURCE + '/include'


class Fail(Exception):
    pass


class Report:
    def __init__(self):
        self.bad = 0
        self.n = 0

    def check(self, ok, label, detail=''):
        self.n += 1
        if not ok:
            self.bad += 1
        print("%-4s %-58s %s" % ('PASS' if ok else 'FAIL', label, detail))
        return ok

    def note(self, label, detail=''):
        print("%-4s %-58s %s" % ('info', label, detail))


# ---------------------------------------------------------------- PE reader

class PE:
    def __init__(self, path):
        with open(path, 'rb') as f:
            self.d = f.read()
        d = self.d
        if d[:2] != b'MZ':
            raise Fail('no MZ magic')
        self.e_lfanew = struct.unpack_from('<I', d, 0x3c)[0]
        p = self.e_lfanew
        if d[p:p + 4] != b'PE\0\0':
            raise Fail('no PE signature at e_lfanew=0x%x' % p)
        (self.machine, self.nsections, _, _, _,
         self.size_opt, self.characteristics) = struct.unpack_from('<HHIIIHH', d, p + 4)
        o = p + 24                                  # optional header
        self.opt_magic = struct.unpack_from('<H', d, o)[0]
        self.entry = struct.unpack_from('<I', d, o + 16)[0]
        if self.opt_magic == 0x20b:
            self.image_base = struct.unpack_from('<Q', d, o + 24)[0]
            self.nrva = struct.unpack_from('<I', d, o + 108)[0]
            dd = o + 112
        else:
            self.image_base = struct.unpack_from('<I', d, o + 28)[0]
            self.nrva = struct.unpack_from('<I', d, o + 92)[0]
            dd = o + 96
        self.dirs = [struct.unpack_from('<II', d, dd + 8 * i) for i in range(self.nrva)]
        self.sections = []
        s = p + 24 + self.size_opt
        for i in range(self.nsections):
            raw = d[s + 40 * i: s + 40 * (i + 1)]
            name = raw[:8].rstrip(b'\0').decode('latin1')
            vsize, vaddr, rsize, raddr = struct.unpack_from('<IIII', raw, 8)
            flags = struct.unpack_from('<I', raw, 36)[0]
            self.sections.append(dict(name=name, vsize=vsize, vaddr=vaddr,
                                      rsize=rsize, raddr=raddr, flags=flags))

    def dir(self, i):
        return self.dirs[i] if i < len(self.dirs) else (0, 0)

    def section_of(self, rva):
        for s in self.sections:
            if s['vaddr'] <= rva < s['vaddr'] + max(s['vsize'], s['rsize']):
                return s
        return None

    def off(self, rva):
        s = self.section_of(rva)
        if s is None:
            raise Fail('RVA 0x%x is not in any section' % rva)
        o = s['raddr'] + (rva - s['vaddr'])
        if o >= len(self.d):
            raise Fail('RVA 0x%x maps past EOF' % rva)
        return o

    def read(self, rva, n):
        o = self.off(rva)
        b = self.d[o:o + n]
        if len(b) != n:
            raise Fail('short read at RVA 0x%x' % rva)
        return b

    def u32(self, rva):
        return struct.unpack_from('<I', self.read(rva, 4))[0]

    def cstr(self, rva):
        o = self.off(rva)
        e = self.d.index(b'\0', o)
        return self.d[o:e].decode('latin1')

    def exports(self):
        va, sz = self.dir(DIR_EXPORT)
        if not va:
            raise Fail('no export directory')
        hdr = self.read(va, 40)
        (_, _, _, _, name_rva, _ordbase, naddr, nnames,
         addr_rva, names_rva, ords_rva) = struct.unpack_from('<IIHHIIIIIII', hdr, 0)
        eat = [self.u32(addr_rva + 4 * i) for i in range(naddr)]
        out = {}
        for i in range(nnames):
            nm = self.cstr(self.u32(names_rva + 4 * i))
            ordi = struct.unpack_from('<H', self.read(ords_rva + 2 * i, 2))[0]
            out[nm] = eat[ordi]
        return self.cstr(name_rva), out, (va, sz)


# ------------------------------------------- independent header text scanner

DECORATORS = {'extern', 'static', 'inline', 'FORCEINLINE', 'const', 'struct',
              'DECLSPEC_NORETURN', 'DECLSPEC_HOTPATCH', '__declspec(dllimport)'}
# Calling-convention token that sits between the return type and the name.
# CDECL is Wine's own spelling of __cdecl (include/minwindef.h:160) and is what
# the wine_get_*_file_name extensions in winbase.h use:
#
#     extern char * CDECL wine_get_unix_file_name( const WCHAR * ) ...
#
# Leaving it out of this alternation made check 11c report those as "no
# declaration in Wine headers" when winbase.h declares both -- a scanner blind
# spot, not a missing declaration.  \b on each side so a longer identifier that
# merely ENDS in a convention name (X__cdecl, MY_CDECL) cannot be split into a
# bogus return-type / convention pair.
#
# The __RPC_* family is the same omission, found by combase: every RPC
# user-marshal quadruple widl emits is spelled with it --
#
#     unsigned char * __RPC_USER HWND_UserMarshal(ULONG *, unsigned char *, HWND *);
#
# and ole32/oleaut32/combase export forty of them (HWND, HGLOBAL, HBITMAP,
# HMENU, HDC, HICON, HACCEL, HPALETTE, CLIPFORMAT, LPSAFEARRAY, ...), so 11c
# reported the whole family as undeclared.  All four are `#define ...
# __stdcall` in include/rpc.h:37-40 -- ordinary convention tokens, listed here
# by name rather than exempted, so their arity and return type keep being
# re-derived from the header text like every other export's.
CONV_TOKENS = ('WINAPI', 'APIENTRY', 'WINAPIV', 'CALLBACK', 'CDECL',
               '__cdecl', '__stdcall', '__clrcall', '__fastcall',
               '__RPC_USER', '__RPC_STUB', '__RPC_API', 'RPC_ENTRY')
CONV = r'\b(?:' + '|'.join(CONV_TOKENS) + r')\b'

# A THIRD declaration mechanism, and the one uxtheme uses for every export it
# has: a header-private macro that carries the WHOLE declaration prefix --
# return type and convention together -- so the declaration text contains no
# convention token at all and no return type either:
#
#     include/basetyps.h:31   #define STDAPICALLTYPE  WINAPI
#     include/basetyps.h:33   #define STDAPI          EXTERN_C HRESULT STDAPICALLTYPE
#     include/basetyps.h:34   #define STDAPI_(type)   EXTERN_C type STDAPICALLTYPE
#     include/uxtheme.h:28    #define THEMEAPI        STDAPI
#     include/uxtheme.h:29    #define THEMEAPI_(type) STDAPI_(type)
#     include/uxtheme.h:38    THEMEAPI CloseThemeData(HTHEME hTheme);
#
# `CloseThemeData` is declared there, plainly, and the scan could not see it:
# 11c reported all 69 of uxtheme's exports as undeclared the moment that
# module had any exports to check.  Same blind-spot class as the missing CDECL
# spelling and the static-inline forwarders above, one level further out.
#
# These are found by TRANSITIVE CLOSURE over the headers' own object-like and
# function-like defines, seeded with CONV_TOKENS: a macro whose body mentions
# a convention token, or a macro already known to, introduces a declaration.
# Nothing is hard-coded per module, and nothing is EXPANDED -- the macro is
# recognised as the prefix and the arity and return type still come from the
# text after it, exactly as everywhere else.  A `TYPE_(type)` form carries its
# return type in its own argument, which is why the two forms are kept apart.
CONV_MACRO_RE = re.compile(
    r'^[ \t]*#[ \t]*define[ \t]+(?P<name>[A-Za-z_][A-Za-z_0-9]*)'
    r'(?P<fn>\([^()\n]*\))?[ \t]+(?P<body>[^\n]+)$', re.MULTILINE)

# Tokens that may sit in such a macro's expansion without making it a
# declaration prefix: linkage and storage noise, never a return type.
NO_OP_DECORATIONS = frozenset((
    'EXTERN_C', 'extern', 'C', 'DECLSPEC_IMPORT', 'DECLSPEC_EXPORT',
    'DECLSPEC_HIDDEN', 'DECLSPEC_NORETURN', 'DECLSPEC_HOTPATCH',
    '__declspec', 'dllimport', 'dllexport', 'inline', '__inline'))


def strip_comments(text):
    """Blank comments out WITHOUT changing the line numbering -- the cited
    header:line has to survive this, so newlines inside a block comment are
    preserved rather than collapsed."""
    text = re.sub(r'/\*.*?\*/',
                  lambda m: '\n' * m.group(0).count('\n') or ' ',
                  text, flags=re.DOTALL)
    return re.sub(r'//[^\n]*', ' ', text)


def split_top(text):
    out, depth, cur = [], 0, ''
    for ch in text:
        if ch in '([':
            depth += 1
        elif ch in ')]':
            depth -= 1
        if ch == ',' and depth == 0:
            out.append(cur.strip())
            cur = ''
        else:
            cur += ch
    if cur.strip():
        out.append(cur.strip())
    return out


def clean_ret(spelling):
    """Drop API-export macros and storage class from a return spelling."""
    toks = [t for t in spelling.replace('*', ' * ').split() if t]
    keep = [t for t in toks
            if t not in DECORATORS and not re.fullmatch(r'[A-Z][A-Z0-9_]*API', t)
            and not re.fullmatch(r'DECLSPEC_[A-Z_]+', t)
            # CRT import decoration: _ACRTIMP, _ACRTIMP_ALT, _CRTIMP, _SECIMP.
            # Without this every include/msvcrt declaration reads as returning
            # "_ACRTIMP void" and so is scored as NON-void.
            and not re.fullmatch(r'_[A-Z][A-Z0-9_]*IMP(_ALT)?', t)]
    return ' '.join(keep).replace(' *', '*')


def dll_is_ucrt(dll):
    """Does <dll>'s own CRT mode define _UCRT?

    Mirrors the generator's crt_defines_for_dll (wine_sig.py), which mirrors
    tools/makedep.c:get_crt_define(): ucrt* gets -D_UCRT; msvcr%u gets
    -D_MSVCR_VER=<N> ("msvcrt" parses as 0); everything else gets nothing --
    and include/msvcrt/corecrt.h:48 then defaults _MSVCR_VER to 140, which
    :52 turns into _UCRT.  So only msvcrt itself and msvcr<N<140> are
    non-UCRT.  The checker needs the same verdict INDEPENDENTLY because
    Wine's CRT headers declare a few names with different shapes per mode
    (wcstok: 3 args under _UCRT, 2 without), and a mode-blind scan reads
    that as a self-inconsistent header (a false 11d).
    """
    stem = os.path.splitext(os.path.basename(dll or ''))[0].lower()
    if stem.startswith('ucrt'):
        return True
    m = re.fullmatch(r'msvcr(\d*|t)', stem)
    if m:
        ver = m.group(1)
        return ver not in ('', 't') and int(ver) >= 140
    return True


# #if/#ifdef/#elif spellings of the _UCRT test this masker understands.
# Anything else is an UNKNOWN condition and stays transparent (both branches
# scanned), which is exactly the pre-masking behaviour.
_UCRT_TEST = re.compile(r'^(?P<neg>!\s*)?defined\s*[\s(]\s*_UCRT\s*\)?$')


def _ucrt_cond(kw, rest, ucrt):
    """-> True/False when the directive tests exactly _UCRT, else None."""
    rest = rest.strip()
    if kw == 'ifdef':
        return ucrt if rest == '_UCRT' else None
    if kw == 'ifndef':
        return (not ucrt) if rest == '_UCRT' else None
    m = _UCRT_TEST.match(rest)          # kw is 'if' or 'elif'
    if not m:
        return None
    return (not ucrt) if m.group('neg') else ucrt


def mask_ucrt(text, ucrt):
    """Blank the #if[def] _UCRT branches the module's CRT mode excludes,
    preserving line numbers.

    The scan is otherwise preprocessor-blind, and for one symbol that is not
    good enough: corecrt_wstring.h declares wcstok with 3 arguments under
    `#ifdef _UCRT` and 2 arguments under the matching #else, so a blind scan
    of a real header reports a conflict that no actual compile ever sees.
    Only conditions that test exactly _UCRT are evaluated; every other
    condition (including #elif arms whose OWN test is a definite _UCRT no)
    is handled conservatively -- when in doubt, the region stays visible,
    which is the old behaviour.
    """
    out = []
    # per open #if: [visible_now, taken] with taken True (a branch definitely
    # ran), False (definitely none yet), None (unknowable from here)
    stack = []
    for line in text.split('\n'):
        m = re.match(r'\s*#\s*(if|ifdef|ifndef|elif|else|endif)\b(.*)', line)
        if m:
            kw, rest = m.group(1), m.group(2)
            if kw in ('if', 'ifdef', 'ifndef'):
                c = _ucrt_cond(kw, rest, ucrt)
                stack.append([c is not False, c])
            elif kw == 'elif' and stack:
                c = _ucrt_cond('elif', rest, ucrt)
                taken = stack[-1][1]
                stack[-1][0] = (taken is not True) and (c is not False)
                if taken is False:
                    stack[-1][1] = c
                elif taken is None and c is True:
                    stack[-1][1] = None   # taken earlier?  unknowable
            elif kw == 'else' and stack:
                stack[-1][0] = stack[-1][1] is not True
                stack[-1][1] = True
            elif kw == 'endif' and stack:
                stack.pop()
            out.append('')                # directives carry no declarations
            continue
        out.append(line if all(fr[0] for fr in stack) else '')
    return '\n'.join(out)


class HeaderScan:
    """Regex scan of Wine's header TEXT. Deliberately not the generator's method."""

    # Subdirectories of include/ that hold declarations a thunk spec may cite.
    # NOT a full walk: include/ddk and include/wine are private/driver headers
    # that redeclare Win32 names with different shapes, and pulling them in
    # would manufacture bogus 11d conflicts.  msvcrt/ is where the CRT lives
    # and is the only one a ucrtbase spec needs -- including msvcrt/sys/,
    # where the _stat/_fstat/_wstat family is declared (sys/stat.h); leaving
    # sys/ out made 11c report the whole family as undeclared.
    SUBDIRS = ('msvcrt', 'msvcrt/sys')

    def __init__(self, include_dir, ucrt=True):
        self.dir = os.path.abspath(os.path.expanduser(include_dir))
        self.ucrt = ucrt
        # paths relative to self.dir, so "msvcrt/corecrt_startup.h"
        files = [f for f in os.listdir(self.dir) if f.endswith('.h')]
        for sub in self.SUBDIRS:
            d = os.path.join(self.dir, sub)
            if not os.path.isdir(d):
                continue
            files += [os.path.join(sub, f) for f in os.listdir(d)
                      if f.endswith('.h')]
        self.files = sorted(files)

    # An object-like rename is a real declaration mechanism in Wine's CRT
    # headers, and a plain text scan is blind to it:
    #
    #     include/msvcrt/corecrt_startup.h:53   #define _set_app_type __set_app_type
    #     include/msvcrt/corecrt_startup.h:70   _ACRTIMP void __cdecl _set_app_type(_crt_app_type);
    #
    # After preprocessing, line 70 declares __set_app_type -- which is what
    # msvcrt.dll actually exports and what clang reports (at line 70, the
    # macro's expansion location).  The token `__set_app_type` never appears in
    # front of a `(` anywhere, so without this the scan reported "no
    # declaration in Wine headers" for a name Wine does declare: a scanner
    # blind spot, the same class as the missing CDECL token in CONV above.
    ALIAS_RE = re.compile(r'^[ \t]*#[ \t]*define[ \t]+'
                          r'(?P<alias>[A-Za-z_][A-Za-z_0-9]*)[ \t]+'
                          r'(?P<real>[A-Za-z_][A-Za-z_0-9]*)[ \t]*$',
                          re.MULTILINE)

    def _aliases(self, names):
        """-> {alias_token: real_export_name} for `#define ALIAS REAL` renames.

        Only renames whose TARGET is an export we were asked about are
        collected, so this cannot invent hits for anything else, and a spec
        that names no macro-renamed export gets an empty map and byte-identical
        behaviour to before.
        """
        want, out = set(names), {}
        for relpath in self.files:
            p = os.path.join(self.dir, relpath)
            try:
                with open(p, errors='replace') as fh:
                    raw = fh.read()
            except OSError:
                continue
            if not any(n in raw for n in want):
                continue
            for m in self.ALIAS_RE.finditer(mask_ucrt(strip_comments(raw),
                                                      self.ucrt)):
                alias, real = m.group('alias'), m.group('real')
                if real in want and alias != real and alias not in want:
                    out[alias] = real
        return out

    def _conv_macros(self):
        """-> (convention-only, declaration-prefix, declaration-prefix(type))
        macro names.  See CONV_MACRO_RE for what these are and why.

        The three classes are not interchangeable and telling them apart is the
        whole job, because they say different things about where the RETURN
        TYPE is:

          * convention-only -- `#define WINGDIPAPI __stdcall`.  Every token in
            its expansion is a convention or a no-op decoration, so it behaves
            exactly like WINAPI: the return type is the text in front of it
            (`void WINGDIPAPI GdipFree(void*)` returns void, and reading that
            as non-void is a real, silent descriptor mismatch).
          * declaration-prefix -- `#define STDAPI EXTERN_C HRESULT
            STDAPICALLTYPE`, and `#define THEMEAPI STDAPI` after it.  The
            expansion contains a TYPE, so the return type is INSIDE the macro
            and there is nothing in front of it to read.
          * declaration-prefix with the type as its argument --
            `#define THEMEAPI_(type) STDAPI_(type)`.  The macro's own argument
            is the return type, which is the only thing that tells
            `THEMEAPI_(void) SetThemeAppProperties` from its 68 siblings.

        A macro is convention-only until something in its expansion is neither
        a convention, a decoration, nor another convention-only macro.
        """
        if getattr(self, '_conv_cache', None) is not None:
            return self._conv_cache
        conv, decl, declfn, bodies = set(), set(), set(), {}
        for relpath in self.files:
            try:
                with open(os.path.join(self.dir, relpath), errors='replace') as fh:
                    raw = fh.read()
            except OSError:
                continue
            for m in CONV_MACRO_RE.finditer(strip_comments(raw)):
                bodies.setdefault(m.group('name'),
                                  (bool(m.group('fn')), set()))[1].update(
                    re.findall(r'[A-Za-z_][A-Za-z_0-9]*', m.group('body')))
        base = set(CONV_TOKENS)
        known = set(base)
        changed = True
        while changed:                      # transitive: THEMEAPI -> STDAPI -> WINAPI
            changed = False
            for name, (is_fn, toks) in bodies.items():
                if name in known or not (toks & known):
                    continue
                known.add(name)
                if is_fn or (toks & decl) or (toks - base - conv - NO_OP_DECORATIONS):
                    (declfn if is_fn else decl).add(name)
                else:
                    conv.add(name)
                changed = True
        self._conv_cache = (sorted(conv - base), sorted(decl - base),
                            sorted(declfn - base))
        return self._conv_cache

    def find(self, names):
        """-> {name: [ {file,line,nargs,ret,void,variadic}, ... ]}"""
        alias = self._aliases(names)
        tokens = list(names) + sorted(alias)
        namealt = '|'.join(re.escape(n) for n in tokens)
        # A convention-only macro IS a convention token (see _conv_macros), so
        # it belongs in this alternation and not in a pattern of its own: the
        # return type still comes from the text in front of it.
        cconv, cdecl, cdeclfn = self._conv_macros()
        convalt = (r'\b(?:' + '|'.join(list(CONV_TOKENS)
                                       + [re.escape(n) for n in cconv]) + r')\b')
        pat = re.compile(
            r'(?P<ret>[A-Za-z_][A-Za-z_0-9 \t\*\(\)]*?)\s*' + convalt +
            r'\s+(?P<name>' + namealt + r')\s*\(')
        # The declaration-PREFIX macros, in their two forms.  `THEMEAPI Foo(...)`
        # leaves no return type in the text at all, and the empty `ret` reads
        # as non-void -- which is right: a prefix of this kind carries a fixed
        # value return (STDAPI's is HRESULT), and one that returned void would
        # be spelled with the argument form below.  `THEMEAPI_(COLORREF)
        # Foo(...)` carries its return type in the macro's own argument, so
        # that argument IS the return type, and reading it is what tells
        # `THEMEAPI_(void) SetThemeAppProperties` from its 68 siblings.
        cpats = []
        if cdecl:
            cpats.append(re.compile(
                r'(?P<ret>)\b(?:' + '|'.join(map(re.escape, cdecl)) + r')\b'
                r'\s+(?P<name>' + namealt + r')\s*\('))
        if cdeclfn:
            cpats.append(re.compile(
                r'\b(?:' + '|'.join(map(re.escape, cdeclfn)) + r')\b'
                r'[ \t]*\((?P<ret>[^()\n]*)\)'
                r'\s+(?P<name>' + namealt + r')\s*\('))
        # The CRT headers' second declaration mechanism: a static inline
        # forwarder with NO calling-convention token at all --
        #     static inline time_t time(time_t *t) { return _time64(t); }
        # (include/msvcrt/time.h).  The pattern above requires a convention
        # token, so every such name (time, ctime, strtoll, the sys/stat.h
        # fstat/stat wrappers) read as "no declaration in Wine headers": a
        # scanner blind spot, the same class as the missing CDECL spelling
        # documented at CONV.  The optional convention keeps declarations
        # spelled `static inline ... __cdecl strtoull(...)` from yielding a
        # second, differently-spelled return type; position-dedup below
        # keeps them from counting twice at all.
        ipat = re.compile(
            r'\bstatic\s+(?:__)?(?:inline|FORCEINLINE)\s+'
            r'(?P<ret>[A-Za-z_][A-Za-z_0-9 \t\*]*?)\s*(?:' + CONV + r'\s+)?'
            # the ret separator can be empty (`char* ctime`), so without this
            # boundary the name group could match a mere SUFFIX of a longer
            # identifier -- `exit` inside `onexit`, `printf` inside `swprintf`
            r'(?<![A-Za-z_0-9])(?P<name>' + namealt + r')\s*\(')
        found = {n: [] for n in names}
        for relpath in self.files:
            fn = os.path.basename(relpath)   # spec files cite the basename
            p = os.path.join(self.dir, relpath)
            try:
                with open(p, errors='replace') as fh:
                    raw = fh.read()
            except OSError:
                continue
            if not any(n in raw for n in tokens):
                continue
            stripped = strip_comments(raw)
            text = mask_ucrt(stripped, self.ucrt)
            # Line numbers of every preprocessor directive, taken BEFORE
            # mask_ucrt() blanks them -- it preserves line numbering, so these
            # index `text` just as well.  See `cond` below for what they are
            # for.
            directives = sorted(i for i, ln in
                                enumerate(stripped.split('\n'), 1)
                                if re.match(r'[ \t]*#', ln))
            seen = set()
            hits_here = list(pat.finditer(text)) + list(ipat.finditer(text))
            for cp in cpats:
                hits_here += list(cp.finditer(text))
            for m in hits_here:
                if m.start('name') in seen:
                    continue
                # A C++ MEMBER FUNCTION is not a DLL export of that name, and
                # recognising STDMETHODCALLTYPE as a convention (which it is:
                # `#define STDMETHODCALLTYPE __stdcall`) makes every COM
                # interface method in the generated headers look like one.
                # msxml/mshtml/wmp declare `virtual HRESULT STDMETHODCALLTYPE
                # abort(void) = 0;` and `... remove(VARIANT,VARIANT)`, which
                # collided with msvcrt's C `abort` and `remove` and reported
                # them as inconsistently declared.  `virtual` is the token that
                # says member function, and no C export ever carries it.
                if re.search(r'\bvirtual\b', m.group('ret')):
                    continue
                seen.add(m.start('name'))
                depth, j = 1, m.end()
                while j < len(text) and depth:
                    if text[j] == '(':
                        depth += 1
                    elif text[j] == ')':
                        depth -= 1
                    j += 1
                inner = text[m.end():j - 1]
                args = split_top(inner)
                if len(args) == 1 and args[0].strip() in ('void', 'VOID', ''):
                    args = []
                ret = clean_ret(m.group('ret'))
                tok = m.group('name')
                # A PARAMETER LIST WITH A PREPROCESSOR DIRECTIVE IN IT is not
                # countable by a text scan, and pretending otherwise produces a
                # confident wrong answer rather than no answer.
                # include/iphlpapi.h:103 declares GetBestInterfaceEx with its
                # first parameter spelled two ways inside an #ifdef/#else;
                # mask_ucrt() leaves both branches visible (its condition is
                # not about _UCRT), so the two spellings read as two separate
                # parameters and the scan says three arguments where the
                # compiler, the .spec and the generator all say two.  The
                # scanner's whole value is being an INDEPENDENT reading: a
                # blind spot it announces costs nothing, one it reports as a
                # mismatch costs the next reader an afternoon.
                open_line = text[:m.end()].count('\n') + 1
                close_line = text[:j].count('\n') + 1
                lo = bisect.bisect_left(directives, open_line)
                cond = lo < len(directives) and directives[lo] <= close_line
                found[alias.get(tok, tok)].append(dict(
                    file=fn, line=text[:m.start('name')].count('\n') + 1,
                    nargs=len(args), ret=ret, void=(ret in ('void', 'VOID')),
                    variadic=any(a.strip() == '...' for a in args),
                    cond=cond, via=(tok if tok in alias else None)))
        return found


class WineSpecList:
    """Independent re-derivation of the ELIGIBLE export list of a Wine .spec.

    The generator can now take its list from the module's own .spec instead of
    a hand-written .thunks file.  That list is a claim like any other, so this
    re-derives it here from the .spec TEXT, with its own parser, and requires
    the image's names to be a SUBSEQUENCE of it -- same relative order, nothing
    invented, nothing reordered.

    WHAT THIS DELIBERATELY DOES NOT DO: decide which eligible export SHOULD have
    been emitted.  That verdict is clang's, on Wine's real headers, and a regex
    scanner re-deriving it would be guessing -- exactly what the generator's
    docstring forbids.  So an export present in the .spec and absent from the
    image is reported, with a count, and is a FAIL only under --require-complete.
    Everything the image DOES assert is still re-derived here in full.
    """

    # tools/winebuild/build.h FLAG_CPU_WIN32 / FLAG_CPU_WIN64, and
    # tools/tools.h get_cpu_from_name(), which matches by PREFIX.
    CPU_NAMES = (('i386', 'i386'), ('i486', 'i386'), ('i586', 'i386'),
                 ('i686', 'i386'), ('i786', 'i386'), ('x86_64', 'x86_64'),
                 ('amd64', 'x86_64'), ('aarch64', 'arm64'),
                 ('arm64ec', 'arm64ec'), ('arm64', 'arm64'), ('arm', 'arm'),
                 ('ppc64', 'powerpc64'), ('powerpc64', 'powerpc64'))
    WIN32 = frozenset(('i386', 'arm'))
    WIN64 = frozenset(('x86_64', 'arm64', 'arm64ec', 'powerpc64'))
    FUNC_TYPES = frozenset(('stdcall', 'cdecl', 'varargs', 'thiscall',
                            'fastcall'))
    LINE_RE = re.compile(r'^\s*(?:@|\d+)\s+(?P<type>\w+)\s+'
                         r'(?P<flags>(?:-\S+\s+)*)'
                         r'(?P<name>@|[A-Za-z_][\w.]*)\s*'
                         r'(?:\((?P<args>[^)]*)\))?')

    def __init__(self, path, cpu='x86_64'):
        self.path = os.path.abspath(os.path.expanduser(path))
        self.cpu = cpu

    def _cpus(self, flags):
        cpus, mask = set(), set()
        for f in flags:
            if f == '-i386':
                cpus.add('i386')
            elif f.startswith('-arch='):
                for tok in f[len('-arch='):].split(','):
                    if tok == 'win32':
                        cpus |= self.WIN32
                    elif tok == 'win64':
                        cpus |= self.WIN64
                    else:
                        neg = tok.startswith('!')
                        bare = tok[1:] if neg else tok
                        for prefix, cpu in self.CPU_NAMES:
                            if bare.startswith(prefix):
                                (mask if neg else cpus).add(cpu)
                                break
                        else:
                            raise Fail('%s: unknown architecture %r'
                                       % (self.path, tok))
        if 'x86_64' in cpus:
            cpus.add('arm64ec')
        if 'x86_64' in mask:
            mask.add('arm64ec')
        if mask:
            cpus |= (self.WIN32 | self.WIN64) - mask
        return cpus or None

    def eligible(self):
        """-> [dict(name, nargs, line), ...] in .spec order."""
        out = []
        with open(self.path, errors='replace') as fh:
            for lineno, raw in enumerate(fh, 1):
                line = raw.split('#', 1)[0].rstrip()
                if not line.strip():
                    continue
                m = self.LINE_RE.match(line)
                if not m or m.group('type') not in self.FUNC_TYPES:
                    continue
                flags = m.group('flags').split()
                if '-noname' in flags or '-register' in flags:
                    continue
                name = m.group('name')
                if name == '@':
                    continue
                cpus = self._cpus(flags)
                if cpus is not None and self.cpu not in cpus:
                    continue
                out.append(dict(name=name, line=lineno,
                                nargs=len((m.group('args') or '').split())))
        if not out:
            raise Fail('%s: no eligible export lines' % self.path)
        return out


class SpecScan:
    """Independent re-reading of a cited Wine .spec line.

    Only for the handful of exports Wine declares in NO header (kernel32's
    delay-load entry points), which the thunk spec cites as
    '<name>.spec:<line>'.  A .spec pins the ARITY and the argument classes and
    nothing else -- no return type at all -- so this can confirm the argument
    count in the descriptor but CANNOT confirm the void bit.  Entries checked
    this way are reported as such rather than silently counted as verified.
    """

    NON_SLOT = ('double', 'float', 'int128')

    def __init__(self, source_root):
        self.root = os.path.abspath(os.path.expanduser(source_root))

    def arity(self, name, specname, lineno):
        """-> (nargs, detail) or raises Fail."""
        import glob
        hits = glob.glob(os.path.join(self.root, 'dlls', '*', specname))
        if os.path.isfile(os.path.join(self.root, specname)):
            hits = [os.path.join(self.root, specname)]
        if len(hits) != 1:
            raise Fail('%s: %d candidates under %s/dlls'
                       % (specname, len(hits), self.root))
        with open(hits[0], errors='replace') as fh:
            lines = fh.readlines()
        if not (1 <= lineno <= len(lines)):
            raise Fail('%s has no line %d' % (specname, lineno))
        raw = lines[lineno - 1].split('#', 1)[0].strip()
        m = re.match(r'^@\s+\w+\s+(?:-\S+\s+)*(?P<name>[A-Za-z_][\w@.]*)\s*'
                     r'\((?P<args>[^)]*)\)', raw)
        if not m:
            raise Fail('%s:%d is not a parsable export line: %r'
                       % (specname, lineno, raw[:80]))
        if m.group('name') != name:
            raise Fail('%s:%d declares %r, not %r'
                       % (specname, lineno, m.group('name'), name))
        args = m.group('args').split()
        bad = [a for a in args if a in self.NON_SLOT]
        if bad:
            raise Fail('%s:%d has non-slot argument(s) %s'
                       % (specname, lineno, ', '.join(bad)))
        return len(args), '%s:%d %s(%s)' % (specname, lineno, name,
                                            ' '.join(args))


# ---------------------------------------------------------------- spec

def parse_spec(path):
    dll, exports, from_spec, excludes = None, [], None, []
    extra = dict(from_def=None, com_json=None, probe_includes=[],
                 include_dirs=[])
    with open(path) as f:
        for raw in f:
            line = raw.split('#', 1)[0].strip()
            if not line:
                continue
            parts = line.split()
            if parts[0].upper() == 'DLL':
                dll = parts[1]
                continue
            if parts[0].upper() == 'FROM-SPEC':
                from_spec = parts[1]
                continue
            if parts[0].upper() == 'FROM-DEF':
                extra['from_def'] = parts[1]
                continue
            if parts[0].upper() == 'COM-JSON':
                extra['com_json'] = parts[1]
                continue
            if parts[0].upper() == 'PROBE-INCLUDE':
                extra['probe_includes'].append(parts[1])
                continue
            if parts[0].upper() == 'PROBE-EXTRA':
                # Appends to the oracle's default translation unit rather than
                # replacing it; the checker only needs to not choke on it.
                extra.setdefault('probe_extra', []).append(parts[1])
                continue
            if parts[0].upper() == 'PROBE-DEFINE':
                # An extra -D for the generator's oracle (psapi's
                # PSAPI_VERSION=1); the checker only needs to not choke on it.
                extra.setdefault('probe_defines', []).append(parts[1])
                continue
            if parts[0].upper() == 'INCLUDE-DIR':
                extra['include_dirs'].append(parts[1])
                continue
            if parts[0].upper() == 'EXCLUDE':
                excludes.append(parts[1])
                continue
            # Flat-surface interception directives (spec2thunk §4.3): the
            # checker does not police them (spec2thunk's own build-time audit
            # does), but it must not read them as export lines.
            if parts[0].upper() in ('GUEST-IMPL', 'GUEST-REFUSE', 'GUEST-PASS'):
                extra.setdefault('guest_directives', []).append(tuple(parts))
                continue
            if len(parts) not in (5, 6):
                raise SystemExit('%s: malformed export line: %s' % (path, line))
            name, imm, nargs, retkind, loc = parts[:5]
            impl = None
            if len(parts) == 6:
                if not parts[5].startswith('variadic='):
                    raise SystemExit('%s: unknown 6th token %r on: %s'
                                     % (path, parts[5], line))
                impl = parts[5][len('variadic='):]
                if not impl:
                    raise SystemExit('%s: empty variadic= on: %s' % (path, line))
            hdr, _, ln = loc.rpartition(':')
            exports.append(dict(name=name, imm=int(imm, 0), nargs=int(nargs, 0),
                                void=(retkind == 'void'), header=hdr,
                                line=int(ln), variadic_impl=impl,
                                asserted=True))
    return dll, exports, from_spec, excludes, extra


# ------------------------------------------- independent .def / JSON readers
# COM MODE.  A COM-mode module's export list comes from the native target's
# own .def (vkd3d-proton's d3d12.def) and its stub arrays from an interfaces
# JSON.  Both are re-read here with this file's own readers -- the inputs are
# shared with the generator (they ARE the list, the way kernel32.spec is), the
# code is not.

class ModuleDefList:
    """Independent re-derivation of the export names of a .def file."""

    def __init__(self, path):
        self.path = os.path.abspath(os.path.expanduser(path))

    def eligible(self):
        names, in_exports = [], False
        with open(self.path, errors='replace') as fh:
            for lineno, raw in enumerate(fh, 1):
                line = raw.split(';', 1)[0].strip()
                if not line:
                    continue
                parts = line.split()
                key = parts[0].upper()
                if key == 'LIBRARY':
                    in_exports = False
                    continue
                if key == 'EXPORTS':
                    in_exports = True
                    parts = parts[1:]
                    if not parts:
                        continue
                elif not in_exports:
                    continue
                name = parts[0].split('=', 1)[0]
                if any(p.upper() in ('NONAME', 'DATA') for p in parts[1:]):
                    continue
                names.append(dict(name=name, line=lineno, nargs=None))
        if not names:
            raise Fail('%s: no export names' % self.path)
        return names


COM_INFO_VERSION = 1
COM_INFO_FIELDS = 5             # version, iface_count, stride, trap_off, ifaces_rva
COM_IFACE_ENTRY = 24            # GUID(16) + slot_count(4) + stubs_rva(4)


def parse_guid_text(text):
    """Own reader: 'aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee' -> the 16 bytes a
    Windows GUID struct holds (Data1/2/3 little-endian, Data4 as written)."""
    m = re.fullmatch(r'([0-9a-fA-F]{8})-([0-9a-fA-F]{4})-([0-9a-fA-F]{4})-'
                     r'([0-9a-fA-F]{4})-([0-9a-fA-F]{12})', text.strip())
    if not m:
        raise Fail('malformed uuid %r' % text)
    return (struct.pack('<IHH', int(m.group(1), 16), int(m.group(2), 16),
                        int(m.group(3), 16))
            + bytes.fromhex(m.group(4) + m.group(5)))


def load_com_json(path):
    """-> [(name, guid bytes, slot_count)], sorted by name -- the generator's
    documented order, re-derived here from the JSON with this file's reader."""
    import json
    with open(path) as f:
        d = json.load(f)
    out = []
    for name in sorted(d['interfaces']):
        i = d['interfaces'][name]
        slots = i['slots']
        got = [s['slot'] for s in slots]
        if got != list(range(len(slots))):
            raise Fail('%s: %s slot numbers are not contiguous from 0'
                       % (path, name))
        out.append((name, parse_guid_text(i['uuid']), len(slots)))
    return out


def check_com_section(r, pe, exp, com_json_path, flat_count, flat_stubs_rva):
    """The COM-mode invariants, against the image bytes alone."""
    want = load_com_json(com_json_path)
    r.note('com json', '%s: %d interface(s), %d slot(s)'
           % (os.path.basename(com_json_path), len(want),
              sum(n for _, _, n in want)))

    info_rva = exp.get('__wine_com_thunk_info')
    if not r.check(bool(info_rva), 'c1 __wine_com_thunk_info exported by name',
                   '0x%08x' % (info_rva or 0)):
        return
    try:
        fields = struct.unpack_from('<%dI' % COM_INFO_FIELDS,
                                    pe.read(info_rva, 4 * COM_INFO_FIELDS))
    except Fail as e:
        r.check(False, 'c1b __wine_com_thunk_info readable', str(e))
        return
    version, iface_count, stride, trap_off, ifaces_rva = fields
    r.note('__wine_com_thunk_info',
           'ver=%d iface_count=%d stride=%d trap_off=%d ifaces_rva=0x%x'
           % fields)
    r.check(version == COM_INFO_VERSION,
            'c2 com info version == %d' % COM_INFO_VERSION, str(version))
    r.check(stride == STRIDE, 'c3 com stride == 16', str(stride))
    r.check(trap_off == TRAP_OFF['trap'],
            'c4 com trap_off == 3 (mov r10,rcx before the trap)', str(trap_off))
    r.check(iface_count == len(want),
            'c5 iface_count matches the interfaces JSON',
            '%d vs %d' % (iface_count, len(want)))
    for tag, rva in (('__wine_com_thunk_info', info_rva),
                     ('ifaces_rva', ifaces_rva)):
        s = pe.section_of(rva)
        r.check(s is not None and not (s['flags'] & IMAGE_SCN_MEM_WRITE),
                'c6 %s is in a non-writable section' % tag,
                ('%s flags=0x%08x' % (s['name'], s['flags'])) if s else 'none')
    if iface_count != len(want):
        return

    entries = []
    try:
        for i in range(iface_count):
            raw = pe.read(ifaces_rva + i * COM_IFACE_ENTRY, COM_IFACE_ENTRY)
            iid = raw[:16]
            slot_count, stubs_rva = struct.unpack_from('<II', raw, 16)
            entries.append((iid, slot_count, stubs_rva))
    except Fail as e:
        r.check(False, 'c7 iface entries readable', str(e))
        return

    bad_iid = ['%s: image %s json %s' % (want[i][0], entries[i][0].hex(),
                                         want[i][1].hex())
               for i in range(iface_count) if entries[i][0] != want[i][1]]
    r.check(not bad_iid, 'c7 every IID matches the JSON, in sorted-name order',
            '; '.join(bad_iid[:4]) if bad_iid else '%d IIDs' % iface_count)
    r.check(len({e[0] for e in entries}) == iface_count,
            'c8 IIDs are unique', '%d distinct' % len({e[0] for e in entries}))
    bad_n = ['%s: image %d json %d' % (want[i][0], entries[i][1], want[i][2])
             for i in range(iface_count) if entries[i][1] != want[i][2]]
    r.check(not bad_n, 'c9 every slot_count matches the JSON',
            '; '.join(bad_n[:6]) if bad_n
            else '%d slots total' % sum(e[1] for e in entries))

    # Stub arrays: geometry, then bytes.
    sec_bad, align_bad = [], []
    regions = [(flat_stubs_rva, flat_stubs_rva + flat_count * STRIDE, '(flat)')]
    for i, (iid, slot_count, stubs_rva) in enumerate(entries):
        s = pe.section_of(stubs_rva)
        if s is None or s['name'] != '.thunk' or \
           not (s['flags'] & IMAGE_SCN_MEM_EXECUTE):
            sec_bad.append(want[i][0])
        end = stubs_rva + slot_count * STRIDE
        if s is not None and end > s['vaddr'] + max(s['vsize'], s['rsize']):
            sec_bad.append('%s (overruns .thunk)' % want[i][0])
        if stubs_rva % STRIDE:
            align_bad.append(want[i][0])
        regions.append((stubs_rva, end, want[i][0]))
    r.check(not sec_bad, 'c10 every stub array lives inside executable .thunk',
            '; '.join(sec_bad[:6]) if sec_bad else '%d arrays' % iface_count)
    r.check(not align_bad, 'c11 every stub array is 16-byte aligned',
            '; '.join(align_bad[:6]) if align_bad else '')
    regions.sort()
    overlap = ['%s/%s' % (regions[i][2], regions[i + 1][2])
               for i in range(len(regions) - 1)
               if regions[i][1] > regions[i + 1][0]]
    r.check(not overlap,
            'c12 stub arrays do not overlap each other or the flat stubs',
            '; '.join(overlap[:6]) if overlap else '%d regions' % len(regions))

    trap_body = expect_stub('trap', 0)
    body_bad, checked = [], 0
    for i, (iid, slot_count, stubs_rva) in enumerate(entries):
        try:
            raw = pe.read(stubs_rva, slot_count * STRIDE)
        except Fail as e:
            body_bad.append('%s: %s' % (want[i][0], e))
            continue
        for n in range(slot_count):
            if raw[n * STRIDE:(n + 1) * STRIDE] != trap_body:
                body_bad.append('%s slot %d: %s' % (
                    want[i][0], n, raw[n * STRIDE:(n + 1) * STRIDE].hex()))
        checked += slot_count
    r.check(not body_bad,
            'c13 every COM stub is byte-identical to the trap body',
            '; '.join(body_bad[:4]) if body_bad
            else '%d stubs verified' % checked)


# Register-contract exports carry a raw guest body instead of a trap stub;
# independent copy of the generator's RAW_BODY_EXPORTS (spec2thunk), so a
# divergence between the two shows up as a check-7 byte mismatch here.
# These names are also exempt from the header checks (11c): there is no C
# declaration to find and no call to marshal.
RAW_BODY_EXPORTS = {
    '__chkstk': b'\xc3',            # ret -- rax must survive, see spec2thunk
}


# Guest fast paths: an independent copy of the generator's FAST_PATH tables
# and of the struct emu_qpc_guest offsets in include/wine/emu_qpc.h.  Three
# spellings of one layout is one too many, and this is the copy that turns a
# divergence into a red check instead of a guest reading a garbage clock.
RESERVED_EXPORTS  = ('__wine_thunk_info', '__wine_com_thunk_info',
                     '__wine_thunk_qpc')
FAST_PATH_MODULES = ('kernel32.dll', 'kernelbase.dll', 'ntdll.dll', 'user32.dll')
FAST_PATH_EXPORTS = ('QueryPerformanceCounter', 'QueryPerformanceFrequency',
                     'GetCurrentThreadId', 'RtlEnterCriticalSection',
                     'RtlLeaveCriticalSection', 'EnterCriticalSection',
                     'LeaveCriticalSection', 'PeekMessageW')
QPC_BLOCK_EXPORT  = '__wine_thunk_qpc'
QPC_ENABLED       = 24
QPC_CS_DISABLE    = 26
QPC_BLOCK_SIZE    = 48
QPC_MAGIC         = 0x5150433150504336          # "QPC1PPC6"
FAST_BODY_MAX     = 96                          # bytes to look in for the fallback


def expect_stub(mode, imm, name=None):
    if name in RAW_BODY_EXPORTS:
        body = RAW_BODY_EXPORTS[name]
    elif mode == 'direct':
        body = b'\xb8' + struct.pack('<I', imm) + b'\xc3'
    else:
        body = b'\x49\x89\xca' + TRAP_INSN          # mov r10,rcx ; syscall
    return body + b'\xcc' * (STRIDE - len(body))


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('image')
    ap.add_argument('--spec', help='the .thunks file the image was built from')
    ap.add_argument('--from-spec', metavar='<mod>.spec',
                    help="the module's own Wine .spec, when the export list was "
                         'derived from it.  Re-parsed here by this file\'s own '
                         'reader; the image\'s names must be a subsequence of '
                         'the eligible ones.')
    ap.add_argument('--dll-name', help='expected export-directory DLL name; '
                                       'defaults to the .thunks DLL line or the '
                                       '.spec basename')
    ap.add_argument('--require-complete', action='store_true',
                    help='FAIL if the image omits any export the list has.  Off '
                         'by default: the generator legitimately refuses what '
                         "clang cannot prove is register-passable, and this "
                         'file will not second-guess that with a regex.')
    ap.add_argument('--body', choices=('direct', 'trap'), required=True)
    ap.add_argument('--image-base', default='0x180000000')
    ap.add_argument('--wine-include', default=DEFAULT_WINE_INCLUDE)
    ap.add_argument('--wine-source', default=DEFAULT_WINE_SOURCE,
                    help='Wine source root, used only to re-read a .spec line '
                         'cited by an export that no header declares')
    args = ap.parse_args()
    if not args.spec and not args.from_spec:
        ap.error('one of --spec or --from-spec is required')

    r = Report()
    print("=== checking %s (body=%s) ===" % (args.image, args.body))
    spec_dll, overrides, from_spec, excludes = None, [], None, []
    guest_impl = {}
    extra = dict(from_def=None, com_json=None, probe_includes=[],
                 include_dirs=[])
    if args.spec:
        spec_dll, overrides, from_spec, excludes, extra = parse_spec(args.spec)
        # Both of the flat-surface REDIRECTS ride impl_names_rva, the field a
        # variadic's v-variant name used to have to itself:
        #
        #   GUEST-IMPL   <Export> <NativeName>   -> that native name
        #   GUEST-REFUSE <Export> [reason]       -> the shared __wine_com_refuse
        #
        # so checks 11h/11i have to know what the .thunks file ASKED FOR rather
        # than assuming an impl name is always the export's own.  GUEST-PASS is
        # deliberately not collected: an audited pass-through is not redirected
        # at all, and leaving it out of this map is exactly what makes 11h go
        # on demanding that its impl name be its own.
        for d in extra.get('guest_directives', []):
            kind = d[0].upper()
            if kind == 'GUEST-IMPL':
                if len(d) < 3:
                    raise SystemExit('%s: GUEST-IMPL needs <Export> <NativeName>: %s'
                                     % (args.spec, ' '.join(d)))
                guest_impl[d[1]] = d[2]
            elif kind == 'GUEST-REFUSE':
                guest_impl[d[1]] = COM_REFUSE_IMPL

    def spec_relative(p):
        if os.path.isabs(p) or not args.spec:
            return p
        return os.path.join(os.path.dirname(os.path.abspath(args.spec)), p)

    if args.from_spec:
        from_spec = args.from_spec
    elif from_spec == 'auto':
        from_spec = os.path.join(os.path.dirname(os.path.abspath(args.spec)),
                                 os.path.splitext(os.path.basename(spec_dll))[0]
                                 + '.spec')
    elif from_spec and args.spec and not os.path.isabs(from_spec):
        from_spec = os.path.join(os.path.dirname(os.path.abspath(args.spec)),
                                 from_spec)

    # `listed` is the full eligible list; `spec_exports` is the subset the image
    # actually carries, in image order, each with whatever assertion columns a
    # .thunks override gave it.
    ov = {e['name']: e for e in overrides}
    if extra['from_def']:
        from_def = spec_relative(extra['from_def'])
        eligible = [e for e in ModuleDefList(from_def).eligible()
                    if e['name'] not in set(excludes)]
        listed = []
        for e in eligible:
            o = ov.get(e['name'])
            listed.append(dict(o, spec_nargs=None) if o else
                          dict(name=e['name'], imm=None, nargs=None, void=None,
                               header=None, line=None, variadic_impl=None,
                               asserted=False, spec_nargs=None))
        if not spec_dll:
            spec_dll = os.path.splitext(os.path.basename(from_def))[0] + '.dll'
    elif from_spec:
        eligible = [e for e in WineSpecList(from_spec).eligible()
                    if e['name'] not in set(excludes)]
        listed = []
        for e in eligible:
            o = ov.get(e['name'])
            listed.append(dict(o, spec_nargs=e['nargs']) if o else
                          dict(name=e['name'], imm=None, nargs=None, void=None,
                               header=None, line=None, variadic_impl=None,
                               asserted=False, spec_nargs=e['nargs']))
        if not spec_dll:
            spec_dll = os.path.splitext(os.path.basename(from_spec))[0] + '.dll'
    else:
        listed = [e for e in overrides if e['name'] not in set(excludes)]
    if args.dll_name:
        spec_dll = args.dll_name
    listed_names = [e['name'] for e in listed]

    try:
        pe = PE(args.image)
    except Fail as e:
        print("FAIL unable to parse image: %s" % e)
        return 1
    except OSError as e:
        # A missing or unreadable image is a FAIL like any other, not a
        # traceback -- this runs unattended in build/verify loops.
        print("FAIL unable to read image: %s" % e)
        return 1

    # -- 1. machine / PE32+
    r.check(pe.machine == 0x8664, '1a FileHeader.Machine == 0x8664 (AMD64)',
            '0x%04x' % pe.machine)
    r.check(pe.opt_magic == 0x20b, '1b OptionalHeader.Magic == 0x20b (PE32+)',
            '0x%04x' % pe.opt_magic)
    r.check(bool(pe.characteristics & IMAGE_FILE_DLL),
            '2  IMAGE_FILE_DLL set', 'Characteristics=0x%04x' % pe.characteristics)
    r.check(pe.entry == 0, '3  OptionalHeader.AddressOfEntryPoint == 0',
            '0x%08x' % pe.entry)

    got = pe.d[SIG_OFF:SIG_OFF + len(BUILTIN_SIG)]
    r.check(got == BUILTIN_SIG, '4a bytes[0x40..0x50] == "Wine builtin DLL\\0"',
            repr(bytes(got)))
    r.check(pe.e_lfanew > SIG_OFF + len(BUILTIN_SIG),
            '4b e_lfanew > 0x51 (signature cannot clobber PE hdr)',
            'e_lfanew=0x%x' % pe.e_lfanew)
    r.check(len(pe.d) >= 96, '4c image >= 96 bytes (sizeof mz struct)',
            '%d bytes' % len(pe.d))

    try:
        dllname, exp, (edir_va, edir_sz) = pe.exports()
    except Fail as e:
        print("FAIL export directory: %s" % e)
        return 1
    r.note('export dir', '%s, %d entries, dir=0x%x+0x%x'
           % (dllname, len(exp), edir_va, edir_sz))
    r.check(dllname.lower() == spec_dll.lower(),
            '5a export directory Name matches spec DLL name', dllname)

    # ------------------------------------------------------------------
    # WHAT THE IMAGE CARRIES vs WHAT THE LIST OFFERS.
    # ------------------------------------------------------------------
    # The generator REFUSES anything clang cannot prove is register-passable,
    # so the image is a SUBSET of the list -- 3 of user32's 5 hand-written
    # entries, and ~13% of a whole kernel32.spec.  Requiring equality (which
    # this file used to) turns every honest refusal into a FAIL and made the
    # checker unusable on exactly the runs that most need checking.
    #
    # The properties that still have to hold, and are checked here:
    #   * every name the image exports is IN the list -- nothing invented;
    #   * they appear in the list's own relative order -- nothing reordered,
    #     which is what makes "index i" mean the same thing on both sides.
    # An omission is reported and counted, and is a FAIL only under
    # --require-complete; see the WineSpecList docstring for why this file
    # does not re-derive the refusal decision itself.
    # A FAST-PATH EXPORT'S DIRECTORY RVA IS NOT ITS PLACE IN THE ARRAY.  It
    # points at the fast body, which lives past the end of the stub array, so
    # sorting the export directory by RVA would move those two names to the end
    # and slip every index-based check below by one apiece.  Its real place is
    # the slot its fallback jumps to, and that jump is in the body: take the
    # first E9 whose target is 16-byte aligned and BELOW the body, which is the
    # stub array by construction.  Everything else sorts by its own RVA exactly
    # as before.
    def order_rva( n, rva ):
        if (spec_dll or '').lower() not in FAST_PATH_MODULES: return rva
        if n not in FAST_PATH_EXPORTS: return rva
        try:
            body = pe.read(rva, FAST_BODY_MAX)
        except Fail:
            return rva
        for off in range(0, FAST_BODY_MAX - 5):
            if body[off] != 0xe9:
                continue
            tgt = rva + off + 5 + struct.unpack('<i', body[off + 1:off + 5])[0]
            if tgt % STRIDE == 0 and tgt < rva:
                return tgt
        return rva

    img_names = [n for n, _ in sorted(((n, order_rva(n, rva))
                                       for n, rva in exp.items()),
                                      key=lambda kv: kv[1])
                 if n not in RESERVED_EXPORTS]
    pos_of = {e['name']: i for i, e in enumerate(listed)}
    invented = [n for n in img_names if n not in pos_of]
    r.check(not invented, '5b every exported name is in the export list',
            'not in the list: %s' % invented[:10] if invented
            else '%d name(s)' % len(img_names))
    positions = [pos_of[n] for n in img_names if n in pos_of]
    r.check(positions == sorted(positions),
            '5b2 exported names keep the export list\'s relative order',
            'out of order' if positions != sorted(positions)
            else '%d name(s) in list order' % len(positions))
    omitted = [n for n in listed_names if n not in set(img_names)]
    if args.require_complete:
        r.check(not omitted, '5b3 no export omitted (--require-complete)',
                'omitted=%s' % omitted[:10] if omitted else '')
    else:
        r.note('omitted by the generator',
               '%d of %d listed export(s) refused and not emitted%s'
               % (len(omitted), len(listed_names),
                  '' if not omitted else ': ' + ', '.join(omitted[:8])
                  + (' ...' if len(omitted) > 8 else '')))

    # From here on `spec_exports` is what the IMAGE carries, in image order,
    # each carrying whatever assertion columns a .thunks line gave it.
    by_name = {e['name']: e for e in listed}
    spec_exports = [by_name[n] for n in img_names if n in by_name]
    for e in spec_exports:
        if e.get('imm') is None:
            # A spec-derived entry has no hand-written imm32.  The generator
            # numbers them by position in the eligible list; re-derive that
            # rather than believe it, so --body=direct is still byte-checked.
            e['imm'] = pos_of[e['name']]
    spec_names = [e['name'] for e in spec_exports]

    r.check('__wine_thunk_info' in exp, '8a __wine_thunk_info exported by name',
            '0x%08x' % exp.get('__wine_thunk_info', 0))
    stub_rvas = [exp[n] for n in spec_names if n in exp]
    r.check(len(set(stub_rvas)) == len(stub_rvas),
            '5c each named export has its own distinct slot',
            '%d distinct of %d' % (len(set(stub_rvas)), len(stub_rvas)))

    br_va, br_sz = pe.dir(DIR_BASERELOC)
    r.check(br_va != 0 and br_sz != 0,
            '9a IMAGE_DIRECTORY_ENTRY_BASERELOC non-empty',
            'rva=0x%x size=0x%x' % (br_va, br_sz))
    r.check(not (pe.characteristics & IMAGE_FILE_RELOCS_STRIPPED),
            '9b IMAGE_FILE_RELOCS_STRIPPED NOT set', '')
    if br_va:
        try:
            blk_rva, blk_sz = struct.unpack_from('<II', pe.read(br_va, 8))
            nent = (blk_sz - 8) // 2 if blk_sz >= 8 else 0
            r.check(blk_sz >= 8 and nent > 0, '9c first .reloc block has >=1 entry',
                    'page=0x%x size=%d entries=%d' % (blk_rva, blk_sz, nent))
        except Fail as e:
            r.check(False, '9c first .reloc block readable', str(e))

    want_base = int(args.image_base, 0)
    r.check(pe.image_base == want_base,
            '10 OptionalHeader.ImageBase == 0x%x' % want_base, '0x%x' % pe.image_base)

    # -- 8. __wine_thunk_info
    info_rva = exp.get('__wine_thunk_info')
    fields = None
    if info_rva:
        try:
            fields = struct.unpack_from('<%dI' % INFO_FIELDS,
                                        pe.read(info_rva, 4 * INFO_FIELDS))
        except Fail as e:
            r.check(False, '8b __wine_thunk_info readable', str(e))
    if not fields:
        print("\n%d checks, %d FAIL" % (r.n, r.bad + 1))
        return 1

    (version, count, stubs_rva, stride, names_rva, sigs_rva, trap_off,
     impl_names_rva, fp_rva, widths_rva, signs_rva, geom32_rva) = fields
    r.note('__wine_thunk_info',
           'ver=%d count=%d stubs_rva=0x%x stride=%d names_rva=0x%x '
           'sigs_rva=0x%x trap_off=%d impl_names_rva=0x%x fp_rva=0x%x '
           'widths_rva=0x%x signs_rva=0x%x geom32_rva=0x%x' % fields)
    r.check(version == INFO_VERSION,
            '8b __wine_thunk_info.version == %d' % INFO_VERSION, str(version))
    # Against the EXPORT DIRECTORY, not against the list: the image is allowed
    # to carry fewer than the list offers (refusals), but every function it
    # exports must have a stub and every stub must be exported.
    r.check(count == len(img_names),
            '8c count == number of exported functions',
            '%d vs %d' % (count, len(img_names)))
    r.check(stride == STRIDE, '8d stride == 16', str(stride))
    r.check(impl_names_rva != 0, '8i impl_names_rva present (version 4)',
            '0x%x' % impl_names_rva)
    r.check(widths_rva != 0, '8k widths_rva present (version 6)',
            '0x%x' % widths_rva)
    r.check(signs_rva != 0, '8l signs_rva present (version 7)',
            '0x%x' % signs_rva)
    r.check(geom32_rva != 0, '8m geom32_rva present (version 8)',
            '0x%x' % geom32_rva)
    # The i386 frame word's own consistency: on an x86_64 module every word
    # must be 0 (the field exists, the geometry does not apply); on an i386
    # module a VALID word's slot arithmetic must at least cover the sig's
    # argc -- each argument is one slot or two, so slots is argc plus the
    # popcount of the qword mask, and the mask may not name arguments past
    # argc.  0 is always legal: it is the fail-closed refusal.
    try:
        geoms = [pe.u32(geom32_rva + 4 * i) for i in range(count)]
    except Fail as e:
        geoms = None
        r.check(False, '8m2 geom32 words readable', str(e))
    if geoms is not None:
        if pe.machine != 0x14c:
            bad = [i for i, g in enumerate(geoms) if g]
            r.check(not bad, '8m3 x86_64 module publishes all-zero geom32',
                    'first nonzero at index %d' % bad[0] if bad else 'all 0')
        else:
            bad = []
            for i, g in enumerate(geoms):
                if not (g & 0x80000000):
                    continue
                sig = pe.u32(sigs_rva + 4 * i)
                argc = sig & 0xff
                slots = g & 0xff
                qmask = (g >> 8) & 0xffff
                if argc < 16 and qmask >> argc:
                    bad.append('%d: qword mask past argc' % i)
                elif slots != argc + bin(qmask).count('1'):
                    bad.append('%d: slots %d != argc %d + qwords %d'
                               % (i, slots, argc, bin(qmask).count('1')))
            r.check(not bad, '8m3 valid geom32 slot arithmetic matches sigs',
                    '; '.join(bad[:4]) if bad else 'ok')
    for tag, rva in (('__wine_thunk_info', info_rva), ('names_rva', names_rva),
                     ('sigs_rva', sigs_rva), ('impl_names_rva', impl_names_rva)):
        s = pe.section_of(rva)
        r.check(s is not None and not (s['flags'] & IMAGE_SCN_MEM_WRITE),
                '8e %s is in a non-writable section' % tag,
                ('%s flags=0x%08x' % (s['name'], s['flags'])) if s else 'no section')

    walked = []
    try:
        for i in range(count):
            walked.append(pe.cstr(pe.u32(names_rva + 4 * i)))
    except Fail as e:
        r.check(False, '8f walk names_rva -> name strings', str(e))
    if len(walked) == count:
        r.check(walked == spec_names, '8f names_rva[] names match spec order',
                ','.join(walked) if walked != spec_names else '%d names' % count)
        r.check(all(n in exp for n in walked),
                '8g every names_rva[] name is in the export directory')
        # A fast-path export's NAME points at its fast body, not at its slot.
        # The slot is still there and still holds the trap (checks 7, 12b,
        # 12c); what moved is only where the export directory sends a caller.
        fastnames = [n for n in walked
                     if args.body == 'trap'
                     and (spec_dll or '').lower() in FAST_PATH_MODULES
                     and n in FAST_PATH_EXPORTS]
        bad = ['%s: 0x%x != 0x%x' % (n, exp.get(n, 0), stubs_rva + i * STRIDE)
               for i, n in enumerate(walked)
               if n not in fastnames and exp.get(n) != stubs_rva + i * STRIDE]
        r.check(not bad, '8h export RVA == stubs_rva + index*16 for every name'
                + (' (fast paths excepted)' if fastnames else ''),
                '; '.join(bad) if bad else 'all %d ok' % (count - len(fastnames)))

        if fastnames:
            qpc_rva = exp.get(QPC_BLOCK_EXPORT, 0)
            s = pe.section_of(qpc_rva) if qpc_rva else None
            r.check(s is not None and bool(s['flags'] & IMAGE_SCN_MEM_WRITE),
                    '8p %s is exported and writable' % QPC_BLOCK_EXPORT,
                    ('%s flags=0x%08x' % (s['name'], s['flags'])) if s
                    else 'no such export')
            if qpc_rva and s:
                try:
                    blk = pe.read(qpc_rva, QPC_BLOCK_SIZE)
                except Fail as e:
                    blk = None
                    r.check(False, '8p2 the QPC block is readable', str(e))
                if blk:
                    magic = struct.unpack('<Q', blk[:8])[0]
                    r.check(magic == QPC_MAGIC,
                            '8p3 the QPC block carries the magic the host checks',
                            '0x%016x, want 0x%016x' % (magic, QPC_MAGIC))
                    # Linked DISARMED.  A block that shipped armed would have
                    # a guest reading an all-zero multiplier as a clock.
                    r.check(blk[QPC_ENABLED] == 0,
                            '8p4 the QPC block ships disarmed',
                            'enabled=%d' % blk[QPC_ENABLED])

            stub_of = {n: stubs_rva + i * STRIDE for i, n in enumerate(walked)}
            bad, seen = [], []
            for n in fastnames:
                rva = exp.get(n, 0)
                sec = pe.section_of(rva)
                if not rva or sec is None or sec['name'] != '.thunk':
                    bad.append('%s: not in .thunk' % n)
                    continue
                if rva < stubs_rva + count * STRIDE:
                    bad.append('%s: 0x%x is inside the stub array' % (n, rva))
                    continue
                try:
                    body = pe.read(rva, FAST_BODY_MAX)
                except Fail as e:
                    bad.append('%s: %s' % (n, e))
                    continue
                # Each kind's contractual HEAD.  The qpc pair must open on the
                # arming test against the block's enabled byte; the CS pair on
                # its kill-switch test against cs_disable; tid and peek carry
                # no block state and must open on their known first
                # instruction (the gs load their probes also check for).  The
                # original qpc-only spelling reported the later kinds as bad,
                # which was the check lying about legitimate bodies.
                head_kind = ('qpc' if n.startswith('QueryPerformance')
                             else 'cs' if 'CriticalSection' in n
                             else n)
                if head_kind in ('qpc', 'cs'):
                    want_imm = 1 if head_kind == 'qpc' else 0
                    want_off = QPC_ENABLED if head_kind == 'qpc' else QPC_CS_DISABLE
                    if body[0:2] != b'\x80\x3d' or body[6] != want_imm:
                        bad.append('%s: does not begin with cmpb $%d, disp32(%%rip)'
                                   % (n, want_imm))
                        continue
                    disp = struct.unpack('<i', body[2:6])[0]
                    if rva + 7 + disp != qpc_rva + want_off:
                        bad.append('%s: tests 0x%x, not %s+%d'
                                   % (n, rva + 7 + disp, QPC_BLOCK_EXPORT, want_off))
                        continue
                elif head_kind == 'GetCurrentThreadId':
                    if body[0:8] != b'\x65\x8b\x04\x25\x48\x00\x00\x00':
                        bad.append('%s: does not begin with movl %%gs:0x48, %%eax' % n)
                        continue
                elif head_kind == 'PeekMessageW':
                    if body[0:9] != b'\x65\x4c\x8b\x14\x25\x98\x01\x00\x00':
                        bad.append('%s: does not begin with movq %%gs:0x198, %%r10' % n)
                        continue
                else:
                    bad.append('%s: fast-path export with no head contract here -- '
                               'teach this check its first instruction' % n)
                    continue
                # and somewhere in it a direct jump back to ITS OWN trap stub,
                # which is what makes the fallback a fallback.
                want, found = stub_of[n], False
                for off in range(7, FAST_BODY_MAX - 5):
                    if body[off] != 0xe9:
                        continue
                    rel = struct.unpack('<i', body[off + 1:off + 5])[0]
                    if rva + off + 5 + rel == want:
                        found = True
                        break
                if not found:
                    bad.append('%s: no jmp back to its stub at 0x%x' % (n, want))
                    continue
                seen.append('%s@0x%x' % (n, rva))
            r.check(not bad,
                    '8q every fast body tests the block and falls back to its own stub',
                    '; '.join(bad) if bad else ', '.join(seen))
        elif QPC_BLOCK_EXPORT in exp:
            r.check(False, '8p this module exports %s but has no fast path'
                    % QPC_BLOCK_EXPORT, 'stale block')

    # -- impl_names_rva[] (version 4).  Walked and validated as bytes here;
    # cross-checked against the descriptors and against Wine's headers at 11h.
    impls = []
    if impl_names_rva:
        try:
            for i in range(count):
                impls.append(pe.cstr(pe.u32(impl_names_rva + 4 * i)))
        except Fail as e:
            r.check(False, '8j walk impl_names_rva -> impl name strings', str(e))
    if len(impls) == count:
        bad = ['[%d] %r' % (i, s) for i, s in enumerate(impls)
               if not s or not all(0x21 <= ord(c) <= 0x7e for c in s)]
        r.check(not bad, '8j impl_names_rva[] are non-empty printable ASCII',
                '; '.join(bad) if bad else '%d strings' % count)
        r.note('impl_names_rva[]',
               ', '.join('%s->%s' % (walked[i], impls[i])
                         for i in range(min(count, len(walked)))
                         if i >= len(walked) or impls[i] != walked[i])
               or 'every entry identical to its export name')
    # -- 6. section holding the stubs
    sec = pe.section_of(stubs_rva)
    r.check(sec is not None and sec['name'] == '.thunk',
            '6a stubs live in a section named ".thunk"', sec['name'] if sec else 'none')
    if sec:
        r.check(bool(sec['flags'] & IMAGE_SCN_MEM_EXECUTE), '6b .thunk is executable',
                'flags=0x%08x' % sec['flags'])
        r.check(bool(sec['flags'] & IMAGE_SCN_CNT_CODE), '6c .thunk is IMAGE_SCN_CNT_CODE',
                'flags=0x%08x' % sec['flags'])
        span = max(sec['vsize'], sec['rsize'])
        r.check(stubs_rva + count * STRIDE <= sec['vaddr'] + span,
                '6d all %d stubs fit inside .thunk' % count,
                'need 0x%x, sec 0x%x+0x%x' % (count * STRIDE, sec['vaddr'], span))
        r.check(stubs_rva % STRIDE == 0, '6e stubs_rva is 16-byte aligned',
                '0x%x' % stubs_rva)

    # -- 7. stub bodies, byte for byte
    immmap = {e['name']: e['imm'] for e in spec_exports}
    bad = []
    for i, n in enumerate(spec_names[:count]):
        rva = stubs_rva + i * STRIDE
        try:
            g = pe.read(rva, STRIDE)
        except Fail as e:
            bad.append('%s: %s' % (n, e))
            continue
        w = expect_stub(args.body, immmap[n], n)
        if g != w:
            bad.append('%s@0x%x: got %s want %s' % (n, rva, g.hex(), w.hex()))
    r.check(not bad, '7  every stub body matches --body=%s exactly' % args.body,
            '; '.join(bad) if bad else '%d stubs verified' % count)
    # Slot RVAs, not directory RVAs: a fast-path export's name points at its
    # fast body (see order_rva above), while its SLOT is still exactly where
    # the stride says it is, and the stride is what this check is about.
    slot_rva = {n: order_rva(n, exp[n]) for n in spec_names if n in exp}
    r.check(all(slot_rva[spec_names[i]] + STRIDE == slot_rva[spec_names[i + 1]]
                for i in range(len(spec_names) - 1)
                if spec_names[i] in slot_rva and spec_names[i + 1] in slot_rva),
            '6f stubs are contiguous at 16-byte stride')

    # -- 12. published trap site
    want_off = TRAP_OFF[args.body]
    r.check(trap_off == want_off,
            '12a trap_off == %d for --body=%s' % (want_off, args.body),
            str(trap_off))
    if args.body == 'trap':
        # Register-contract exports (RAW_BODY_EXPORTS) carry a raw guest body,
        # not a trap stub, so they are exempt from the syscall-site checks and
        # verified separately: their slot must hold EXACTLY their raw body.
        raw_idx = {i for i, n in enumerate(spec_names[:count])
                   if n in RAW_BODY_EXPORTS}
        bad = []
        for i in range(count):
            if i in raw_idx:
                continue
            rva = stubs_rva + i * STRIDE + trap_off
            try:
                g = pe.read(rva, len(TRAP_INSN))
            except Fail as e:
                bad.append('stub %d: %s' % (i, e))
                continue
            if g != TRAP_INSN:
                bad.append('stub %d @0x%x: %s not %s'
                           % (i, rva, g.hex(), TRAP_INSN.hex()))
        r.check(not bad,
                '12b published trap site really holds SYSCALL (0f 05)',
                '; '.join(bad) if bad else
                '%d sites at stubs_rva+i*16+%d' % (count - len(raw_idx), trap_off))
        bad = []
        for i in range(count):
            if i in raw_idx:
                continue
            try:
                g = pe.read(stubs_rva + i * STRIDE, 3)
            except Fail as e:
                bad.append('stub %d: %s' % (i, e))
                continue
            if g != b'\x49\x89\xca':
                bad.append('stub %d: %s not 4989ca' % (i, g.hex()))
        r.check(not bad,
                '12c every trap stub starts with mov r10,rcx (49 89 ca)',
                '; '.join(bad) if bad else
                'arg0 rescued in all %d stubs' % (count - len(raw_idx)))
        bad = []
        for i in sorted(raw_idx):
            n = spec_names[i]
            want = RAW_BODY_EXPORTS[n] + b'\xcc' * (STRIDE - len(RAW_BODY_EXPORTS[n]))
            try:
                g = pe.read(stubs_rva + i * STRIDE, STRIDE)
            except Fail as e:
                bad.append('%s: %s' % (n, e)); continue
            if g != want:
                bad.append('%s@stub %d: %s not %s' % (n, i, g.hex(), want.hex()))
        if raw_idx:
            r.check(not bad,
                    '12b2 register-contract stubs hold their raw guest body',
                    '; '.join(bad) if bad else
                    '%d raw-body stub(s): %s' % (len(raw_idx),
                        ', '.join(sorted(spec_names[i] for i in raw_idx))))
        # nothing before the trap site may itself trap or return
        r.check(TRAP_INSN not in pe.read(stubs_rva, trap_off),
                '12d no earlier SYSCALL before the published trap site')
    else:
        r.check(trap_off == 0, '12b direct mode publishes no trap site',
                'trap_off=%d' % trap_off)

    # -- 11. signature descriptors, re-derived from Wine's headers by regex
    descs = []
    try:
        descs = [pe.u32(sigs_rva + 4 * i) for i in range(count)]
    except Fail as e:
        r.check(False, '11a sigs_rva[] readable', str(e))
    if len(descs) == count:
        r.note('sigs_rva[]',
               ' '.join('0x%05x' % d for d in descs) if len(descs) <= 250
               else '%d descriptors (dump suppressed; every one is re-derived '
                    'at 11e below)' % len(descs))
        bad = ['%s=0x%08x' % (walked[i] if i < len(walked) else i, d)
               for i, d in enumerate(descs) if d & DESC_RESERVED]
        r.check(not bad, '11a descriptor reserved bits 10..15 are zero',
                '; '.join(bad) if bad else 'all %d clean' % count)
        # The narrow-argument mask can only name arguments that exist: a bit
        # at or beyond nargs means the generator and this reader disagree
        # about the descriptor layout, which is exactly what a structural
        # check is for.
        bad = ['%s=0x%08x' % (walked[i] if i < len(walked) else i, d)
               for i, d in enumerate(descs)
               if (d & 0xff) < 16 and (d >> DESC_NARROW_SHIFT) >> (d & 0xff)]
        r.check(not bad, '11a2 narrow-argument mask names only existing args',
                '; '.join(bad) if bad else 'all %d in range' % count)
        # A variadic costs one slot MORE than its fixed count -- the va_list the
        # host synthesises -- and dlls/ntdll/signal_ppc64.c rejects a stub whose
        # total exceeds THUNK_MAX_ARGS, so the same bound has to hold here or
        # the image is one the dispatcher will refuse at runtime.
        bad = ['%s nargs=%d%s' % (walked[i], d & 0xff,
                                  '+va' if d & DESC_VARIADIC else '')
               for i, d in enumerate(descs)
               if (d & 0xff) + (1 if d & DESC_VARIADIC else 0) > 16]
        r.check(not bad, '11b descriptor nargs (+va_list) <= 16',
                '; '.join(bad) if bad else 'all %d in range' % count)

        # Exports the thunk spec deliberately cites to a .spec file rather than
        # a header: Wine declares them nowhere, so the header scan cannot and
        # should not be expected to find them.  They get 11g instead of 11c.
        by_spec = {e['name'] for e in spec_exports
                   if (e['header'] or '').endswith('.spec')}

        # The v-variants a variadic forwards to have to be scanned for too, so
        # the nfixed+1 pairing can be re-derived here rather than believed.
        # Several of them (vprintf, _vsnprintf) are already exports in their own
        # right; scanning a name twice would only duplicate work.
        want_names = list(spec_names)
        for e in spec_exports:
            if e['variadic_impl'] and e['variadic_impl'] not in want_names:
                want_names.append(e['variadic_impl'])

        # A COM-mode module's declarations live in the INCLUDE-DIR trees the
        # .thunks names (vkd3d-proton's generated headers), not in Wine's.
        # Scan those too and merge; the wine-include scan stays exactly as it
        # was for every module that names none.
        ucrt = dll_is_ucrt(spec_dll)
        scans = [HeaderScan(spec_relative(d), ucrt=ucrt)
                 for d in extra['include_dirs']]
        scans.append(HeaderScan(args.wine_include, ucrt=ucrt))
        hits = {n: [] for n in want_names}
        for scan in scans:
            for n, hs in scan.find(want_names).items():
                hits[n] += hs
        r.note('header scan', '%s mode; ' % ('_UCRT' if ucrt else 'non-UCRT')
               + '; '.join('%d headers in %s'
                           % (len(s.files), s.dir) for s in scans))
        nodecl = [n for n in spec_names
                  if n not in by_spec and n not in RAW_BODY_EXPORTS and not hits[n]]
        r.check(not nodecl, '11c every export has a declaration in Wine headers',
                'not found: %s' % nodecl if nodecl else
                '%d found (%d cited to a .spec instead)'
                % (len(spec_names) - len(by_spec), len(by_spec)))
        if by_spec:
            sscan = SpecScan(args.wine_source)
            bad = []
            for i, e in enumerate(spec_exports):
                if e['name'] not in by_spec:
                    continue
                try:
                    n_args, detail = sscan.arity(e['name'], e['header'], e['line'])
                except Fail as ex:
                    bad.append(str(ex))
                    continue
                if i < len(descs) and (descs[i] & 0xff) != n_args:
                    bad.append('%s: image says %d args, %s'
                               % (e['name'], descs[i] & 0xff, detail))
                elif e['nargs'] != n_args:
                    bad.append('%s: thunk spec claims %d args, %s'
                               % (e['name'], e['nargs'], detail))
                else:
                    r.note('  %-24s desc=0x%03x -> %d arg(s), return kind '
                           'UNVERIFIABLE' % (e['name'], descs[i], n_args),
                           'arity from %s' % detail)
            r.check(not bad, '11g .spec-cited exports: arity matches the '
                             'cited .spec line',
                    '; '.join(bad) if bad else
                    '%d confirmed (return kind NOT checked -- a .spec has none)'
                    % len(by_spec))
        conflict, mism, locbad, vbad, condskip = [], [], [], [], []
        for i, e in enumerate(spec_exports):
            n = e['name']
            hs = hits[n]
            if not hs:
                continue
            # Declarations this scan cannot count -- see `cond` in HeaderScan.
            # A name declared BOTH ways keeps the countable declaration; a name
            # declared only inside a conditional parameter list is announced
            # and skipped, never guessed at.
            if not any(not h['cond'] for h in hs):
                condskip.append('%s (%s:%d)' % (n, hs[0]['file'], hs[0]['line']))
                continue
            hs = [h for h in hs if not h['cond']]
            shapes = {(h['nargs'], h['void'], h['variadic']) for h in hs}
            if len(shapes) != 1:
                conflict.append('%s: %s' % (n, sorted(shapes)))
                continue
            nargs, void, variadic = shapes.pop()
            # A variadic's `...` is one of the tokens split_top() returned, so
            # it has to come back off: the descriptor counts FIXED arguments.
            nfixed = nargs - 1 if variadic else nargs
            want = ((nfixed & 0xff) | (DESC_VOID if void else 0)
                    | (DESC_VARIADIC if variadic else 0))
            # Compare only the bits a regex re-derivation CAN re-derive:
            # argc, void and variadic (bits 0..9).  The narrow-argument mask
            # (bits 16..31) comes from clang measuring sizeof on the guest
            # target, which no header regex reproduces honestly; its
            # structural validity is 11a2 and its ground truth is the
            # generator's own oracle.
            if i < len(descs) and (descs[i] & 0x3ff) != want:
                mism.append('%s: image 0x%03x, headers say 0x%03x '
                            '(%d %sargs, ret %s%s)'
                            % (n, descs[i] & 0x3ff, want, nfixed,
                               'fixed ' if variadic else '',
                               'void' if void else 'non-void',
                               ', VARIADIC' if variadic else ''))
            # the spec's own claim, and the file:line it cites -- only a
            # HAND-WRITTEN line makes those claims.  A spec-derived entry has
            # no nargs/int|void/header:line column to be wrong about; what it
            # does have is the Wine .spec's own argument list, checked below.
            if e.get('asserted'):
                if e['nargs'] != nfixed or e['void'] != void:
                    mism.append('%s: spec claims %d args/%s, headers say %d args/%s'
                                % (n, e['nargs'], 'void' if e['void'] else 'int',
                                   nfixed, 'void' if void else 'int'))
                if not any(h['file'] == e['header'] and h['line'] == e['line']
                           for h in hs):
                    locbad.append('%s: spec cites %s:%d, scan found %s'
                                  % (n, e['header'], e['line'],
                                     ', '.join('%s:%d' % (h['file'], h['line'])
                                               for h in hs)))
            elif e.get('spec_nargs') is not None and not variadic:
                # Two independent readings of the module: the Wine .spec's
                # argument list, re-parsed by WineSpecList, against the header
                # text.  The generator refuses on this disagreement; anything
                # that made it into the image must not have one.
                if e['spec_nargs'] != nfixed:
                    mism.append('%s: %s says %d arg(s), headers say %d'
                                % (n, os.path.basename(from_spec or '.spec'),
                                   e['spec_nargs'], nfixed))

            # ---- 11h: the variadic contract, re-derived, in both directions.
            declared_impl = impls[i] if i < len(impls) else None
            if variadic != bool(e['variadic_impl']):
                vbad.append('%s: headers say %svariadic, thunk spec says %s'
                            % (n, '' if variadic else 'NOT ',
                               'variadic=%s' % e['variadic_impl']
                               if e['variadic_impl'] else 'nothing'))
            if declared_impl is None:
                vbad.append('%s: no impl_names_rva[%d] entry to check' % (n, i))
            elif not variadic:
                # Non-variadic: the host must resolve the export's own name --
                # UNLESS the .thunks file redirected it, with GUEST-IMPL or
                # GUEST-REFUSE, which ride this same field.  The rule used to be
                # "a differing impl name implies variadic", and that stopped
                # being true the moment anything else could rewrite the field:
                # first the COM flat wrappers, then _initterm.  Police the
                # redirect against what the spec actually asked for instead of
                # forbidding it.
                want = guest_impl.get(n, n)
                if declared_impl != want:
                    vbad.append('%s: impl name is %r, spec asked for %r'
                                % (n, declared_impl, want))
            else:
                if declared_impl == n:
                    vbad.append('%s: variadic, but its impl name is itself -- '
                                'a fixed-arity call to a `...` function' % n)
                if e['variadic_impl'] and declared_impl != e['variadic_impl']:
                    vbad.append('%s: image says impl %r, thunk spec says %r'
                                % (n, declared_impl, e['variadic_impl']))
                # The v-variant takes the same fixed arguments plus one va_list,
                # which is one ordinary pointer parameter, so nfixed+1 exactly.
                ihs = hits.get(declared_impl) or []
                if not ihs:
                    vbad.append('%s: impl %r has no declaration in Wine headers'
                                % (n, declared_impl))
                else:
                    ishapes = {(h['nargs'], h['void'], h['variadic']) for h in ihs}
                    if len(ishapes) != 1:
                        vbad.append('%s: impl %r declared inconsistently: %s'
                                    % (n, declared_impl, sorted(ishapes)))
                    else:
                        ia, ivoid, ivar = ishapes.pop()
                        if ivar:
                            vbad.append('%s: impl %r is itself variadic'
                                        % (n, declared_impl))
                        elif ia != nfixed + 1:
                            vbad.append('%s: %d fixed args need an impl of %d '
                                        'args, but %r takes %d'
                                        % (n, nfixed, nfixed + 1,
                                           declared_impl, ia))
                        if ivoid != void:
                            vbad.append('%s returns %s but impl %r returns %s'
                                        % (n, 'void' if void else 'a value',
                                           declared_impl,
                                           'void' if ivoid else 'a value'))

        r.check(not conflict, '11d Wine headers self-consistent for each export',
                '; '.join(conflict) if conflict else 'no conflicting declarations')
        if condskip:
            r.note('11e not re-derivable by a text scan (%d): a preprocessor '
                   'directive inside the parameter list' % len(condskip),
                   ', '.join(condskip))
        r.check(not mism, '11e descriptor matches Wine headers (regex re-derivation)',
                '; '.join(mism) if mism else '%d descriptors confirmed'
                % (count - len(condskip)))
        r.check(not locbad, '11f spec cites a header:line that really declares it',
                '; '.join(locbad) if locbad else 'all %d locations confirmed' % count)
        nvar = sum(1 for d in descs if d & DESC_VARIADIC)
        r.check(not vbad, '11h variadic bit, impl name and nfixed+1 pairing',
                '; '.join(vbad) if vbad else
                '%d variadic, %d plain, all impl names re-derived'
                % (nvar, count - nvar))

        # Exports whose declaration the scan could not see at all (cited to a
        # .spec) never reach 11h's impl rules above, so police them here: they
        # are non-variadic by construction -- a `@ varargs` .spec line cannot be
        # described -- and their impl name must be their own OR the redirect
        # the .thunks file asked for.
        vbad = []
        for i, e in enumerate(spec_exports):
            if hits[e['name']]:
                continue
            if e['variadic_impl']:
                vbad.append('%s: variadic= on an export with no header '
                            'declaration' % e['name'])
            if i < len(descs) and descs[i] & DESC_VARIADIC:
                vbad.append('%s: variadic bit set with no header declaration'
                            % e['name'])
            want = guest_impl.get(e['name'], e['name'])
            if i < len(impls) and impls[i] != want:
                vbad.append('%s: impl name is %r, spec asked for %r'
                            % (e['name'], impls[i], want))
        r.check(not vbad, '11i .spec-cited exports are plain, impl name == export',
                '; '.join(vbad) if vbad else
                '%d checked' % len([1 for e in spec_exports if not hits[e['name']]]))

        # ---- 11j: the OTHER end of the redirect.  11h/11i prove the image
        # carries the impl name the .thunks file asked for; nothing in the
        # image can show that the native module actually EXPORTS that name,
        # and a redirect to a symbol that is not there leaves the guest
        # faulting at its first call instead of reaching the wrapper.  So
        # re-derive it from the module's own .spec TEXT, with this file's own
        # reader.  Only redirect targets are looked up -- the ordinary
        # export == impl case is the .spec line the export came from.
        if guest_impl:
            spec_names, err = set(), None
            if not from_spec:
                err = 'redirects need a FROM-SPEC module to resolve against'
            try:
                with open(from_spec, errors='replace') as fh:
                    for raw in fh:
                        m = WineSpecList.LINE_RE.match(raw.split('#', 1)[0])
                        # A `@ stub` line exports the name too, and resolving a
                        # redirect to one would answer failure silently -- so
                        # only real function entries count as a target here.
                        if m and m.group('type') in WineSpecList.FUNC_TYPES:
                            spec_names.add(m.group('name'))
            except (OSError, TypeError) as e:
                err = err or str(e)
            wanted = sorted(set(guest_impl.values()))
            miss = [t for t in wanted if t not in spec_names]
            r.check(err is None and not miss,
                    '11j GUEST-IMPL/GUEST-REFUSE targets are exported by the '
                    "module's own .spec",
                    err if err else
                    'not exported by %s: %s' % (os.path.basename(from_spec),
                                                ', '.join(miss)) if miss else
                    '%d redirect target(s) confirmed in %s'
                    % (len(wanted), os.path.basename(from_spec)))

        # One info line per export is readable for a hand-written list and is
        # 1100 lines of scrollback for a whole .spec, which buries the PASS/FAIL
        # summary this file exists to print.  Everything above has already been
        # CHECKED for all of them; this is only the human-readable echo.
        if len(spec_exports) > 250:
            r.note('per-export detail', 'suppressed for %d exports'
                                        % len(spec_exports))
        for i, e in enumerate(spec_exports):
            if len(spec_exports) > 250:
                break
            if hits[e['name']] and i < len(descs):
                # Several headers can declare the same CRT name (stdio.h has
                # both a UCRT `static inline` and the real msvcrt import
                # declaration of _vsnprintf; process.h redeclares exit).  11d
                # already proved every hit has the SAME shape, so any of them
                # is correct for the descriptor -- but reporting hits[0] here
                # printed a location the spec does not cite and that the reader
                # then cannot find.  Show the CITED declaration when it is
                # among the hits, and fall back to the first otherwise.
                h = next((x for x in hits[e['name']]
                          if x['file'] == e['header'] and x['line'] == e['line']),
                         hits[e['name']][0])
                via = '  (via %s)' % h['via'] if h.get('via') else ''
                v = descs[i] & DESC_VARIADIC
                r.note('  %-24s desc=0x%03x -> %d %sarg(s), returns %s%s'
                       % (e['name'], descs[i], descs[i] & 0xff,
                          'fixed ' if v else '',
                          'void' if descs[i] & DESC_VOID else 'value',
                          (', VARIADIC -> %s'
                           % (impls[i] if i < len(impls) else '???')) if v else ''),
                       'from %s:%d  %s%s' % (h['file'], h['line'], h['ret'], via))

    # -- c. COM mode: stub arrays and __wine_com_thunk_info
    if extra['com_json']:
        try:
            check_com_section(r, pe, exp, spec_relative(extra['com_json']),
                              count, stubs_rva)
        except Fail as e:
            r.check(False, 'c0 COM section parses', str(e))

    print()
    print("%d checks, %d FAIL" % (r.n, r.bad))
    return 1 if r.bad else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Fail as e:
        print("FAIL fatal: %s" % e)
        sys.exit(1)
