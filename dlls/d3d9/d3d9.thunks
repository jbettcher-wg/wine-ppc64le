# AMD64 thunk export spec for the guest d3d9.dll -- COM mode.
#
# Read dlls/d3d11/d3d11.thunks first: the FROM-SPEC/COM-JSON arrangement, the
# flat-surface audit and the two-names rule are all that file's and are not
# repeated here.  What is different is only that this roster is D3D9's own.
#
#   * COM-JSON is ppc64le/dxvk/interfaces_d3d9.json -- 21 interfaces, 497
#     vtable slots, generated by ppc64le/dxvk/gen_interfaces.py from DXVK's
#     vendored MinGW/widl d3d9.h, which is the header libdxvk_d3d9.so was
#     compiled against.  It is a SEPARATE roster from interfaces_dxvk.json and
#     a separate winecom instance, because D3D9 and DXGI share no objects: no
#     D3D9 method takes a DXGI interface and no DXGI method takes a D3D9 one,
#     and libdxvk_d3d9.so has no DT_NEEDED on libdxvk_dxgi.so.  That is the
#     opposite of d3d11/dxgi/d3d10core, where one D3D11CreateDevice(adapter)
#     call spans two of them and forces a single instance.
#
#   * d3d9.h is a DECLARE_INTERFACE_ header, not a MIDL_INTERFACE one, and
#     each interface body re-declares every inherited method.  gen_interfaces.py
#     handles that dialect and verifies, per interface, that the re-declared
#     prefix matches the base's vtable name for name and in order -- because
#     getting it wrong compiles fine and dispatches Clear into Present.
#
# Only two flat exports carry an interface, and both get a GUEST-IMPL row.
# Everything else on this surface is either a scalar entry point or refused by
# name in dlls/d3d9/main.c.

DLL       d3d9.dll
FROM-SPEC auto
COM-JSON  ../../ppc64le/dxvk/interfaces_d3d9.json

GUEST-IMPL Direct3DCreate9   __wine_guest_Direct3DCreate9
GUEST-IMPL Direct3DCreate9Ex __wine_guest_Direct3DCreate9Ex

# Refused at runtime, but still GUEST-IMPL rather than GUEST-REFUSE: the shared
# __wine_com_refuse stub answers E_NOTIMPL with a generic message, and these two
# have a specific reason worth reading (D3D9On12 needs the d3d12 lane's winecom
# instance).  Routing them through the module's own wrappers keeps the reason
# attached to the name.
GUEST-IMPL Direct3DCreate9On12   __wine_guest_Direct3DCreate9On12
GUEST-IMPL Direct3DCreate9On12Ex __wine_guest_Direct3DCreate9On12Ex

# The oracle's translation unit is built for kernel32's surface and does not
# reach d3d9.h, so without this EVERY export of this module is refused as "no
# declaration found in Wine headers" -- a fact about the tooling and not about
# the ABI, and exactly what tools/spec2thunk's PROBE-EXTRA exists for.  The
# header pulls in Wine's d3d9.h and then declares the four exports Wine ships
# in its .spec and declares in no header at all.
PROBE-EXTRA dxvk_flat_surface_d3d9.h
INCLUDE-DIR ../../ppc64le/dxvk

# Internal names, kept out of the guest export list entirely; see
# dlls/d3d11/d3d11.thunks.
EXCLUDE __wine_com_dispatch
EXCLUDE __wine_com_slot_name
EXCLUDE __wine_guest_Direct3DCreate9
EXCLUDE __wine_guest_Direct3DCreate9Ex
EXCLUDE __wine_guest_Direct3DCreate9On12
EXCLUDE __wine_guest_Direct3DCreate9On12Ex
