# AMD64 thunk export spec -- wininet.dll.
#
# From the 2026-08-17 everyday-DLL pass.  wininet is what a launcher, a patcher
# and every in-game news panel reach for, and this module had NO guest thunk at
# all: the loader found the native ppc64 builtin, correctly refused to splice it
# into a guest call, and every import reported c000007b.  Nothing here is
# hand-written -- the export list is this module's own .spec.
DLL wininet.dll
FROM-SPEC auto

# ---------------------------------------------------------------- the probe
# PROBE-INCLUDE, NOT PROBE-EXTRA, AND THE REASON IS A HEADER COLLISION.
# Measured with the ordinary global probe: 0 of 204 eligible exports emitted,
# all 204 refused as "no declaration found in Wine headers", because wininet.h
# is not in wine_sig.PROBE_SRC.  Appending it with PROBE-EXTRA does not work
# either -- the probe already includes winhttp.h (advapi32/winhttp need it) and
# the two headers cannot share a translation unit:
#
#   include/wininet.h:153: error: expected identifier
#       INTERNET_SCHEME_SOCKS, /* yes, this contradicts winhttp.h */
#   include/winhttp.h:50: note: expanded from macro 'INTERNET_SCHEME_SOCKS'
#   include/wininet.h:159: error: typedef redefinition with different types
#       ('enum INTERNET_SCHEME' vs 'int')
#
# Wine's own wininet.h says so in a comment on the offending line.  This is not
# something to work around with an #undef: the two headers genuinely describe
# two different APIs that reused the same spellings, and the only honest probe
# for THIS module's surface is one that contains THIS module's header.  So the
# translation unit is replaced rather than extended, which is exactly what
# PROBE-INCLUDE is for -- the guest surface of wininet is declared by
# windows.h + wininet.h and nothing else.
#
# Measured with it: 160 of 204 emitted, 44 refused.
PROBE-INCLUDE windows.h
PROBE-INCLUDE wininet.h

# ------------------------------------------------- the callback registration
# THE ONE HAZARD IN THIS SURFACE -- NOW SERVED, AND THE REASON IS THE SAME
# ARITHMETIC THAT USED TO EXCLUDE IT.
#
# InternetSetStatusCallbackA/W hand native wininet an INTERNET_STATUS_CALLBACK
# that wininet retains for the life of the handle and calls from its own worker
# threads -- once per resolve/connect/redirect/receive step, on a thread the
# guest never entered.  A guest function pointer stored there is x86-64 code
# reached by an ELFv2 bctrl: the same shape as the FONTENUMPROC and
# MONITORENUMPROC failures dlls/ntdll/signal_ppc64.c's override table records,
# and worse than either, because it fires asynchronously and there is no
# guest frame anywhere on the stack to blame.
#
#     typedef VOID (CALLBACK *INTERNET_STATUS_CALLBACK)(
#         HINTERNET hInternet, DWORD_PTR dwContext, DWORD dwInternetStatus,
#         LPVOID lpvStatusInformation, DWORD dwStatusInformationLength );
#
# FIVE arguments, which the original four-argument trampoline could not carry
# -- call_guest_function_args() only ever wrote RCX/RDX/R8/R9 and tail-jumped,
# so the fifth argument, which MS-x64 passes on the stack, was whatever
# happened to be there.  That fifth argument is dwStatusInformationLength, and
# it is not decoration: INTERNET_STATUS_HANDLE_CREATED, _REQUEST_COMPLETE and
# _REDIRECT all describe the SIZE of what lpvStatusInformation points at, and a
# callback that trusted a garbage length would read or copy an arbitrary
# amount of memory.  Wrapping with the four-argument trampoline would have
# turned a loud missing import into a silent wrong answer on a worker thread
# -- the single failure mode this whole registration-side mechanism exists to
# remove.
#
# THE HANDOFF this section used to describe is done: ntdll now exports
# call_guest_function_args5() and the factory __wine_guest_wrap_callback5,
# the five-argument sibling of __wine_guest_wrap_callback -- same tail-jump
# shape as the four-argument thunk, with dwStatusInformationLength
# additionally written to [rsp+0x28] before the jump, exactly where
# marshal_thunk_args() already reads a fifth stack argument from in the
# opposite direction.  dlls/comctl32/comctl32.thunks files the six-argument
# sibling for SetWindowSubclass the same way.  See dlls/wininet/guestthunk.c
# for the two GUEST-IMPL wrappers below and the RETURN-value note (the
# previously registered callback, possibly one of our own trampolines --
# same answer SetUnhandledExceptionFilter already gives on this port).
GUEST-IMPL InternetSetStatusCallbackA  __wine_guest_InternetSetStatusCallbackA
GUEST-IMPL InternetSetStatusCallbackW  __wine_guest_InternetSetStatusCallbackW

# --------------------------------------------------------------- the ceiling
# The 44 refusals are named individually in the build's --report.  Two shapes,
# both structural:
#
#   * CommitUrlCacheEntryA/W -- "argument 2 (FILETIME) is not integer/pointer
#     class".  A FILETIME is an 8-byte struct passed BY VALUE, and the
#     descriptor this port publishes describes integer and pointer slots only.
#
#   * the other 42 -- "no declaration found in Wine headers".  Every one is a
#     private entry point Wine ships in the .spec and declares in no public
#     header at all: the URL-cache container family (Create/Delete/FindFirst/
#     FindNextUrlCacheContainer*, GetUrlCacheConfigInfo*), the certificate
#     dialogs (ShowX509EncodedCertificate, ShowClientAuthCerts), and the
#     dial-up set (InternetDial, InternetGoOnline).  These are IE-internal
#     surface; nothing outside wininet has ever imported one, and inventing a
#     declaration for them here would be asserting an argument count nobody
#     can check.  They stay absent and named.
