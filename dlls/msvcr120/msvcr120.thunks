# AMD64 thunk export spec -- msvcr120.dll.
#
# WHY THIS MODULE.  The Witcher 3 GOTY's witcher3.exe statically imports
# NvCameraSDK64.dll (NVIDIA Ansel, shipped beside the exe), and that DLL
# imports MSVCP120.dll and MSVCR120.dll.  This tree built dlls/msvcr120 as a
# native ppc64 module with no AMD64 thunk, so the guest loader answered
# c000007b for both halves of the VC++ 2013 runtime and the process died in
# loader_init before main -- rc=53, nothing drawn ([MEASURED] 2026-08-19,
# first `fex nw-witcher3` launch).  The same wall DOOM hit as pdh.dll and
# Styx hit as msvcp100: an optional-looking Wine builtin a real game links
# against, invisible until a title actually does.
#
# The split follows dlls/msvcr100 exactly, and the reasons are its reasons:
# the C runtime is the half this port CAN translate, so FROM-SPEC auto emits
# every export the signature oracle can prove out of the shared ../msvcrt
# sources; msvcp120 is the MSVC C++ ABI, is refused honestly, and the
# steamtool stages Proton's own x86-64 Wine build of it into the guest
# system directory instead (ppc64le/steamtool/proton, the msvcp100 block).
#
# The mangled rows at the bottom are the same four flat-prototype memory
# operators (mangled NAME, flat SIGNATURE) plus the two symbols msvcp120's
# own DllMain resolves at PROCESS_ATTACH -- the exact set msvcr100 carries,
# re-checked against msvcr120.spec's win64 lines.

DLL msvcr120.dll
FROM-SPEC auto

INCLUDE-DIR   ../msvcrt
PROBE-EXTRA   locale.h
PROBE-EXTRA   setjmp.h
PROBE-EXTRA   sys/utime.h
PROBE-EXTRA   sys/timeb.h
PROBE-EXTRA   mtdll.h
PROBE-EXTRA   msvcrt.h
PROBE-EXTRA   mbstring.h

# ---------------------------------------------------------------------------
# 2026-08-29, guest-cxx-eh-plan Session A follow-up (adversarial review):
# the same __C_specific_handler identity bug and ExceptionObject landmine
# vcruntime140/ucrtbase carried, also live here
# ---------------------------------------------------------------------------
# msvcr120.spec:860 declares __C_specific_handler (MEASURED trap at RVA
# 0x10130 in the built msvcr120.dll) -- the exact identity-defeating shape
# the 2026-08-29 triage fixed for vcruntime140/ucrtbase: dlls/ntdll/
# signal_ppc64.c's frame walk recognises __C_specific_handler by ADDRESS
# IDENTITY against the guest ntdll's own export, so a VS2013-era /MD title
# (this module's whole reason for existing -- NvCameraSDK64.dll, see the
# banner above) whose .xdata handler resolves through THIS module's trap
# would be entered as unknown guest code and trap into native ppc64 with an
# AMD64 DISPATCHER_CONTEXT it cannot interpret.  Same fix: forward to
# ntdll's own copy.
FORWARD __C_specific_handler ntdll.__C_specific_handler

# msvcr120.spec:869-871 also declares __CxxRegisterExceptionObject/
# __CxxUnregisterExceptionObject/__DestructExceptionObject, and msvcrt.h:
# 156-158 declares them too (PROBE-EXTRA msvcrt.h, above) -- unlike this
# file's banner claim that the C++ EH personality "stays refused by design,
# same documented hole as vcruntime140", these three were never actually
# refused: FROM-SPEC auto saw the declaration and emitted ordinary native
# trap stubs, MEASURED at RVA 0x10150/0x10160/0x10170.
# __DestructExceptionObject calls the thrown object's own destructor, a
# GUEST function pointer, so a native trap means native ppc64 code
# indirect-calling x86-64 the moment any FH3/FH4 personality reaches it --
# see ucrtbase.thunks' matching correction for the full reasoning.  EXCLUDE
# makes the refusal real and diagnosable instead of an accidental callable
# stub nobody meant to serve.
EXCLUDE __CxxRegisterExceptionObject
EXCLUDE __CxxUnregisterExceptionObject
EXCLUDE __DestructExceptionObject

GUEST-IMPL   _initterm                        __wine_guest__initterm
GUEST-IMPL   _initterm_e                      __wine_guest__initterm_e

_malloc_crt                   0x0000A110  1  int   msvcr120.spec:1440

??2@YAPEAX_K@Z    0x00000C01  1  int   msvcr120.spec:336
??_U@YAPEAX_K@Z   0x00000C02  1  int   msvcr120.spec:393
??3@YAXPEAX@Z     0x00000C03  1  void  msvcr120.spec:340
??_V@YAXPEAX@Z    0x00000C04  1  void  msvcr120.spec:397

?IsCurrentTaskCollectionCanceling@Context@Concurrency@@SA_NXZ  0x00000C05  0  int   msvcr120.spec:441
?_set_new_handler@@YAP6AH_K@ZP6AH0@Z@Z                         0x00000C06  1  int   msvcr120.spec:709

# NvCameraSDK64.dll (NVIDIA Ansel, statically linked by witcher3.exe)
# imports these six on top of the auto surface, and took the DEAD000D
# sentinel through __clean_type_info_names_internal at CRT teardown --
# fatally, some seconds into every boot ([MEASURED] 2026-08-19, three
# boots, same call site NvCameraSDK64.dll+1c2c).  All six are flat
# prototypes; the C++ EH personality the same module imports
# (_CxxThrowException, __CxxFrameHandler3, __CppXcptFilter's real EH
# cousins) stays refused by design, same documented hole as
# vcruntime140.  __crtCapturePreviousContext and __crtUnhandledException
# also stay refused: both traffic in CONTEXT records, which this native
# build shapes for ppc64, not for the guest that asked.

?terminate@@YAXXZ                                              0x00000C07  0  void  msvcr120.spec:773
__CppXcptFilter                                                0x00000C08  2  int   msvcr120.spec:861
__clean_type_info_names_internal                               0x00000C09  1  void  msvcr120.spec:890
__crtTerminateProcess                                          0x00000C0A  1  void  msvcr120.spec:922
__crt_debugger_hook                                            0x00000C0B  1  void  msvcr120.spec:1089
?_type_info_dtor_internal_method@type_info@@QEAAXXZ            0x00000C0C  1  void  msvcr120.spec:719
