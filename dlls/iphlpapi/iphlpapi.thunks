# AMD64 thunk export spec -- iphlpapi.dll.
#
# 2026-08-15 second-game pass: DOOM's Vulkan build imports this and it had no
# guest thunk, so the loader found the native ppc64 module and refused it
# (c000007b), which is correct and unhelpful.  Generated from the module's own
# .spec like every other one.
DLL iphlpapi.dll
FROM-SPEC auto

# Every one of its 116 eligible exports was refused as "no declaration in any
# Wine header", so what was emitted was a real PE with NO exports: it loads,
# and every import of it binds to a missing-import sentinel.  Measured on a
# LIVE Steam launch of DOOM (2026-08-17): the game got past SteamAPI_Init for
# the first time, enumerated its network adapters, and called 0xdead001d --
# the sentinel the loader handed it for iphlpapi.dll.GetAdaptersInfo -- from
# DOOMx64vk.exe+0x32a7c2.  iphlpapi.h is not in the global probe (nothing else
# needs it), so it is appended here exactly as dbghelp appends dbghelp.h.
PROBE-EXTRA   iphlpapi.h

# icmpapi.h, for the Icmp* surface: IcmpCreateFile/IcmpSendEcho and kin are
# declared only there.  Cyberpunk 2077's REDGalaxy64.dll imports both --
# GOG Galaxy pings its endpoints -- and got sentinels.
PROBE-EXTRA   icmpapi.h

# netioapi.h, for the NET_LUID / MIB_IF_ROW2 surface.  Valve's own Windows
# steamclient64.dll imports ConvertInterfaceGuidToLuid (iphlpapi.spec:16,
# declared netioapi.h:260) and GetIfEntry2 (spec:91, netioapi.h:276) --
# Steam enumerates network interfaces at startup.  Both are ordinary
# declarations Wine already implements; neither header above pulls netioapi.h
# in, so the oracle answered "no declaration in any Wine header" for the pair
# and they were the only iphlpapi holes in that DLL.
#
# [MEASURED 2026-08-30] import_chain.py over
# ~/.local/share/Steam/steamclient64.dll: 476 imports, 3 holes, two of them
# these.  That matters because staging Valve's real steamclient into a native
# prefix -- which is how Proton satisfies the SteamStub, and how Civ VI and
# Oblivion Remastered would get past "Application load error 3:..." -- needs
# the DLL to actually load first.
PROBE-EXTRA   netioapi.h
