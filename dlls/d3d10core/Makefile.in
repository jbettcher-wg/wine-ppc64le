# The native ppc64le D3D10 lane, over DXVK's d3d10core.  Every export forwards
# into d3d11.dll; d3d10core_main.c is Wine's own forwarder over its d3d11 and
# is left in the tree unbuilt, for the reason dlls/d3d11/Makefile.in gives.
MODULE    = d3d10core.dll
IMPORTLIB = d3d10core

VER_FILEDESCRIPTION_STR = "Wine D3D10 Core"
VER_PRODUCTVERSION      = 6,0,6000,16386

SOURCES = \
	d3d10core.thunks
