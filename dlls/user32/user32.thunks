# AMD64 thunk export spec -- user32.dll.
#
# Export list from user32.spec; the oracle refuses what it cannot prove
# (struct-by-value like MonitorFromPoint, float arguments) and those exports
# are simply absent -- a guest import of one binds to a per-symbol sentinel.
# This file carries only the overrides the .spec cannot express.
DLL user32.dll
FROM-SPEC auto

# True variadic: forwarded to its own v-variant with a synthesised va_list.
wsprintfW          0x0000A005  2  int   winuser.h:4745  variadic=wvsprintfW
wsprintfA          0x0000A006  2  int   winuser.h:4744  variadic=wvsprintfA
