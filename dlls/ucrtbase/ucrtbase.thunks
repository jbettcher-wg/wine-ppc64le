# AMD64 thunk export spec -- ucrtbase.dll.
#
# ---------------------------------------------------------------------------
# GUEST ARGUMENT REGISTERS AT THE TRAP  (load-bearing ABI -- read this)
# ---------------------------------------------------------------------------
# x86-64 SYSCALL architecturally writes the address of the following
# instruction into RCX and RFLAGS into R11.  RCX is MS-x64's FIRST argument
# register, so a bare `0f 05` stub destroys arg0 before the host can see it.
# (Measured: a trap in GetModuleHandleW arrived with rcx = RIP+2.)  Each trap
# stub therefore rescues arg0 first, the same trick the Linux syscall ABI uses
# for its own 4th argument:
#
#       49 89 ca    mov r10, rcx      ; arg0 out of the way
#       0f 05       syscall           ; free to clobber rcx/r11
#       cc ...      int3 padding to the 16-byte stride
#
# So the host-visible argument registers are:
#
#       arg0 -> R10   (rescued from RCX -- NOT RCX)
#       arg1 -> RDX
#       arg2 -> R8
#       arg3 -> R9
#       arg4+ -> [RSP + 8 + i*8]   (past the pushed return address and the
#                                   32-byte shadow space)
#
# The trapping RIP is  stubs_rva + index*stride + trap_off  (trap_off = 3 in
# trap mode, 0 in direct mode), published in __wine_thunk_info -- do not infer
# it from the stub bytes.
#
# Note that every export here is __cdecl, not __stdcall.  That changes nothing
# above: MS-x64 has a single calling convention and the decoration is inert on
# this target.  It does mean the CALLER cleans the stack, so a wrong nargs is
# not self-correcting the way a stdcall mistake would be -- it just corrupts
# the guest's stack.  Hence the same rule as kernel32.thunks: the columns are
# assertions checked against Wine's headers, never hand-tuned to pass.
#
# ---------------------------------------------------------------------------
# The order of the export lines below IS the stub index order and is part of
# the ABI: the host-side dispatcher uses it.  Append only, never reorder.
#
# Columns:
#   <ExportName>  <imm32 returned by --body=direct>  <nargs>  <int|void>  <header>:<line>
#
# The last three columns are ASSERTIONS, not inputs.  gen_thunk_pe.py re-reads
# each declaration out of Wine's own headers with clang and hard-fails if this
# file disagrees.  Wine .spec files are NOT usable for this: they carry no
# return type at all and their ARG_LONG is 32 bits.  dlls/ucrtbase/ucrtbase.spec
# was used only to confirm these nine names really are ucrtbase exports; every
# signature below comes from include/msvcrt/.
#
DLL ucrtbase.dll

# Export list from ucrtbase.spec; the lines below become overrides.
# See kernel32.thunks.
FROM-SPEC auto

# indices 0..1: the __p_* accessors.  No arguments, and the return is a
# pointer to the CRT's real variable, so the guest dereferences host memory
# directly -- nothing to marshal.
__p___argc                    0x00000A01  0  int   stdlib.h:93
__p___wargv                   0x00000A02  0  int   stdlib.h:95

# index 2: the one export here with a va_list.
#   int __stdio_common_vswprintf(unsigned __int64 options, wchar_t *buffer,
#                                size_t count, const wchar_t *format,
#                                _locale_t locale, va_list arglist)
# This is NOT variadic itself -- the caller already built the va_list -- so it
# is six ordinary 64-bit arguments.  The va_list travels through untouched:
# MS-x64 va_list is `char *` into a contiguous run of 8-byte argument slots
# (the callee homes RCX/RDX/R8/R9 into the shadow space) and ppc64le ELFv2
# va_list is likewise a bare pointer into the parameter save area.  Measured
# on the AC922, not assumed -- see the long comment in wine_sig.py.
__stdio_common_vswprintf      0x00000A03  6  int   corecrt_wstdio.h:92

# indices 3..6: the CRT startup sequence a real mainCRTStartup walks.
# _crt_argv_mode and _crt_app_type are plain enums (corecrt_startup.h:31,38),
# so they are integer class and pass in a register like any other int.
# errno_t is a typedef for int (corecrt.h).
_configure_wide_argv          0x00000A04  1  int   corecrt_startup.h:58
_get_initial_wide_environment 0x00000A05  0  int   corecrt_startup.h:63
_initialize_wide_environment  0x00000A06  0  int   corecrt_startup.h:68
_set_app_type                 0x00000A07  1  void  corecrt_startup.h:70

# index 7: exit is declared __attribute__((noreturn)).  The descriptor has no
# bit for that and does not need one -- the host implementation simply never
# returns to the dispatcher.
exit                          0x00000A08  1  void  stdlib.h:223

# index 8: plain string compare, three integer/pointer arguments.
wcsncmp                       0x00000A09  3  int   corecrt_wstring.h:66

# ---------------------------------------------------------------------------
# indices 9..30: the ucrtbase half of programs/winepath.exe's import table
# (guest-corpus/imports/programs/winepath.txt).  The seven names winepath also
# imports that are already above -- __p___argc, __p___wargv,
# _configure_wide_argv, _get_initial_wide_environment,
# _initialize_wide_environment, _set_app_type, exit -- are NOT repeated.
#
# All 22 are clang-verified against include/msvcrt/.  _setmode needed
# include/msvcrt/io.h added to wine_sig.py's PROBE_SRC (it is declared in
# corecrt_io.h, which nothing already in the probe pulled in), and the four
# size_t-returning entries -- fwrite, strcspn, strlen, wcslen -- needed the
# clang-predefined-sugar respelling added to wine_sig.py; see the SUGAR_SPELLING
# note there.  Neither change relaxes a check.
# ---------------------------------------------------------------------------

# index 9: __acrt_iob_func(i) -> &__iob[i], the real FILE* for stdin/stdout/
# stderr.  The returned FILE* is HOST memory the guest only ever hands back to
# other CRT exports (fwrite, _fileno); it never dereferences it itself.
__acrt_iob_func               0x00000A0A  1  int   corecrt_wstdio.h:48

# indices 10..11: the narrow-char siblings of __stdio_common_vswprintf at
# index 2, and the same va_list reasoning applies -- the CALLER built the
# va_list, so these are 5 and 6 ordinary 64-bit slots, not variadics.
# Measured end-to-end on the AC922: a guest-built MS-x64 va_list was consumed
# correctly by native ppc64 formatting ("%d-%s-%d" -> "4242-AB-77").
__stdio_common_vfprintf       0x00000A0B  5  int   stdio.h:158
__stdio_common_vsprintf       0x00000A0C  6  int   stdio.h:160

# index 12: _crt_atexit takes _PVFV, a GUEST function pointer, and only
# RECORDS it -- the call happens at exit() time.  Same host->guest callback
# hazard as _initterm below, deferred rather than immediate.
_crt_atexit                   0x00000A0D  1  int   corecrt_startup.h:60

_fileno                       0x00000A0E  1  int   stdio.h:80

# ---------------------------------------------------------------------------
# indices 13..14: KNOWN LATENT HAZARD -- host->guest callback.
# _initterm(_PVFV *first, _PVFV *last) and _initterm_e(_PIFV *, _PIFV *) walk
# an array of FUNCTION POINTERS and CALL each non-NULL entry.  Those pointers
# point at GUEST x86-64 code, so the native ppc64 implementation would branch
# into x86-64 bytes and die.  We cannot do host->guest calls yet.
# They are emitted anyway because the common case -- and winepath's case -- is
# an EMPTY initialiser array (first == last), where neither function calls
# anything and both are pure no-ops.  A guest with real C++ static
# constructors or /GS-style initialisers WILL crash here.  Fix is a real
# host->guest call path, not a change to this descriptor: the descriptor is
# correct, the callback is what is missing.
# ---------------------------------------------------------------------------
_initterm                     0x00000A0F  2  void  corecrt_startup.h:29
_initterm_e                   0x00000A10  2  int   corecrt_startup.h:30

_setmode                      0x00000A11  2  int   corecrt_io.h:137

# indices 16..18: the allocator trio.  _strdup's declaration carries
# __WINE_MALLOC (a MacroQualifiedType), which changes nothing about its shape:
# one pointer argument, char* return.  Same situation as kernel32's HeapAlloc.
_strdup                       0x00000A12  1  int   string.h:26
free                          0x00000A13  1  void  corecrt_malloc.h:30
malloc                        0x00000A14  1  int   corecrt_malloc.h:31

# index 19: fwrite returns size_t -- 64 bits on this target, so it fits the
# single-slot return.  4 args (buf, size, count, FILE*).
fwrite                        0x00000A15  4  int   stdio.h:136

getenv                        0x00000A16  1  int   stdlib.h:224
memmove                       0x00000A17  3  int   corecrt_wstring.h:31
putchar                       0x00000A18  1  int   stdio.h:142
puts                          0x00000A19  1  int   stdio.h:143

# indices 24..29: plain string primitives.  strcspn/strlen/wcslen return
# size_t; the rest return int or char*.
strchr                        0x00000A1A  2  int   string.h:50
strcmp                        0x00000A1B  2  int   string.h:51
strcpy                        0x00000A1C  2  int   string.h:53
strcspn                       0x00000A1D  2  int   string.h:55
strlen                        0x00000A1E  1  int   string.h:57
wcslen                        0x00000A1F  1  int   corecrt_wstring.h:63

# _initterm walks a table of the CALLER's initializers.  For a guest caller
# those entries are x86-64 code and this walker is ppc64, so the guest import
# is redirected to a form that wraps each entry as it is reached.  A callback
# mask cannot express this: the argument is a pointer to an ARRAY of function
# pointers, not a function pointer.
GUEST-IMPL   _initterm                        __wine_guest__initterm
GUEST-IMPL   _initterm_e                      __wine_guest__initterm_e

# _lock/_unlock are exported by this module but declared only in its private
# mtdll.h, so the oracle refused them as "no declaration in any Wine header"
# and a game's SDL2.dll got a sentinel for them at PROCESS_ATTACH.
# PROBE-EXTRA appends to the oracle's default translation unit rather than
# replacing it, which is what a module needs when its surface is in Wine's
# public headers AND in a private header of its own.
INCLUDE-DIR   ../msvcrt
PROBE-EXTRA   mtdll.h
PROBE-EXTRA   msvcrt.h        # _amsg_exit, __dllonexit

# ---------------------------------------------------------------------------
# The 2026-08-17 DOOM triage: the CRT surface MICROSOFT'S mfc140u.dll imports
# ---------------------------------------------------------------------------
# DOOM (2016) loads Razer's CChromaEditorLibrary.dll, which pulls in
# Microsoft's real mfc140u.dll.  That is a native x86-64 PE, so a guest image,
# so its imports bind here -- and its api-ms-win-crt-* imports are apiset names
# that resolve to this module in the guest namespace.  Eighteen of them were
# ordinal holes and got ntdll's sentinel.
#
# Fifteen were the MULTIBYTE string surface, refused as "no declaration in any
# Wine header" for the same tooling reason _lock and _unlock were: they are
# declared in include/msvcrt/mbstring.h, which nothing already in the oracle's
# translation unit pulls in.  One PROBE-EXTRA serves all fifteen and the rest
# of _mbs* with them -- the header declares the whole family, so broadening it
# costs nothing and is strictly more of this module's real surface.
PROBE-EXTRA   mbstring.h      # _mbschr, _mbsstr, _ismbcspace, ... (the _mbs* family)

# The last two Wine declares in NO header, so they take the .spec location
# column -- the documented downgrade, where <int|void> becomes an unchecked
# human assertion.  Both are justified against the implementation they reach:
#   _resetstkoflw    dlls/msvcrt/misc.c:407 -- int CDECL (void).
#   _seh_filter_dll  forwards to __CppXcptFilter (ucrtbase.spec:1882), an
#                    exception filter, so int (the EXCEPTION_* disposition).
# ldiv IS DELIBERATELY LEFT A HOLE.  mfc140u imports it, but it returns ldiv_t
# BY VALUE and the descriptor has no way to say that: a return is one 64-bit
# slot or it is refused.  ldiv_t happens to be exactly 8 bytes of two integers
# and both ABIs would in fact hand it back in one register, but that is an
# aggregate-return rule this generator does not model, and inventing a
# descriptor that is right by coincidence is the one thing this file must not
# do.  Nothing on mfc140u's load path calls it (measured -- the module
# initialises and its exports run); a guest that does gets the named sentinel.
_resetstkoflw                 0x00000A20  0  int   ucrtbase.spec:1871
_seh_filter_dll               0x00000A21  2  int   ucrtbase.spec:1882

# ---------------------------------------------------------------------------
# The 2026-08-19 Cyberpunk 2077 triage: the C++ helpers that ARE flat
# ---------------------------------------------------------------------------
# The game's icuuc/icuin/libxess import __RTtypeid, __RTDynamicCast and the
# __std_* family from vcruntime140.dll; the staged (Wine-built) vcruntime140
# is a forwarder into this module, and this module refused them all as "no
# declaration found in Wine headers" -- the same tooling gap as mtdll.h
# above, fixed the same way.  thunkcxx.h (beside this file) carries flat
# C declarations for exactly the helpers whose success path is data-only,
# and says in its own comment why _CxxThrowException, __CxxFrameHandler3 and
# __unDNameEx are deliberately not in it.
INCLUDE-DIR   .
PROBE-EXTRA   thunkcxx.h

# div returns div_t BY VALUE, so the header oracle refuses it ("return is not
# integer/pointer class") and icuin.dll got a sentinel.  The .spec-location
# row bypasses that check soundly here: div_t is {int quot; int rem;} -- eight
# bytes, packed identically on both little-endian ABIs -- and both sides
# return it in their one integer return register (RAX / r3), which is exactly
# the single slot the descriptor's `int` return already carries.  The .spec
# line is `-ret64` for the same reason.  Arguments are two ints, integer
# class, nothing to marshal.
div                       0x00000D1F  2  int   ucrtbase.spec:2272

# ---------------------------------------------------------------------------
# The 2026-08-22 Quake II triage (S4): setjmp/longjmp are GUEST code
# ---------------------------------------------------------------------------
# quake2ex_steam.exe imports VCRUNTIME140.__intrinsic_setjmp / .longjmp,
# which Wine's x86-64 vcruntime140 (staged Proton's included) forwards to
# THIS module -- and this module refused both ("no declaration found in Wine
# headers"), so the forward failed at load and the first setjmp call died on
# sentinel 0xDEAD0007.  Every id-engine title stops there; structural.
#
# A trap stub can NEVER serve these: setjmp's contract is the GUEST's own
# register file and stack pointer, and a trap out to native ppc64
# _setjmp/longjmp would save the wrong machine's registers -- the same
# register-contract class as __chkstk (RAW_BODY_EXPORTS), but ~100 bytes of
# code, which no 16-byte stub slot holds.  So the real x86-64 implementation
# lives in the guestpe-built dlls/guestcrt/guestcrt.dll (see its setjmp.c
# for the layout proofs and the unwinding limitation), and these two exports
# are PE FORWARDERS the guest loader follows itself.
#
# __intrinsic_setjmpex and `setjmp` (the -private x64 alias) are DELIBERATELY
# NOT forwarded: their contract is the unwinding variant, guestcrt.dll's
# longjmp never unwinds (Frame is stored as 0 -- see setjmp.c's banner), and
# serving them non-unwinding would be a silent downgrade for exactly the
# callers that asked for unwinding.  They stay holes: named, diagnosable
# sentinels, until real guest-side unwinding exists.
FORWARD __intrinsic_setjmp guestcrt.__intrinsic_setjmp
FORWARD longjmp            guestcrt.longjmp

# ---------------------------------------------------------------------------
# The 2026-08-29 guest-cxx-eh-plan Session A triage: the throw half, a mis-
# served language handler, and the flat thread-state accessors it needs
# ---------------------------------------------------------------------------
# game_x64.dll (Quake II's 2023 remaster) and libxess*.dll (Cyberpunk's XeSS)
# both statically import VCRUNTIME140._CxxThrowException and
# VCRUNTIME140.__C_specific_handler, which vcruntime140.spec:2/13 forward to
# THIS module (see vcruntime140.thunks for the matching FORWARD lines it
# grew the same day).  Two of the four names below are themselves forwards;
# the other two are ordinary data-only traps.
#
#   * _CxxThrowException forwards on to the real x86-64 code in
#     dlls/guestcrt/cxxthrow.c -- see that file's banner for the full
#     contract and why a trap can never serve it (it would raise the
#     exception over the HOST's native stack, and the dispatcher's search
#     phase would then never reach a guest language handler at all).
#
#   * __C_specific_handler forwards to ntdll's own copy rather than being
#     served by THIS module's real (but differently-addressed) native
#     implementation.  dlls/ntdll/signal_ppc64.c's frame walk recognises
#     __C_specific_handler by ADDRESS IDENTITY against the guest ntdll's own
#     export (guest_c_specific_handler_addr()); any other address -- ucrtbase
#     exports its own working native implementation at ucrtbase.spec:51, but
#     at a DIFFERENT guest address -- fails that check and gets entered as
#     unknown guest code instead, where it would trap into native ppc64 with
#     an AMD64 DISPATCHER_CONTEXT it cannot interpret.  Forwarding here means
#     every route into this name -- straight from a guest's VCRUNTIME140
#     import, or through this module directly -- ends at the one address the
#     identity check actually recognises.
#
#   * __processing_throw needed no new declaration at all: msvcrt.h already
#     declares it (PROBE-EXTRA msvcrt.h, below, has carried it into this
#     oracle's view since the 2026-08-17 DOOM triage) and thunkcxx.h says why
#     it belongs conceptually with the other flat accessors even though it
#     lives in the other header -- it hands back a POINTER into native
#     thread-local data, exactly like __current_exception/
#     __current_exception_context already do, so the guest FH3/FH4
#     personality that will eventually read and write through it needs no
#     host->guest call to do so.  It only ever lacked a ROW here; the oracle
#     could already see it.
#
#   * _CreateFrameInfo and _FindAndUnlinkFrame only link and unlink a node in
#     a list rooted in native thread-local data (msvcrt_get_thread_data()'s
#     frame_info_head); _IsExceptionObjectToBeDestroyed only walks that same
#     list comparing pointers.  None of the three ever calls a guest function
#     pointer, so -- unlike __CxxRegisterExceptionObject/
#     __CxxUnregisterExceptionObject/__DestructExceptionObject, which DO (the
#     last one calls the thrown object's own destructor) -- a trap is the
#     correct, not merely convenient, answer for these three.
#     _CreateFrameInfo was already declared in msvcrt.h; the other two were
#     exported by this module's .spec but declared in no header at all (the
#     same tooling gap _lock/_unlock hit), so msvcrt.h grew their
#     declarations too rather than falling back to the .spec-location
#     downgrade -- both are ordinary two-argument-or-fewer pointer/int
#     functions with nothing a header-based check would catch less of.
#
# CORRECTION, 2026-08-29 (same day, caught by adversarial review before this
# reached anywhere else): this paragraph originally claimed the three
# ExceptionObject names above "stay holes here pending guest-cxx-eh-plan.md's
# Session B support file".  That was FALSE from the moment it was written,
# and stayed false until the EXCLUDE lines below were added.  msvcrt.h:156-
# 158 declares all three (the pre-existing lines immediately below the block
# this triage added to that header), and FROM-SPEC auto has no way to know a
# declared name is meant to stay guest-only pending a later session -- it saw
# the declaration and emitted all three as ordinary native trap stubs,
# MEASURED in the built ucrtbase.dll at RVA 0x1c0c0/0x1c0d0/0x1c0e0 and in
# vcruntime140.dll at 0x2030/0x2040/0x2050.  A trap is wrong here for exactly
# the reason __DestructExceptionObject is singled out above: it calls the
# thrown object's OWN destructor, a GUEST x86-64 function pointer read out of
# the ThrowInfo, so a native trap means native ppc64 code indirect-calling an
# x86-64 address the moment any FH3/FH4 personality reaches it -- the same
# "silent wrong answer" class this file's __C_specific_handler paragraph and
# dlls/guestcrt/cxxthrow.c's own banner both warn about.  Nothing reached it
# before this correction (FH4 is a genuine sentinel today), so it was a
# mis-documented armed landmine, not yet an active regression -- but this
# whole triage's safety story rested on a false premise until now.  EXCLUDE
# makes the refusal REAL rather than assumed: dropped from FROM-SPEC auto's
# list, so ntdll binds each to its own named 0xDEADnnnn sentinel instead of a
# callable stub -- a diagnosable refusal, exactly what "no declaration at
# all" gets, not a trap that happens to go unused today.  Also corrected: the
# "staged Proton vcruntime140/vcruntime140_1" framing this triage used
# elsewhere in this file and in vcruntime140_1.thunks does not describe a
# real mechanism -- dlls/ntdll/loader.c's guest module resolution
# (find_dll_file's machine_dir branch, ~3540-3565) tries the BUILTIN thunk
# before the ordinary search path a prefix-staged file would be found on, so
# a same-named builtin thunk always wins and a staged file is never reached
# for an unqualified import.  What this fix (and the __processing_throw row
# above) actually serves is the BUILTIN vcruntime140_1 thunk's own FH4 code,
# in every prefix, staged files or not.  All five modules that export this
# trio -- this one, vcruntime140, msvcrt, msvcr100, msvcr120 -- carried the
# identical live-trap landmine and grew the matching EXCLUDE lines the same
# day.
FORWARD _CxxThrowException   guestcrt._CxxThrowException
FORWARD __C_specific_handler ntdll.__C_specific_handler

EXCLUDE __CxxRegisterExceptionObject
EXCLUDE __CxxUnregisterExceptionObject
EXCLUDE __DestructExceptionObject

__processing_throw              0x00000E01  0  int   msvcrt.h:161
_CreateFrameInfo                0x00000E02  2  int   msvcrt.h:147
_FindAndUnlinkFrame             0x00000E03  1  void  msvcrt.h:154
_IsExceptionObjectToBeDestroyed 0x00000E04  1  int   msvcrt.h:155
