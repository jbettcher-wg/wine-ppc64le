# AMD64 thunk export spec -- vcruntime140.dll.
#
# Added from the 2026-08-15 first-real-game triage: with the application's own
# shipped DLLs now loadable (find_dll_file() searches the load path for the
# guest's machine instead of refusing it outright), what stopped
# quake2ex_steam.exe was Wine builtins with no guest thunk -- each reported as
# c000007b, the loader correctly refusing to splice a native ppc64 module into
# a guest call.  Nothing here is hand-written: the export list comes from this
# module's own .spec.
DLL vcruntime140.dll
FROM-SPEC auto

# ---------------------------------------------------------------------------
# The 2026-08-17 DOOM triage: hosting MICROSOFT'S OWN vcruntime CLIENTS
# ---------------------------------------------------------------------------
# DOOM (2016) loads Razer's CChromaEditorLibrary.dll, which pulls in
# Microsoft's real mfc140u.dll -- a NATIVE x86-64 PE, so a guest image, so
# every one of its imports has to be served from this machine's thunk surface.
# Six of the VCRUNTIME140 names it imports were refused here as "no declaration
# found in Wine headers" and became ordinal HOLES; the guest loader bound
# ntdll's sentinel to each, and mfc140u's DllMain called the first of them --
# __vcrt_InitializeCriticalSectionEx -- straight into 0xDEAD0001.
#
# The gap was tooling, not ABI.  Wine implements all six; it just declares them
# in private headers or in no header at all.  So:
#
#   * _purecall comes from dlls/msvcrt/msvcrt.h via PROBE-EXTRA, exactly the
#     way ucrtbase.thunks already gets _lock/_unlock/_amsg_exit.  That is a
#     real clang-checked declaration, not an assertion.
#
#   * the other four use the .spec location column, the documented downgrade
#     for an export Wine declares in NO header.  A .spec pins the arity and the
#     argument classes but carries no return type, so the <int|void> column
#     below is an unchecked human assertion.  Each is justified against the
#     implementation it forwards to, named here so the claim can be rechecked:
#       _CxxThrowException            dlls/msvcrt/cppexcept.h:149 -- WINAPI,
#                                     DECLSPEC_NORETURN, (void*, const
#                                     cxx_exception_type*).  "void" for the
#                                     same reason exit() is void in
#                                     ucrtbase.thunks: it never returns to the
#                                     dispatcher at all.
#       __std_terminate               forwards to ucrtbase.terminate (see
#                                     ucrtbase.spec:147), which is noreturn.
#       __std_type_info_destroy_list  dlls/msvcrt/cpp.c:1071 --
#                                     void CDECL (SLIST_HEADER *).
#       __vcrt_InitializeCriticalSectionEx
#                                     dlls/vcruntime140/misc.c:46 --
#                                     BOOL CDECL (CRITICAL_SECTION*, DWORD,
#                                     DWORD).  BOOL is int class.
#
# __CxxFrameHandler3 IS DELIBERATELY LEFT A HOLE, and must stay one.  It is not
# an API the guest calls; it is the LANGUAGE PERSONALITY ROUTINE named by the
# guest image's own .pdata/UNWIND_INFO, invoked BY the unwinder with that
# image's exception and context records and expected to walk that image's
# funclet tables and resume in its code.  Thunking it would send a guest's
# unwind into the host's ppc64 __CxxFrameHandler, which has neither the guest's
# frame layout nor any way to resume x86-64 execution -- a silent wrong answer
# where the hole is a named, diagnosable sentinel.  Serving it needs a real
# guest-side EH personality, not an export line.  Nothing on mfc140u's LOAD
# path reaches it (measured: the module now initialises and its exports call),
# and a guest that actually throws C++ across this boundary must fail loudly.
INCLUDE-DIR   ../msvcrt
PROBE-EXTRA   msvcrt.h        # _purecall

_CxxThrowException                 0x00000B01  2  void  vcruntime140.spec:2
__std_terminate                    0x00000B02  0  void  vcruntime140.spec:42
__std_type_info_destroy_list       0x00000B03  1  void  vcruntime140.spec:44
__vcrt_InitializeCriticalSectionEx 0x00000B04  3  int   vcruntime140.spec:55

# ---------------------------------------------------------------------------
# The 2026-08-22 Quake II triage (S4): setjmp/longjmp -- forwards, like
# Wine's own .spec
# ---------------------------------------------------------------------------
# quake2ex_steam.exe statically imports __intrinsic_setjmp and longjmp from
# THIS module and died on sentinel 0xDEAD0007 the moment it called the
# first.  Both are register-contract exports no trap stub can carry (the
# stub would save native ppc64 registers, not the guest's -- see
# dlls/guestcrt/setjmp.c), so this thunk forwards them exactly where
# vcruntime140.spec:35/75 already forwards them: ucrtbase, whose own thunk
# forwards on to the real x86-64 code in guestcrt.dll.  Keeping the
# spec's own hop (rather than jumping straight to guestcrt) means every
# CRT-family thunk that grows these names forwards to ONE place, and the
# chain is the same one a prefix-staged Proton vcruntime140 takes -- so
# both mixes resolve identically.
#
# __intrinsic_setjmpex stays a deliberate hole for the reason named in
# ucrtbase.thunks: it is the unwinding variant, and guestcrt's longjmp
# never unwinds.
FORWARD __intrinsic_setjmp ucrtbase.__intrinsic_setjmp
FORWARD longjmp            ucrtbase.longjmp
