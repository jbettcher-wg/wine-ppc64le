EXTRADEFS = -DXAUDIO2_VER=8
MODULE    = xaudio2_8.dll
IMPORTLIB = xaudio2_8
IMPORTS   = $(FAUDIO_PE_LIBS) advapi32 ole32 user32 uuid winecom
EXTRAINCL = $(FAUDIO_PE_CFLAGS)
PARENTSRC = ../xaudio2_7

SOURCES = \
	xaudio2_8.thunks \
	guestcom.c \
	x3daudio.c \
	xapo.c \
	xapofx.c \
	xaudio_allocator.c \
	xaudio_classes.idl \
	xaudio_dll.c
