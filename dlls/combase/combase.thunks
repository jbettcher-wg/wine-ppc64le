# AMD64 thunk export spec -- combase.dll.
#
# Greedy-cover module from the 2026-08-14 triage worklist: with combase,
# ole32, advapi32, oleaut32 and gdi32 present as guest thunk builtins, 101
# more of the 344 corpus tests become loadable.  Exports the oracle refuses
# (struct-by-value, float, no declaration) are absent and bind to a named
# per-symbol sentinel -- loadability first, surface closes from the data.
DLL combase.dll
FROM-SPEC auto

# --- system-COM interface roster + the flat-surface interception ---
# (hangover-ppc64le/docs/system-com-design.md).  COM-JSON adds the
# per-interface vtable stub arrays and __wine_com_thunk_info; the guest
# gets proxies whose vtables are AMD64 trap stubs, dispatched by native
# combase's __wine_com_dispatch.  Every flat export whose signature
# carries an interface pointer is classified below; the build-time audit
# (spec2thunk) FAILS if any is left to pass through silently.
COM-JSON  ../../ppc64le/syscom/interfaces_syscom.json

# vending wrappers: translate/wrap interface pointers at the boundary
GUEST-IMPL   CoCreateInstance                 __wine_guest_CoCreateInstance
GUEST-IMPL   CoGetClassObject                 __wine_guest_CoGetClassObject
GUEST-IMPL   CoGetMalloc                      __wine_guest_CoGetMalloc
GUEST-IMPL   CreateStreamOnHGlobal            __wine_guest_CreateStreamOnHGlobal
GUEST-IMPL   GetHGlobalFromStream             __wine_guest_GetHGlobalFromStream

# refused loudly (E_NOTIMPL) until their wrapper/walker lands -- never
# a pass-through that would hand the guest a native vtable
GUEST-REFUSE CoCopyProxy
GUEST-REFUSE CoCreateFreeThreadedMarshaler
GUEST-REFUSE CoCreateInstanceEx
GUEST-REFUSE CoCreateInstanceFromApp
GUEST-IMPL   CoDisconnectObject               __wine_guest_CoDisconnectObject
GUEST-IMPL   CoGetCallContext                 __wine_guest_CoGetCallContext
GUEST-REFUSE CoGetInstanceFromFile
GUEST-REFUSE CoGetInstanceFromIStorage
GUEST-REFUSE CoGetInterfaceAndReleaseStream
GUEST-REFUSE CoGetMarshalSizeMax
GUEST-IMPL   CoGetObjectContext               __wine_guest_CoGetObjectContext
GUEST-REFUSE CoGetStandardMarshal
GUEST-IMPL   CoIsHandlerConnected             __wine_guest_CoIsHandlerConnected
GUEST-IMPL   CoLockObjectExternal             __wine_guest_CoLockObjectExternal
GUEST-IMPL   CoMarshalHresult                 __wine_guest_CoMarshalHresult
GUEST-REFUSE CoMarshalInterThreadInterfaceInStream
GUEST-REFUSE CoMarshalInterface
GUEST-REFUSE CoQueryProxyBlanket
GUEST-REFUSE CoRegisterClassObject
GUEST-REFUSE CoReleaseMarshalData
GUEST-IMPL   CoSetProxyBlanket                __wine_guest_CoSetProxyBlanket
GUEST-REFUSE CoSwitchCallContext
GUEST-IMPL   CoUnmarshalHresult               __wine_guest_CoUnmarshalHresult
GUEST-REFUSE CoUnmarshalInterface
GUEST-IMPL   CreateErrorInfo                  __wine_guest_CreateErrorInfo
# The Co-prefixed spellings are .spec ALIASES of the three ErrorInfo exports
# refused above; they became emittable when spec2thunk learned to take an
# alias's signature from its target, and the same refusal applies for the
# same reason.
GUEST-IMPL   CoCreateErrorInfo                __wine_guest_CreateErrorInfo
GUEST-IMPL   CoGetErrorInfo                   __wine_guest_GetErrorInfo
GUEST-IMPL   CoSetErrorInfo                   __wine_guest_SetErrorInfo
GUEST-REFUSE DllGetClassObject
GUEST-IMPL   FreePropVariantArray             __wine_guest_FreePropVariantArray
GUEST-IMPL   GetErrorInfo                     __wine_guest_GetErrorInfo
GUEST-IMPL   PropVariantClear                 __wine_guest_PropVariantClear
GUEST-IMPL   PropVariantCopy                  __wine_guest_PropVariantCopy
GUEST-REFUSE RoGetAgileReference
GUEST-IMPL   SetErrorInfo                     __wine_guest_SetErrorInfo
