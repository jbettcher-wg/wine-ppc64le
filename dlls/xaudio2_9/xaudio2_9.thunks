# AMD64 thunk export spec for the guest xaudio2_9.dll -- COM mode.
#
# Read dlls/dsound/dsound.thunks first: this is the same arrangement -- a
# NATIVE Wine implementation (xaudio_dll.c over FAudio) served to an emulated
# x86-64 guest through libs/winecom -- with the two complications XAudio2 adds,
# both of which dlls/xaudio2_7/guestcom.c explains at length:
#
#   * four of the six rostered interfaces are `[local]` and NOT
#     IUnknown-derived, so the native module claims them in its own
#     __wine_com_dispatch before libs/winecom can serve their slot 0 as
#     QueryInterface;
#   * a voice is destroyed by DestroyVoice, not by Release.
#
# WHY A ROSTER PER VERSION.  IXAudio2's IID and two of its method lists are
# version-conditional, so each version is a DIFFERENT roster and needs its own
# generated pair.  2_9 is the one modern titles link.  xaudio2_8 was the
# mechanical repeat this banner used to describe as future work and it is now
# DONE -- dlls/xaudio2_8/xaudio2_8.thunks, its own
# ppc64le/audio/interfaces_xaudio2_8.json and its own xaudio2_marshal.h.  The
# code behind both is one file, dlls/xaudio2_7/guestcom.c, reached from here
# and from 2_8 through PARENTSRC: the two rosters come out the same SHAPE (8
# interfaces, 115 slots), so only the TABLES differ and a second copy of 609
# lines would only have drifted.  xaudio2_7 is NOT mechanical: it exports
# no creator at all, so a 2.7 guest reaches XAudio2 through
# CoCreateInstance(CLSID_XAudio2_7), which lands in COMBASE's winecom instance
# -- a different instance with a different roster, in which IXAudio2 does not
# appear.  It is refused loudly at that end (E_NOINTERFACE with the IID named)
# and it needs the XAudio2 family added to ppc64le/syscom/interfaces_syscom.json
# rather than anything here.

DLL       xaudio2_9.dll
FROM-SPEC auto
COM-JSON  ../../ppc64le/audio/interfaces_xaudio2_9.json

# The oracle's default translation unit has neither xaudio2.h nor x3daudio.h,
# and without them every export of this module would be refused for having no
# declaration -- which is exactly the state x3daudio1_7.dll was in.
PROBE-EXTRA xaudio2.h
PROBE-EXTRA x3daudio.h
# xaudio2fx.h declares CreateAudioReverb and CreateAudioVolumeMeter;
# xaudio2_flat_surface.h declares CreateFX, which Wine ships and no Wine
# header declares (see that file, and dlls/xapofx1_5/xapofx1_5.thunks
# where the same finding was first written down).  Without these three
# the XAPO factories below are refused as "no declaration found in Wine
# headers" and the GUEST-IMPL lines naming them fail the flat-surface
# audit -- which is exactly how this was found.
PROBE-EXTRA xaudio2fx.h
PROBE-EXTRA xaudio2_flat_surface.h
INCLUDE-DIR ../xaudio2_7

GUEST-IMPL XAudio2Create                 __wine_guest_XAudio2Create
GUEST-IMPL XAudio2CreateWithVersionInfo  __wine_guest_XAudio2CreateWithVersionInfo

# The three XAPO factories, SERVED now rather than excluded.  They used to be
# EXCLUDEd -- a guest asking for a reverb bound the per-symbol 0xdead0000
# sentinel and faulted by name -- because they vend the effect as
# `IUnknown **ppApo` and there was no XAPO interface on this roster to wrap it
# as.  IXAPO and IXAPOParameters are on the roster now (10 interfaces, 133
# slots), so each factory gets a GUEST-IMPL wrapper in
# dlls/xaudio2_7/guestcom.c that calls the native entry point and wraps the
# result as IXAPO -- which is what the object actually is: xapo.c writes
# `*out = (IUnknown *)&object->IXAPO_iface`.  IXAPOParameters is reached from
# there by QueryInterface, which winecom wraps through the roster like any
# other interface-returning slot.
#
# GUEST-IMPL rather than GUEST-REFUSE, and the reason is the same finding this
# block used to record: spec2thunk's flat-surface audit classifies a parameter
# as interface-bearing when it names a ROSTERED interface, a known carrier
# struct or a bare void**, and `IUnknown **ppApo` is still none of those, so a
# GUEST-REFUSE here would be reported STALE and let the export through.  That
# blind spot in the audit is NOT closed by this change and is still open; what
# changed is that these three no longer depend on it, because a GUEST-IMPL
# redirect is explicit and the wrap is written by hand.
GUEST-IMPL CreateAudioReverb     __wine_guest_CreateAudioReverb
GUEST-IMPL CreateAudioVolumeMeter __wine_guest_CreateAudioVolumeMeter
GUEST-IMPL CreateFX              __wine_guest_CreateFX

EXCLUDE __wine_guest_CreateAudioReverb
EXCLUDE __wine_guest_CreateAudioVolumeMeter
EXCLUDE __wine_guest_CreateFX

# X3DAudioInitialize and X3DAudioCalculate are NOT here: they are flat maths
# over plain structs, they carry no interface pointer, and the audit agrees.
# X3DAudioInitialize's second argument is a by-value float, which the flat
# thunk path has carried since cd4ea32c93d.

EXCLUDE __wine_com_dispatch
EXCLUDE __wine_com_slot_name
EXCLUDE __wine_com_refuse
EXCLUDE __wine_guest_XAudio2Create
EXCLUDE __wine_guest_XAudio2CreateWithVersionInfo
