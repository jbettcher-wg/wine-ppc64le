; guestcrt.dll -- the guest-side CRT primitives no trap thunk can carry.
; See setjmp.c and cxxthrow.c for why these must be real x86-64 code, and
; guestcrt.guestpe for how this module is built.
LIBRARY guestcrt.dll
EXPORTS
    __intrinsic_setjmp
    longjmp
    _CxxThrowException
    __CxxRegisterExceptionObject
    __CxxUnregisterExceptionObject
    __DestructExceptionObject
    __current_exception
    __current_exception_context
    __processing_throw
    __uncaught_exception
