# AMD64 thunk export spec -- ws2_32.dll.
#
# Added from the 2026-08-15 first-real-game triage: with the application's own
# shipped DLLs now loadable (find_dll_file() searches the load path for the
# guest's machine instead of refusing it outright), what stopped
# quake2ex_steam.exe was Wine builtins with no guest thunk -- each reported as
# c000007b, the loader correctly refusing to splice a native ppc64 module into
# a guest call.  Nothing here is hand-written: the export list comes from this
# module's own .spec.
DLL ws2_32.dll
FROM-SPEC auto

# inet_ntoa is the one export in this .spec that takes a STRUCT BY VALUE --
# `char *inet_ntoa(struct in_addr)` -- so the header oracle refuses it
# ("argument 0 (struct in_addr) is not integer/pointer class") and guests
# that import ws2_32 ordinal 12 (Cyberpunk2077.exe and its REDGalaxy64.dll)
# get a sentinel.  The .spec-location row below bypasses the class check the
# same way msvcr100's mangled names do, and it is sound HERE because a 4-byte
# aggregate is one register slot on both sides of this boundary: MS-x64 puts
# it in the low bytes of RCX, ELFv2 (LE) expects it in the low bytes of r3,
# and the callee reads only its own 4 bytes, so forwarding the slot verbatim
# is the correct marshalling.  No extension question arises -- aggregates are
# not integer-extended by either ABI.  The returned char* is a native
# per-thread buffer in the shared address space, readable by the guest as-is.
inet_ntoa                 0x00001E7A  1  int   ws2_32.spec:12
