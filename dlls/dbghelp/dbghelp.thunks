# AMD64 thunk export spec -- dbghelp.dll.
#
# From the 2026-08-15 second-game pass: DOOM's Vulkan build imports these and
# every one reported c000007b -- the loader found the native ppc64 module and
# correctly refused to splice it into a guest call, because no guest thunk
# existed.  Same class of gap as the first game, same one-line fix, which is
# the point: nothing here is per-title.
#
# vulkan-1 is the one that matters for that binary.  It renders through
# vulkan-1 -> winevulkan -> RADV with no D3D anywhere in the path, so this is
# the shortest route from a real game's draw calls to this machine's GPU.
DLL dbghelp.dll
FROM-SPEC auto

# Every one of its 140 eligible exports was refused as "no declaration in any
# Wine header", so the module emitted was a real PE with NO exports -- which
# loads, and binds every import of it to a missing-import sentinel.  Measured:
# DOOM (2016) installs its own crash reporter during startup with
# SymSetOptions( SymGetOptions() & ~SYMOPT_UNDNAME | 0x2010 ) at
# DOOMx64vk.exe+0x3272e5, and called 0xdead0017 -- the sentinel the loader
# handed it for dbghelp.dll.SymGetOptions.  dbghelp.h is not in the global
# probe (nothing else needs it), so it is appended here exactly as vulkan-1
# appends wine/vulkan.h.
PROBE-EXTRA   dbghelp.h
